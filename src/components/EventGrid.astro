---
import { Image } from "astro:assets";
import { flyerAltShort } from "../utils/events";

interface Props {
    events: any[];
}
const { events } = Astro.props;
---

<!-- Flyers sit in square cells and the grid always spans the content width.
     From xl up a page (24 events) is meant to fit one screen: 6, 8 or 12
     columns (4, 3 or 2 rows) by the shape of the space available, and anything
     that still does not fit scrolls inside the grid. Below xl it flows. -->
<div class="w-full mb-auto gallery-fit vt-detail" transition:name="gallery-page" data-scroll>
    <ul class="grid gap-2 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gallery-grid">
        {
            events.map((event) => (
                <li class="min-w-0">
                    <a href={`/events/${event.id}/`} transition:name={event.data.id}>
                        <h5 class="uppercase xl:truncate">{event.data.title}</h5>
                        <hr />
                        <Image
                            src={event.data.flyer.src}
                            alt={flyerAltShort(event.data)}
                            width={400}
                            height={400}
                            fit="contain"
                            class="block object-contain w-full aspect-square"
                        />
                        <hr />
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    @media (min-width: 80rem) {
        .gallery-fit {
            flex: 1;
            min-height: 0;
            margin-bottom: 0;
            overflow-y: auto;
            container-type: size;
            display: flex;
            flex-direction: column;
        }
        /* Centre a short grid in the space left, without clipping when it scrolls. */
        .gallery-grid {
            margin-block: auto;
        }
        .gallery-grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }
        .gallery-grid :global(hr) {
            margin-block: 0.25rem;
        }
        @container (max-aspect-ratio: 20/9) {
            .gallery-grid {
                grid-template-columns: repeat(8, minmax(0, 1fr));
            }
        }
        @container (max-aspect-ratio: 10/9) {
            .gallery-grid {
                grid-template-columns: repeat(6, minmax(0, 1fr));
            }
        }
    }
</style>
