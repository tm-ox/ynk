---
import { Image } from "astro:assets";

interface Props {
    pageSize?: number;
    events: any[];
}
const { events, pageSize = 18 } = Astro.props;
// From xl up the last page is padded with invisible cells so it keeps the same
// height, and the page numbers stay where they are.
const padding = Math.max(0, pageSize - events.length);
---

<!-- Flyers sit in square cells and the grid always spans the content width.
     From xl up a page (18 events) is meant to fit one screen: 6 or 9
     columns (3 or 2 rows) by the shape of the space available, and anything
     that still does not fit scrolls inside the grid. Below xl it flows. -->
<div class="w-full mb-auto gallery-fit vt-detail" transition:name="gallery-page" data-scroll>
    <div class="gallery-spacer"></div>
    <div class="gallery-group">
    <ul class="grid gap-2 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gallery-grid">
        {
            events.map((event) => (
                <li class="min-w-0">
                    <a href={`/events/${event.id}/`} title={event.data.title} transition:name={event.data.id}>
                        <h5 class="uppercase xl:truncate">{event.data.title}</h5>
                        <hr />
                        <Image
                            src={event.data.flyer.src}
                            alt=""
                            width={400}
                            height={400}
                            fit="contain"
                            class="block object-contain w-full aspect-square"
                        />
                        <hr />
                    </a>
                </li>
            ))
        }
        {
            Array.from({ length: padding }).map(() => (
                <li class="hidden invisible xl:block" aria-hidden="true">
                    <h5>&nbsp;</h5>
                    <hr />
                    <div class="aspect-square" />
                    <hr />
                </li>
            ))
        }
    </ul>
    </div>
    <div class="gallery-after"><slot /></div>
</div>

<style>
    .gallery-spacer {
        display: none;
    }
    .gallery-after {
        padding-block: 1rem;
    }
    @media (min-width: 80rem) {
        .gallery-spacer {
            display: block;
        }
        .gallery-after {
            padding-block: 0;
        }
        .gallery-fit {
            flex: 1;
            min-height: 0;
            margin-bottom: 0;
            overflow-y: auto;
            container-type: size;
            display: flex;
            flex-direction: column;
        }
        /* The grid sits centred; the slotted page numbers sit halfway between
           it and the baseline (the spacer above matches the area below). */
        /* 4:6 rather than 1:1, so the grid sits a little above centre. */
        .gallery-spacer,
        .gallery-after {
            min-height: 0;
        }
        .gallery-spacer {
            flex: 4 1 0;
        }
        .gallery-after {
            flex: 6 1 0;
        }
        .gallery-after {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 2.5rem;
        }
        .gallery-grid {
            grid-template-columns: repeat(6, minmax(0, 1fr));
        }
        .gallery-grid :global(hr) {
            margin-block: 0.25rem;
        }
        /* 6 columns (3 rows) need a height of about 0.5 x width + 150px:
           3 rows of (cell + 38px chrome), 2 gaps, and 40px for the page
           numbers. That is 1.62 x wide at 1264px and 1.65 at 1424px, so 6
           columns only when narrower than 8:5; 9 columns (2 rows) need far less. */
        @container (min-aspect-ratio: 8/5) {
            .gallery-grid {
                grid-template-columns: repeat(9, minmax(0, 1fr));
            }
        }
    }
</style>
