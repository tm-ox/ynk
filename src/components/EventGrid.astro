---
import { Image } from "astro:assets";

interface Props {
    pageSize?: number;
    events: any[];
}
const { events, pageSize = 18 } = Astro.props;
// From xl up the last page is padded with invisible cells so it keeps the same
// height, and the page numbers stay where they are.
const padding = Math.max(0, pageSize - events.length);
---

<!-- Flyers sit in square cells and the grid always spans the content width.
     From xl up a page (18 events) is 6 columns by 3 rows; a screen too short
     for that scrolls inside the grid. Below xl it flows. -->
<div class="w-full mb-auto gallery-fit vt-detail" transition:name="gallery-page" data-scroll>
    <div class="gallery-spacer"></div>
    <div class="gallery-group">
    <ul class="grid gap-2 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gallery-grid">
        {
            events.map((event, i) => (
                <li class="min-w-0" style={`--i:${i}`}>
                    <a href={`/events/${event.id}/`} title={event.data.title} transition:name={event.data.id}>
                        <h5 class="uppercase xl:truncate">{event.data.title}</h5>
                        <hr />
                        <div class="thumb">
                            <Image
                                src={event.data.flyer.src}
                                alt=""
                                width={400}
                                height={400}
                                fit="contain"
                                class="block object-contain w-full aspect-square"
                            />
                        </div>
                        <hr />
                    </a>
                </li>
            ))
        }
        {
            Array.from({ length: padding }).map(() => (
                <li class="hidden invisible xl:block" aria-hidden="true">
                    <h5>&nbsp;</h5>
                    <hr />
                    <div class="aspect-square" />
                    <hr />
                </li>
            ))
        }
    </ul>
    </div>
    <div class="gallery-after"><slot /></div>
</div>

<style>
    /* The rules above and below a flyer sit flush with it. */
    .gallery-grid :global(hr) {
        margin-block: 0;
    }
    /* The title keeps the room above its rule that the rule's margin gave it. */
    .gallery-grid :global(h5) {
        padding-bottom: 0.5rem;
    }
    /* One grid gap between the bar above and the first titles, the same as
       between one row of thumbnails and the next. From xl up it also centres
       the grid (see below). */
    .gallery-spacer {
        height: 0.5rem;
    }
    .gallery-after {
        padding-block: 1rem;
    }
    @media (min-width: 80rem) {
        .gallery-grid :global(h5) {
            padding-bottom: 0.25rem;
        }
        .gallery-spacer {
            display: block;
        }
        .gallery-after {
            padding-block: 0;
        }
        .gallery-fit {
            flex: 1;
            min-height: 0;
            margin-bottom: 0;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }
        /* The grid sits centred; the slotted page numbers sit halfway between
           it and the baseline (the spacer above matches the area below). */
        /* 4:6 rather than 1:1, so the grid sits a little above centre. */
        .gallery-spacer,
        .gallery-after {
            min-height: 0;
        }
        .gallery-spacer {
            flex: 4 1 0;
            /* When the grid overflows and scrolls, keep one grid gap between the
               bar above and the first titles. */
            min-height: 0.5rem;
        }
        .gallery-after {
            flex: 6 1 0;
        }
        .gallery-after {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 2.5rem;
        }
        .gallery-grid {
            grid-template-columns: repeat(6, minmax(0, 1fr));
        }
    }
</style>
