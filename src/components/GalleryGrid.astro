---
import { Image } from "astro:assets";
import type { GalleryImage } from "../utils/events";

interface Props {
    images: GalleryImage[];
}
const { images } = Astro.props;
---

<!-- Thumbnails are always square and the grid always spans the content width.
     From xl up a page (24 images) is meant to fit one screen: the number of
     columns follows the shape of the space available (6, 8 or 12, so 4, 3 or
     2 rows; 8 from a height of about 45% of the width), and anything that still does not fit scrolls inside the grid.
     Below xl the grid flows with fewer columns. -->
<div class="w-full mb-auto gallery-fit vt-detail" transition:name="gallery-page" data-scroll>
    <ul class="imageGrid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gallery-grid">
        {
            images.map((image) => (
                <li class="min-w-0">
                    <a
                        href={`/images/${image.id}/`}
                        transition:name={image.id}
                    >
                        <h5 class="uppercase xl:truncate">{image.alt}</h5>
                        <hr />
                        <Image
                            src={image.src}
                            alt={image.description}
                            width={400}
                            height={400}
                            class="block object-cover w-full aspect-square"
                        />
                        <hr />
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    @media (min-width: 80rem) {
        .gallery-fit {
            flex: 1;
            min-height: 0;
            margin-bottom: 0;
            overflow-y: auto;
            container-type: size;
            display: flex;
            flex-direction: column;
        }
        /* Centre a short grid in the space left, without clipping when it scrolls. */
        .gallery-grid {
            margin-block: auto;
        }
        .gallery-grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }
        .gallery-grid :global(hr) {
            margin-block: 0.25rem;
        }
        @container (max-aspect-ratio: 20/9) {
            .gallery-grid {
                grid-template-columns: repeat(8, minmax(0, 1fr));
            }
        }
        @container (max-aspect-ratio: 10/9) {
            .gallery-grid {
                grid-template-columns: repeat(6, minmax(0, 1fr));
            }
        }
    }
</style>
