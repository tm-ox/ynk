---
import { Image } from "astro:assets";
import type { GalleryImage } from "../utils/events";

interface Props {
    images: GalleryImage[];
}
const { images } = Astro.props;
---

<!-- From xl up the grid fills the height left by the filter and pagination,
     so a page is a single screen; below that it flows and scrolls, with fewer
     columns so the thumbnails keep their height. -->
<div
    class="w-full mb-auto xl:flex-1 xl:min-h-0 xl:mb-0 vt-detail"
    transition:name="gallery-page"
>
    <ul class="imageGrid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 2xl:grid-cols-8 xl:h-full xl:auto-rows-fr">
        {
            images.map((image) => (
                <li class="aspect-square xl:aspect-auto xl:min-h-0">
                    <a
                        href={`/images/${image.id}/`}
                        class="xl:flex xl:flex-col xl:h-full"
                        transition:name={image.id}
                    >
                        <h5 class="uppercase">{image.alt}</h5>
                        <hr />
                        <Image
                            src={image.src}
                            alt={image.description}
                            width={400}
                            height={400}
                            class="block object-cover w-full h-full xl:flex-1 xl:min-h-0"
                        />
                        <hr />
                    </a>
                </li>
            ))
        }
    </ul>
</div>
