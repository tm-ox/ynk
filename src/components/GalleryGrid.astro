---
import { Image } from "astro:assets";
import type { getGalleryImages } from "../utils/events";
import { IMAGES_PER_PAGE } from "../utils/events";

// Taken from the function's return type: Zed's language server fails to see the
// module's `GalleryImage` export here (astro check and the build are fine).
type GalleryImage = Awaited<ReturnType<typeof getGalleryImages>>[number];

interface Props {
    pageSize?: number;
    images: GalleryImage[];
}
const { images, pageSize = IMAGES_PER_PAGE } = Astro.props;
// From xl up the last page is padded with invisible cells so it keeps the same
// height, and the grid sits where it does on the full pages.
const padding = Math.max(0, pageSize - images.length);
---

<!-- Thumbnails are always square and the grid always spans the content width.
     From xl up a page (21 images) fits one screen: 7 columns by 3 rows, the
     grid narrowing where the space is too short for three full-width rows.
     Below xl the grid flows with fewer columns. -->
<div class="w-full mb-auto gallery-fit" data-scroll>
    <div class="gallery-spacer"></div>
    <div class="gallery-group">
    <ul class="imageGrid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gallery-grid">
        {
            images.map((image) => (
                <li class="min-w-0">
                    <a
                        href={`/images/${image.id}/`}
                        title={image.alt}
                    >
                        <h5 class="uppercase xl:truncate">{image.alt}</h5>
                        <hr />
                        <div class:list={["thumb", image.kind === "photo" ? "vt-photo" : "vt-picture"]} transition:name={image.id}>
                            <Image
                                src={image.src}
                                alt={image.description}
                                width={400}
                                height={400}
                                fit={image.kind === "flyer" ? "contain" : "cover"}
                                class:list={["block w-full aspect-square", image.kind === "flyer" ? "object-contain" : "object-cover"]}
                            />
                        </div>
                        <hr />
                    </a>
                </li>
            ))
        }
        {
            Array.from({ length: padding }).map(() => (
                <li class="hidden invisible xl:block" aria-hidden="true">
                    <h5>&nbsp;</h5>
                    <hr />
                    <div class="aspect-square" />
                    <hr />
                </li>
            ))
        }
    </ul>
    </div>
    <div class="gallery-after"></div>
</div>

<style>
    /* The rules above and below a thumbnail sit flush with it. */
    .gallery-grid :global(hr) {
        margin-block: 0;
    }
    /* The title keeps the room above its rule that the rule's margin gave it. */
    .gallery-grid :global(h5) {
        padding-bottom: 0.5rem;
    }
    /* One grid gap between the bar above and the first titles, the same as
       between one row of thumbnails and the next. From xl up it also centres
       the grid (see below). */
    .gallery-spacer {
        height: var(--spacing-bar-gap);
    }
    .gallery-after {
        padding-block: 1rem;
    }
    @media (min-width: 80rem) {
        .gallery-grid :global(h5) {
            padding-bottom: 0.25rem;
        }
        .gallery-spacer {
            display: block;
        }
        .gallery-after {
            padding-block: 0;
        }
        .gallery-fit {
            flex: 1;
            min-height: 0;
            margin-bottom: 0;
            overflow-y: auto;
            container-type: size;
            display: flex;
            flex-direction: column;
        }
        /* The grid sits between the spacer above and the empty area below
           (.gallery-after), which share the space left 4:6 rather than 1:1,
           so it sits a little above centre. */
        .gallery-spacer,
        .gallery-after {
            min-height: 0;
        }
        .gallery-spacer {
            flex: 4 1 0;
            /* When the grid overflows and scrolls, keep one grid gap between the
               bar above and the first titles. */
            min-height: 0.5rem;
        }
        .gallery-after {
            flex: 6 1 0;
        }
        .gallery-after {
            display: flex;
            align-items: center;
            justify-content: center;
            /* 2rem + the spacer's 0.5rem gap = the 2.5rem this row alone used to take,
               so adding the gap above the grid does not make a snug page scroll. */
            min-height: 2rem;
        }
        /* A page (21 images) is 7 columns by 3 rows. Three rows need about
           3/7 of the grid's width plus 149px (the titles and gaps under each
           row), so where the space is shorter than that the grid narrows
           (set left) until the rows fit, rather than scroll. */
        .gallery-grid {
            grid-template-columns: repeat(7, minmax(0, 1fr));
            width: min(100%, calc((100cqh - 149px) * 7 / 3));
        }
    }
</style>
