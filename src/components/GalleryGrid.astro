---
import { Image } from "astro:assets";
import type { getGalleryImages } from "../utils/events";

// Taken from the function's return type: Zed's language server fails to see the
// module's `GalleryImage` export here (astro check and the build are fine).
type GalleryImage = Awaited<ReturnType<typeof getGalleryImages>>[number];

interface Props {
    pageSize?: number;
    images: GalleryImage[];
}
const { images, pageSize = 24 } = Astro.props;
// From xl up the last page is padded with invisible cells so it keeps the same
// height, and the page numbers stay where they are.
const padding = Math.max(0, pageSize - images.length);
---

<!-- Thumbnails are always square and the grid always spans the content width.
     From xl up a page (24 images) is meant to fit one screen: the number of
     columns follows the shape of the space available (6, 8 or 12, so 4, 3 or
     2 rows; 8 from a height of about half the width), and anything that still does not fit scrolls inside the grid.
     Below xl the grid flows with fewer columns. -->
<div class="w-full mb-auto gallery-fit vt-detail" transition:name="gallery-page" data-scroll>
    <div class="gallery-spacer"></div>
    <div class="gallery-group">
    <ul class="imageGrid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gallery-grid">
        {
            images.map((image, i) => (
                <li class="min-w-0" style={`--i:${i}`}>
                    <a
                        href={`/images/${image.id}/`}
                        title={image.alt}
                        transition:name={image.id}
                    >
                        <h5 class="uppercase xl:truncate">{image.alt}</h5>
                        <hr />
                        <div class="thumb">
                            <Image
                                src={image.src}
                                alt={image.description}
                                width={400}
                                height={400}
                                fit={image.kind === "flyer" ? "contain" : "cover"}
                                class:list={["block w-full aspect-square", image.kind === "flyer" ? "object-contain" : "object-cover"]}
                            />
                        </div>
                        <hr />
                    </a>
                </li>
            ))
        }
        {
            Array.from({ length: padding }).map(() => (
                <li class="hidden invisible xl:block" aria-hidden="true">
                    <h5>&nbsp;</h5>
                    <hr />
                    <div class="aspect-square" />
                    <hr />
                </li>
            ))
        }
    </ul>
    </div>
    <div class="gallery-after"><slot /></div>
</div>

<style>
    /* The rules above and below a thumbnail sit flush with it. */
    .gallery-grid :global(hr) {
        margin-block: 0;
    }
    /* The title keeps the room above its rule that the rule's margin gave it. */
    .gallery-grid :global(h5) {
        padding-bottom: 0.5rem;
    }
    /* One grid gap between the bar above and the first titles, the same as
       between one row of thumbnails and the next. From xl up it also centres
       the grid (see below). */
    .gallery-spacer {
        height: 0.5rem;
    }
    .gallery-after {
        padding-block: 1rem;
    }
    @media (min-width: 80rem) {
        .gallery-grid :global(h5) {
            padding-bottom: 0.25rem;
        }
        .gallery-spacer {
            display: block;
        }
        .gallery-after {
            padding-block: 0;
        }
        .gallery-fit {
            flex: 1;
            min-height: 0;
            margin-bottom: 0;
            overflow-y: auto;
            container-type: size;
            display: flex;
            flex-direction: column;
        }
        /* The grid sits centred; the slotted page numbers sit halfway between
           it and the baseline (the spacer above matches the area below). */
        /* 4:6 rather than 1:1, so the grid sits a little above centre. */
        .gallery-spacer,
        .gallery-after {
            min-height: 0;
        }
        .gallery-spacer {
            flex: 4 1 0;
            /* When the grid overflows and scrolls, keep one grid gap between the
               bar above and the first titles. */
            min-height: 0.5rem;
        }
        .gallery-after {
            flex: 6 1 0;
        }
        .gallery-after {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 2.5rem;
        }
        .gallery-grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
        }
        /* 8 columns (3 rows) need a height of about 0.375 x width + 149px
           (2.03 x wide at 1264px, 2.08 at 1424px), so 8 from 2:1 and
           narrower; 12 columns (2 rows) need about 0.17 x width + 109px.
           6 columns (4 rows, 0.67 x width + 189px) are for tall spaces. */
        @container (max-aspect-ratio: 2/1) {
            .gallery-grid {
                grid-template-columns: repeat(8, minmax(0, 1fr));
            }
        }
        @container (max-aspect-ratio: 10/9) {
            .gallery-grid {
                grid-template-columns: repeat(6, minmax(0, 1fr));
            }
        }
    }
</style>
