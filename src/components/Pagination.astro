---
import NavArrow from "./NavArrow.astro";
const { prevUrl, nextUrl, lastPage, currentPage, basePath = "/images" } = Astro.props;
---

<nav aria-label="Pagination" class="flex flex-col my-4">
    <div class="flex gap-3">
        <NavArrow direction="back" class="icon h-6 w-6" href={prevUrl} />
        <NavArrow direction="forward" class="icon h-6 w-6" href={nextUrl} />
    </div>
    <div class="flex gap-6">
        {
            Array.from({ length: lastPage }, (_, i) => i + 1).map((num) => (
                <h5>
                    <a
                        href={num === 1 ? basePath : `${basePath}/${num}`}
                        class={
                            currentPage === num
                                ? "active"
                                : "flex text-center justify-center"
                        }
                    >
                        {num}
                    </a>
                </h5>
            ))
        }
    </div>
</nav>

<style>
    @reference "../styles/global.css";
    .active {
        @apply underline underline-offset-8;
    }
</style>
