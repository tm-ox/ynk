---
// Page numbers only; the Previous / Next arrows live in the nav (see the
// archive pages' "subnav" slot).
const { lastPage, currentPage, basePath = "/images/" } = Astro.props;
---

<nav aria-label="Pagination" class="flex flex-wrap h-auto max-w-none gap-x-6 mx-0 px-0 shrink-0 justify-start">
    {
        Array.from({ length: lastPage }, (_, i) => i + 1).map((num) => (
            <h5>
                <a
                    href={num === 1 ? basePath : `${basePath}${num}/`}
                    class={currentPage === num ? "active" : undefined}
                    aria-current={currentPage === num ? "page" : undefined}
                >
                    {num}
                </a>
            </h5>
        ))
    }
</nav>

<style>
    @reference "../styles/global.css";
    a {
        @apply text-accent-muted hover:text-accent;
    }
    .active {
        @apply underline underline-offset-4 text-accent;
    }
</style>
