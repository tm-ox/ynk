---
// Page numbers only; the Previous / Next arrows live in the nav (see the
// archive pages' "subnav" slot). They sit at the right of the bar at the top
// of an archive, near the arrows, where a visitor reaches for them.
const { lastPage, currentPage, basePath = "/images/" } = Astro.props;
// Only the pages either side are prefetched after load, not every number. A
// single page has no numbers.
---

{lastPage > 1 && (
<nav aria-label="Pagination" transition:name="pagination" class="flex flex-wrap items-center justify-end h-auto max-w-none gap-x-4 px-0 shrink-0 sm:h-(--bar-row) max-sm:justify-center max-sm:py-2">
    {
        Array.from({ length: lastPage }, (_, i) => i + 1).map((num) => (
            <span class="text-xs md:text-sm font-displayCon font-bold text-accent">
                <a
                    href={num === 1 ? basePath : `${basePath}${num}/`}
                    data-astro-prefetch={Math.abs(num - currentPage) === 1 ? "load" : undefined}
                    class={currentPage === num ? "active" : undefined}
                    aria-current={currentPage === num ? "page" : undefined}
                >
                    {num}
                </a>
            </span>
        ))
    }
</nav>
)}

<style>
    @reference "../styles/global.css";
    a {
        @apply text-accent-muted hover:text-accent;
    }
    .active {
        @apply underline underline-offset-4 text-accent;
    }
</style>
