---
// Page numbers only; the Previous / Next arrows follow them in the bar at the
// top of an archive (Paging.astro), where a visitor reaches for both.
const { lastPage, currentPage, basePath = "/images/" } = Astro.props;
// With many pages the row would run on: the first and last pages, the current
// one and three either side, and "…" for each gap (1 … 7 8 9 10 11 12 13 … 30).
// Up to sixteen pages all show: the dropdown is only as wide as its text, so
// the bar has room for them.
const shown =
    lastPage <= 16
        ? Array.from({ length: lastPage }, (_, i) => i + 1)
        : [...new Set([1, ...Array.from({ length: 7 }, (_, i) => currentPage - 3 + i), lastPage])]
              .filter((n) => n >= 1 && n <= lastPage)
              .sort((a, b) => a - b);
// A gap marker wherever the run skips; a skip of one page shows that page.
const items: (number | "gap")[] = shown.flatMap((n, i) => {
    const prev = shown[i - 1];
    if (prev === undefined || n - prev === 1) return [n];
    return n - prev === 2 ? [prev + 1, n] : ["gap", n];
});
// Only the pages either side are prefetched after load, not every number. A
// single page has no numbers.
---

{lastPage > 1 && (
<nav aria-label="Pagination" transition:name="pagination" class="flex flex-wrap items-center justify-end gap-x-4 shrink-0 md:h-(--bar-row) max-md:justify-start max-md:gap-x-0">
    {
        items.map((num) => num === "gap" ? (
            <span class="text-xs md:text-sm leading-none font-displayCon font-bold text-accent-muted" aria-hidden="true">…</span>
        ) : (
            <span class="text-xs md:text-sm leading-none font-displayCon font-bold text-accent">
                <a
                    href={num === 1 ? basePath : `${basePath}${num}/`}
                    data-astro-prefetch={Math.abs(num - currentPage) === 1 ? "load" : undefined}
                    class={currentPage === num ? "active" : undefined}
                    aria-current={currentPage === num ? "page" : undefined}
                >
                    {num}
                </a>
            </span>
        ))
    }
</nav>
)}

<style>
    @reference "../styles/global.css";
    a {
        @apply text-accent-muted hover:text-accent;
    }
    .active {
        @apply underline underline-offset-4 text-accent;
    }
    /* Below md the numbers have a row of their own in the bar (the bars put it
       last), set left, and each is a touch target --hit square, its figure at
       the box's left so the run starts on the gutter. The row wraps should it
       ever run past the width. */
    @media (width < 48rem) {
        nav {
            --hit: 2.5rem;
        }
        nav > span,
        a {
            display: inline-flex;
            align-items: center;
            min-width: var(--hit);
            height: var(--hit);
        }
    }
</style>
