---
import Sosmed from "../Sosmed.astro";

const supporters = [
    "AsiaLink",
    "Goethe-Institut",
    "CTM Festival",
    "ARTJOG",
    "Pestapora",
    "AsiaTopa",
    "Nusasonic",
];
---

<section id="contact" class="flex-col home-section">
    <h2 class="w-full text-3xl md:text-4xl">Contact</h2>
    <hr class="w-full" />
    <p class="w-full my-2">
        <a href="mailto:y%65%73noklub@gmail%2E%63om">&#121;&#101;&#115;&#110;&#111;&#107;&#108;&#117;&#98;&#64;&#103;&#109;&#97;&#105;&#108;&#46;&#99;&#111;&#109;</a>
    </p>
    <Sosmed />
    <hr class="w-full" />
    <h4 class="w-full">Supporters and partners</h4>
    <ul class="flex flex-wrap w-full gap-x-6 gap-y-1 mb-auto">
        {supporters.map((name) => <li class="w-auto"><h5>{name}</h5></li>)}
    </ul>
</section>
