---
import SectionBar from "./SectionBar.astro";
import Sosmed from "../Sosmed.astro";

const supporters = [
    "AsiaLink",
    "Goethe-Institut",
    "CTM Festival",
    "ARTJOG",
    "Pestapora",
    "AsiaTopa",
    "Nusasonic",
];
---

<section id="contact" class="flex-col">
    <SectionBar label="Contact" />
    <p class="w-full my-2">
        <a href="mailto:y%65%73noklub@gmail%2E%63om">&#121;&#101;&#115;&#110;&#111;&#107;&#108;&#117;&#98;&#64;&#103;&#109;&#97;&#105;&#108;&#46;&#99;&#111;&#109;</a>
    </p>
    <Sosmed />
    <hr class="w-full" />
    <h3 class="w-full p-0 mb-0 text-base font-normal tracking-wide md:text-base">Supporters and partners</h3>
    <ul class="flex flex-wrap w-full gap-x-6 gap-y-1 mb-auto">
        {supporters.map((name) => <li class="w-auto text-xs font-bold text-center md:text-sm font-displayCon text-accent sm:text-left">{name}</li>)}
    </ul>
</section>
