---
import SectionBar from "./SectionBar.astro";

const field =
    "w-full px-2 py-2 text-base font-light tracking-wide border-0 rounded-none bg-accent-muted/10 font-body text-fg placeholder:text-accent-muted focus:bg-accent-muted/20 focus:outline-none";
const label = "text-xs uppercase font-displayCon md:text-sm text-accent-muted";
---

<section id="contact" class="flex-col items-stretch">
    <SectionBar label="Contact" />
    <div class="grid grid-cols-1 my-auto lg:gap-6 lg:grid-cols-2">
        <h3 class="mt-1 mb-6 text-sm sm:text-2xl lg:mb-0 lg:self-center lg:text-right col-span-full lg:col-span-1">
            Yes No Klub is a DIY collective working with regional and
            international artists, organisations and funders. If you'd like to
            collaborate or partner with us, get in touch.
        </h3>
        <!-- Netlify Forms: detected at build, spam-filtered, forwarded to the
             notification address set in the Netlify dashboard. The honeypot
             field is hidden from people and filled in by bots. -->
        <form
            name="contact"
            method="POST"
            action="/"
            data-netlify="true"
            netlify-honeypot="bot-field"
            data-contact
            class="flex flex-col gap-0 col-span-full lg:col-span-1"
        >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden" aria-hidden="true">
                <label>
                    Leave this empty:{" "}
                    <input name="bot-field" tabindex="-1" autocomplete="off" />
                </label>
            </p>
            <div class="flex flex-col">
                <label for="contact-name" class={label}>
                    Name
                </label>
                <hr class="mb-0" />
                <input
                    id="contact-name"
                    name="name"
                    type="text"
                    required
                    autocomplete="name"
                    class={field}
                />
            </div>
            <div class="flex flex-col">
                <hr class="mt-0" />
                <label for="contact-email" class={label}>
                    Email
                </label>
                <hr class="mb-0" />
                <input
                    id="contact-email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    class={field}
                />
            </div>
            <div class="flex flex-col">
                <hr class="mt-0" />
                <label for="contact-message" class={label}>
                    Message
                </label>
                <hr class="mb-0" />
                <textarea
                    id="contact-message"
                    name="message"
                    rows="5"
                    required
                    class={`${field} resize-y`}
                ></textarea>
                <hr class="mt-0" />
            </div>
            <div class="flex items-baseline justify-between gap-4 mt-4">
                <p
                    class="mb-0 text-xs md:text-sm"
                    role="status"
                    aria-live="polite"
                    data-contact-status
                ></p>
                <button
                    type="submit"
                    class="px-4 py-1 text-xs uppercase transition border cursor-pointer md:text-sm font-displayCon text-accent-muted border-accent-muted hover:text-accent hover:border-accent disabled:opacity-50"
                >
                    Send
                </button>
            </div>
        </form>
    </div>
</section>

<script>
    // Submit in place so the panel keeps its place; without JS the form posts
    // normally and Netlify shows its own confirmation page.
    document.addEventListener("submit", async (e) => {
        const form = e.target;
        if (
            !(form instanceof HTMLFormElement) ||
            !form.matches("[data-contact]")
        )
            return;
        e.preventDefault();
        const status = form.querySelector<HTMLElement>("[data-contact-status]");
        const button = form.querySelector<HTMLButtonElement>(
            "button[type=submit]",
        );
        if (button) button.disabled = true;
        if (status) status.textContent = "Sending…";
        try {
            const body = new URLSearchParams(
                new FormData(form) as unknown as Record<string, string>,
            );
            const res = await fetch(form.action, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                },
                body,
            });
            if (!res.ok) throw new Error(String(res.status));
            form.reset();
            if (status)
                status.textContent = "Sent. Thank you, we will reply soon.";
        } catch {
            if (status)
                status.textContent =
                    "Could not send. Please try again in a moment.";
        } finally {
            if (button) button.disabled = false;
        }
    });
</script>
