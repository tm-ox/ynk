---
import SectionBar from "./SectionBar.astro";
import Sosmed from "../Sosmed.astro";

const field =
    "w-full px-2 py-2 text-base font-light tracking-wide border-0 rounded-none bg-accent-muted/10 font-body text-fg focus:bg-accent-muted/20 focus:outline focus:outline-1 focus:-outline-offset-1 focus:outline-accent-muted [&:not(:placeholder-shown)]:bg-transparent!";
const label = "text-xs uppercase font-displayCon md:text-sm text-accent-muted";
---

<section id="contact" class="flex-col items-stretch">
    <SectionBar label="Contact" />
    <div class="grid grid-cols-1 my-auto lg:gap-6 lg:grid-cols-2">
        <p class="mt-bar-gap mb-4 lg:mt-1 font-bold tracking-normal text-accent font-display text-sm sm:text-2xl lg:mb-0 lg:self-center lg:text-right col-span-full lg:col-span-1">
            <span class="block">
                Yes No Klub is a DIY collective working with regional and
                international artists, organisations and funders.
            </span>
            <span class="block mt-4">
                If you'd like to collaborate or partner with us, get in touch.
            </span>
        </p>
        <!-- Netlify Forms: detected at build, spam-filtered, forwarded to the
             notification address set in the Netlify dashboard, with the
             Subject field's value (Netlify's `subject` field) as the email's
             subject line, which the script below prefixes ("YNK
             Web:"); data-remove-prefix drops Netlify's own "[Netlify]".
             Without JS it posts as typed. The honeypot
             field is hidden from people and filled in by bots. -->
        <form
            name="contact"
            method="POST"
            action="/contact/"
            data-netlify="true"
            netlify-honeypot="bot-field"
            data-contact
            data-astro-reload
            class="flex flex-col gap-0 col-span-full lg:col-span-1"
        >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden" aria-hidden="true">
                <label>
                    Leave this empty:{" "}
                    <input name="bot-field" tabindex="-1" autocomplete="off" />
                </label>
            </p>
            <div class="flex flex-col">
                <label for="contact-name" class={label}>
                    Name
                </label>
                <hr class="mb-0" />
                <input
                    id="contact-name"
                    name="name"
                    type="text" placeholder=" "
                    required
                    autocomplete="name"
                    class={field}
                />
            </div>
            <div class="flex flex-col">
                <hr class="mt-0" />
                <label for="contact-email" class={label}>
                    Email
                </label>
                <hr class="mb-0" />
                <input
                    id="contact-email"
                    name="email"
                    type="email" placeholder=" "
                    required
                    autocomplete="email"
                    class={field}
                />
            </div>
            <div class="flex flex-col">
                <hr class="mt-0" />
                <label for="contact-subject" class={label}>
                    Subject
                </label>
                <hr class="mb-0" />
                <input
                    id="contact-subject"
                    name="subject"
                    type="text" placeholder=" "
                    maxlength="120"
                    autocomplete="off"
                    data-remove-prefix
                    class={field}
                />
            </div>
            <div class="flex flex-col">
                <hr class="mt-0" />
                <label for="contact-message" class={label}>
                    Message
                </label>
                <hr class="mb-0" />
                <textarea
                    id="contact-message"
                    name="message"
                    rows="5" placeholder=" "
                    required
                    class={`${field} resize-y`}
                ></textarea>
            </div>
            <button
                type="submit"
                class="w-full py-3 text-xs uppercase transition cursor-pointer border-y md:text-sm font-displayCon text-accent-muted border-accent-muted hover:text-accent hover:border-accent disabled:opacity-50"
            >
                Send
            </button>
            <p class="mt-2 mb-0 text-xs md:text-sm" role="status" aria-live="polite" data-contact-status></p>
        </form>
    </div>
    <!-- Phones only (from sm the icons are in the header): the social icons
         as the menu has them, centred across and halfway down the space
         between the form and the screen's foot (at least 2.5rem each side),
         so they are not found only in the menu. -->
    <div class="flex items-center justify-center flex-1 py-10 sm:hidden">
        <Sosmed />
    </div>
</section>

<script>
    // Submit in place, so the visitor stays where they are; without JS the form
    // posts normally and Netlify brings them back to this page (its action).
    document.addEventListener("submit", async (e) => {
        const form = e.target;
        if (
            !(form instanceof HTMLFormElement) ||
            !form.matches("[data-contact]")
        )
            return;
        e.preventDefault();
        const status = form.querySelector<HTMLElement>("[data-contact-status]");
        const button = form.querySelector<HTMLButtonElement>(
            "button[type=submit]",
        );
        if (button) button.disabled = true;
        if (status) status.textContent = "Sending…";
        try {
            const body = new URLSearchParams(
                new FormData(form) as unknown as Record<string, string>,
            );
            // The email's subject line (Netlify uses the form's `subject`):
            // marked as from the site, then what they wrote or, if nothing,
            // their name, so the inbox shows who it is from.
            const typed = String(body.get("subject") ?? "").trim();
            const who = String(body.get("name") ?? "").trim();
            body.set("subject", `YNK Web: ${typed || who}`);
            const res = await fetch(form.action, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                },
                body,
            });
            if (!res.ok) throw new Error(String(res.status));
            form.reset();
            if (status)
                status.textContent = "Sent. Thank you, we will reply soon.";
        } catch {
            if (status) {
                // Built here so the address is not in the page markup.
                const address = ["yesnoklub", "gmail.com"].join("@");
                const mail = document.createElement("a");
                mail.href = `mailto:${address}`;
                mail.textContent = address;
                status.replaceChildren("Could not send. Try again, or write to ", mail, ".");
            }
        } finally {
            if (button) button.disabled = false;
        }
    });
</script>

<style>
    /* Entered text stays the body colour, autofilled or typed, so it reads
       apart from the labels. */
    [data-contact] :global(:is(input, textarea):-webkit-autofill) {
        -webkit-text-fill-color: var(--color-fg);
    }
</style>
