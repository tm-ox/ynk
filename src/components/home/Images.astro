---
import SectionBar from "./SectionBar.astro";
import { Image } from "astro:assets";
import { getGalleryImages } from "../../utils/events";

// A highlight from the most recent documented event: five photographs spread
// evenly through the night, the first shown large.
const all = await getGalleryImages();
const latestGroup = all[0]?.groupId;
const photos = all.filter((image) => image.groupId === latestGroup);
const COUNT = 5;
const picks =
    photos.length <= COUNT
        ? photos
        : Array.from({ length: COUNT }, (_, i) =>
              photos[Math.round((i * (photos.length - 1)) / (COUNT - 1))],
          );
---

{latestGroup && (
<section id="images" class="flex-col items-stretch">
    <SectionBar label="Images">
        <a href={`/images/event/${latestGroup}/`} class="section-action">
            Event images
        </a>
        <a href="/images/" class="section-action">All images</a>
    </SectionBar>
    <!-- From md the grid is two rows of squares, W/2 - 4px tall; the width is capped so
         that fits below the bar (section 30px + bar 20px = 50px). -->
    <ul class="grid w-full grid-cols-2 gap-2 my-auto md:grid-cols-4 md:max-w-[calc((100vh-var(--section-offset)-50px)*2)] md:mx-auto">
        {
            picks.map((image, i) => (
                <li class={i === 0 ? "col-span-2 row-span-2 aspect-square" : "aspect-square"}>
                    <a
                        href={`/images/${image.id}/`}
                        class="block h-full"
                        transition:name={image.id}
                    >
                        <Image
                            src={image.src}
                            alt={image.description}
                            width={i === 0 ? 1200 : 600}
                            class="block object-cover w-full h-full"
                        />
                    </a>
                </li>
            ))
        }
    </ul>
</section>
)}
