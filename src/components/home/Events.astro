---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { flyerAlt } from "../../utils/events";

// The nearest upcoming event, otherwise the most recent one (decided at build time).
const today = new Date().toISOString().slice(0, 10);
const events = await getCollection("events");
const upcoming = events
    .filter((e) => e.data.date >= today)
    .sort((a, b) => Date.parse(a.data.date) - Date.parse(b.data.date));
const latest = [...events].sort(
    (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);
const featured = upcoming[0] ?? latest[0];
const href = `/events/${featured.id}/`;
---

<section id="events" class="flex-col items-stretch home-section">
    <h2 class="w-full text-3xl md:text-4xl">
        {upcoming[0] ? "Next event" : "Previous event"}
    </h2>
    <hr class="w-full" />
    <div
        class="grid w-full gap-6 my-auto md:grid-cols-3 md:items-center"
        transition:name={featured.data.id}
    >
        <a href={href} class="block">
            <Image
                src={featured.data.flyer.src}
                alt={flyerAlt(featured.data)}
                width={800}
                class="object-contain w-full h-auto"
            />
        </a>
        <div class="flex flex-col gap-4 md:col-span-2">
            <h2 class="mb-0 text-3xl uppercase md:text-4xl">
                <a href={href}>{featured.data.title}</a>
            </h2>
            <div class="grid gap-4 sm:grid-cols-3">
                <div>
                    <h5>date:</h5>
                    <h4>{featured.data.date}</h4>
                </div>
                {
                    featured.data.time !== "" && (
                        <div>
                            <h5>time:</h5>
                            <h4>{featured.data.time}</h4>
                        </div>
                    )
                }
                <div>
                    <h5>venue:</h5>
                    <h4>{featured.data.venue.name}</h4>
                </div>
            </div>
            {
                featured.data.with !== "" && (
                    <div>
                        <h5>with:</h5>
                        <h3 class="mb-0">{featured.data.with}</h3>
                    </div>
                )
            }
            <p class="mb-0">
                <a
                    href={href}
                    class="inline-block px-4 py-2 uppercase border border-accent text-accent hover:bg-accent hover:text-bg"
                >
                    Full listing →
                </a>
            </p>
        </div>
    </div>
    <hr class="w-full" />
    <p class="w-full my-2"><a href="/events/">All events</a></p>
</section>
