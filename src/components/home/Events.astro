---
import { Image } from "astro:assets";
import SectionBar from "./SectionBar.astro";
import EventDetail from "../EventDetail.astro";
import { flyerAlt, getFeaturedEvent, getGalleryImages, groupSlug } from "../../utils/events";

const { event: featured, label } = await getFeaturedEvent();
const href = featured && `/events/${featured.id}/`;
const flyer = featured?.data.flyer;

// Photographs from the featured event (all its sub-events), in gallery order.
// The grid below shows as many whole rows as the panel's height leaves room for
// and hides the rest. None for an upcoming event.
const groupId = featured && groupSlug(featured.data.title);
const photos = (await getGalleryImages()).filter((image) => image.groupId === groupId && image.kind === "photo");
const picks = photos.slice(0, 36);
---

{featured && (
<section id="events" class="flex-col items-stretch">
    <div transition:name="featured-label" class="vt-detail"><SectionBar label={label} /></div>
    <div
        class="grid w-full gap-4 my-auto md:my-0 md:flex-1 md:min-h-0 md:grid-cols-[minmax(0,3fr)_minmax(0,5fr)] md:items-center vt-swap"
        transition:name={featured.data.id}
    >
        {flyer && (
        <div class="w-full max-w-md mx-auto md:max-w-none md:self-center">
            <a href={href} class="thumb fit-picture md:[--fit-h:calc(100vh-var(--section-offset)-var(--spacing-section-inset))]" style={`--ar:${flyer.src.width / flyer.src.height}`} tabindex="-1">
                <Image
                    src={flyer.src}
                    alt={flyerAlt(featured.data)}
                    width={1200}
                    class="block w-full h-auto vt-picture"
                    transition:name={`${featured.data.id}-flyer`}
                />
            </a>
        </div>
        )}
        <div data-featured-column class:list={["md:flex md:flex-col md:self-stretch md:min-h-0", picks.length === 0 && "md:justify-center", !flyer && "md:col-span-2"]}>
            <EventDetail summary event={featured} headingHref={href}>
                {photos.length > 0 && (
                <a slot="title-action" href={`/images/event/${groupId}/`} class="section-action">
                    Event images
                </a>
                )}
            </EventDetail>
            {picks.length > 0 && (
            <div class="photo-area">
                <ul class="photo-grid">
                    {picks.map((image, i) => (
                        <li>
                            <a
                                href={`/images/${image.id}/`}
                                class="block h-full thumb vt-picture"
                                transition:name={image.id}
                            >
                                <Image
                                    src={image.src}
                                    alt={image.description.split(" from ")[0]}
                                    width={i === 0 ? 1200 : 400}
                                    class="block object-cover w-full h-full"
                                />
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            )}
        </div>
    </div>
    <!-- Mirrors the bar so the row is centred in the whole panel, as on the event
         page, and the flyer holds still between the two. -->
    <div class="invisible" aria-hidden="true"><SectionBar label={label} /></div>
</section>
)}

<script>
    // The photo grid shows whole rows only, so the height left over sits under
    // the last row. Pad the top of the column by half of it, so the listing and
    // its photographs are centred as a block, level with the flyer. (Padding
    // rather than a transform: a shifted column overflows the panel and brings
    // in its scrollbar, which narrows the whole panel.) Photographs in rows that
    // are clipped are made inert, so Tab and screen readers skip them.
    const wide = window.matchMedia("(min-width: 48rem)");
    const watch = new ResizeObserver(() => fit());
    const fit = () => {
        document.querySelectorAll<HTMLElement>("[data-featured-column]").forEach((column) => {
            const area = column.querySelector<HTMLElement>(".photo-area");
            if (!area) return;
            column.style.paddingTop = "";
            const items = [...area.querySelectorAll("li")];
            const rects = items.map((li) => li.getBoundingClientRect());
            // Phones show the first nine and hide the rest with display:none.
            items.forEach((li, i) => (li.inert = wide.matches && rects[i].height <= 1 && li.offsetParent !== null));
            if (!wide.matches) return;
            const bottoms = rects.filter((rect) => rect.height > 1).map((rect) => rect.bottom);
            if (!bottoms.length) return;
            const spare = area.getBoundingClientRect().bottom - Math.max(...bottoms);
            if (spare > 0) column.style.paddingTop = `${Math.round(spare / 2)}px`;
        });
    };
    document.addEventListener("astro:after-swap", fit);
    document.addEventListener("astro:before-swap", () => watch.disconnect());
    // The area also resizes when fonts load and the listing rewraps.
    document.addEventListener("astro:page-load", () => {
        fit();
        document.querySelectorAll(".photo-area").forEach((area) => watch.observe(area));
    });
    window.addEventListener("resize", fit);
</script>

<style>
    /* Phones: the first nine (a feature and eight), four across. */
    /* The listing's last rule carries 0.5rem below it; with this the photographs
       sit 1rem (the column gap) under the rule. */
    .photo-area {
        margin-top: 0.5rem;
    }
    .photo-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
    }
    .photo-grid > li {
        aspect-ratio: 1;
        overflow: hidden;
    }
    .photo-grid > li:first-child {
        grid-column: span 2;
        grid-row: span 2;
    }
    .photo-grid > li:nth-child(n + 10) {
        display: none;
    }
    /* From md: six columns of squares, filling the height left under the
       listing, the first photograph 3 x 3 cells when three rows fit, otherwise 2 x 2. The rows are
       exactly one cell tall, so a row that does not fit is dropped (extra rows
       collapse to nothing and are clipped); with room for one row only, the
       feature shows cropped. */
    @media (min-width: 48rem) {
        .photo-area {
            flex: 1 1 0;
            min-height: 0;
            container-type: size;
        }
        .photo-grid {
            --cols: 6;
            --gap: 0.5rem;
            --cell: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols));
            grid-template-columns: repeat(var(--cols), var(--cell));
            grid-template-rows: repeat(auto-fill, var(--cell));
            grid-auto-rows: 0;
            gap: var(--gap);
            height: 100cqh;
            overflow: hidden;
        }
        .photo-grid > li {
            aspect-ratio: auto;
            min-height: 0;
            overflow: hidden;
        }
        .photo-grid > li:nth-child(n + 10) {
            display: block;
        }
        /* Three rows fit when the area is no wider than twice its height (cell
           = about a sixth of the width): then the feature is 3 x 3. */
        @container (max-aspect-ratio: 2/1) {
            .photo-grid > li:first-child {
                grid-column: span 3;
                grid-row: span 3;
            }
        }
    }
</style>
