---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import EventDetail from "../EventDetail.astro";
import { flyerAlt } from "../../utils/events";

// The nearest upcoming event, otherwise the most recent one (decided at build time).
const today = new Date().toISOString().slice(0, 10);
const events = await getCollection("events");
const upcoming = events
    .filter((e) => e.data.date >= today)
    .sort((a, b) => Date.parse(a.data.date) - Date.parse(b.data.date));
const latest = [...events].sort(
    (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);
const featured = upcoming[0] ?? latest[0];
const href = `/events/${featured.id}/`;
---

<section id="events" class="flex-col items-stretch home-section">
    <h2 class="w-full text-3xl md:text-4xl">
        {upcoming[0] ? "Next event" : "Previous event"}
    </h2>
    <hr class="w-full" />
    <div
        class="flex flex-col w-full gap-4 md:flex-row md:flex-1 md:min-h-0"
        transition:name={featured.data.id}
    >
        <a href={href} class="block md:h-full md:max-w-[62%] md:shrink-0">
            <Image
                src={featured.data.flyer.src}
                alt={flyerAlt(featured.data)}
                width={1600}
                class="object-contain w-full h-auto md:h-full md:w-auto"
            />
        </a>
        <div
            data-scroll
            class="w-full md:flex md:flex-col md:flex-1 md:min-w-0 md:overflow-y-auto md:pr-2"
        >
            <div class="md:my-auto">
                <EventDetail summary event={featured} headingHref={href} />
            </div>
        </div>
    </div>
    <hr class="w-full" />
    <p class="w-full my-2"><a href="/events/">All events</a></p>
</section>
