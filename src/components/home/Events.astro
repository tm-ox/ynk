---
import { Image } from "astro:assets";
import SectionBar from "./SectionBar.astro";
import EventDetail from "../EventDetail.astro";
import { flyerAlt, getFeaturedEvent, getGalleryImages, groupSlug } from "../../utils/events";

const { event: featured, label } = await getFeaturedEvent();
const href = featured && `/events/${featured.id}/`;
const flyer = featured?.data.flyer;

// Photographs from the featured event (all its sub-events), in gallery order.
// The grid below shows as many whole rows as the panel's height leaves room for
// and hides the rest. None for an upcoming event.
const groupId = featured && groupSlug(featured.data.title);
const photos = (await getGalleryImages()).filter((image) => image.groupId === groupId);
const picks = photos.slice(0, 36);
---

{featured && (
<section id="events" class="flex-col items-stretch">
    <div transition:name="featured-label" class="vt-detail"><SectionBar label={label} /></div>
    <div
        class="grid w-full gap-4 my-auto md:my-0 md:flex-1 md:min-h-0 md:grid-cols-[minmax(0,3fr)_minmax(0,5fr)] md:items-center"
        transition:name={featured.data.id}
    >
        {flyer && (
        <div class="w-full max-w-md mx-auto md:max-w-none md:self-center vt-detail" transition:name={`${featured.data.id}-flyer`}>
            <a href={href} class="block" tabindex="-1" aria-hidden="true">
                <Image
                    src={flyer.src}
                    alt={flyerAlt(featured.data)}
                    width={1200}
                    class="object-contain my-1 h-auto w-full mb-auto md:max-h-[calc(100vh-var(--section-offset)-38px)]"
                />
            </a>
        </div>
        )}
        <div class:list={["md:flex md:flex-col md:self-stretch md:min-h-0", !flyer && "md:col-span-2"]}>
            <EventDetail summary event={featured} headingHref={href}>
                {photos.length > 0 && (
                <a slot="title-action" href={`/images/event/${groupId}/`} class="section-action">
                    Event images
                </a>
                )}
            </EventDetail>
            {picks.length > 0 && (
            <div class="photo-area">
                <ul class="photo-grid">
                    {picks.map((image, i) => (
                        <li>
                            <a
                                href={`/images/${image.id}/`}
                                class="block h-full"
                                transition:name={image.id}
                            >
                                <Image
                                    src={image.src}
                                    alt={image.description}
                                    width={i === 0 ? 800 : 400}
                                    class="block object-cover w-full h-full"
                                />
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            )}
        </div>
    </div>
    <!-- Mirrors the bar so the row is centred in the whole panel, as on the event
         page, and the flyer holds still between the two. -->
    <div class="invisible" aria-hidden="true"><SectionBar label={label} /></div>
</section>
)}

<style>
    /* Phones: the first nine (a feature and eight), four across. */
    .photo-area {
        margin-top: 1rem;
    }
    .photo-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
    }
    .photo-grid > li {
        aspect-ratio: 1;
    }
    .photo-grid > li:first-child {
        grid-column: span 2;
        grid-row: span 2;
    }
    .photo-grid > li:nth-child(n + 10) {
        display: none;
    }
    /* From md: six columns of squares, filling the height left under the
       listing, the first photograph twice the size (2 x 2 cells). The rows are
       exactly one cell tall, so a row that does not fit is dropped (extra rows
       collapse to nothing and are clipped); with room for one row only, the
       feature shows cropped. */
    @media (min-width: 48rem) {
        .photo-area {
            flex: 1 1 0;
            min-height: 0;
            container-type: size;
        }
        .photo-grid {
            --cols: 6;
            --gap: 0.5rem;
            --cell: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols));
            grid-template-columns: repeat(var(--cols), var(--cell));
            grid-template-rows: repeat(auto-fill, var(--cell));
            grid-auto-rows: 0;
            gap: var(--gap);
            height: 100cqh;
            overflow: hidden;
        }
        .photo-grid > li {
            aspect-ratio: auto;
            min-height: 0;
            overflow: hidden;
        }
        .photo-grid > li:nth-child(n + 10) {
            display: block;
        }
    }
</style>
