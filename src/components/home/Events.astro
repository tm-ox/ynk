---
import { getCollection, render } from "astro:content";
import EventDetail from "../EventDetail.astro";
import { groupSlug } from "../../utils/events";

// The nearest upcoming event, otherwise the most recent one (decided at build time).
const today = new Date().toISOString().slice(0, 10);
const events = await getCollection("events");
const upcoming = events
    .filter((e) => e.data.date >= today)
    .sort((a, b) => Date.parse(a.data.date) - Date.parse(b.data.date));
const latest = [...events].sort(
    (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);
const featured = upcoming[0] ?? latest[0];
const { Content } = await render(featured);
const hasPhotos = (featured.data.images ?? []).some(Boolean);
---

<section id="events" class="flex-col items-stretch md:overflow-hidden home-section">
    <h2 class="w-full text-3xl md:text-4xl">
        {upcoming[0] ? "Next event" : "Previous event"}
    </h2>
    <hr class="w-full" />
    <div class="w-full md:flex-1 md:min-h-0" transition:name={featured.data.id}>
    <EventDetail
        contained
        event={featured}
        headingHref={`/events/${featured.id}/`}
        docsHref={hasPhotos ? `/images/event/${groupSlug(featured.data.title)}/` : undefined}
    >
        <Content />
    </EventDetail>
    </div>
    <hr class="w-full" />
    <p class="w-full my-2"><a href="/events/">All events</a></p>
</section>
