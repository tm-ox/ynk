---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SectionBar from "./SectionBar.astro";
import EventDetail from "../EventDetail.astro";
import { flyerAlt, getGalleryImages, groupSlug } from "../../utils/events";

// The nearest upcoming event, otherwise the most recent one (decided at build time).
const today = new Date().toISOString().slice(0, 10);
const events = await getCollection("events");
const upcoming = events
    .filter((e) => e.data.date >= today)
    .sort((a, b) => Date.parse(a.data.date) - Date.parse(b.data.date));
const latest = [...events].sort(
    (a, b) => Date.parse(b.data.date) - Date.parse(a.data.date),
);
const featured = upcoming[0] ?? latest[0];
const href = featured && `/events/${featured.id}/`;
const label = upcoming[0] ? "Next event" : "Previous event";
const flyer = featured?.data.flyer;

// Photographs from the featured event (all its sub-events), four spread evenly
// through the night. None for an upcoming event.
const groupId = featured && groupSlug(featured.data.title);
const photos = (await getGalleryImages()).filter((image) => image.groupId === groupId);
const COUNT = 4;
const picks =
    photos.length <= COUNT
        ? photos
        : Array.from({ length: COUNT }, (_, i) =>
              photos[Math.round((i * (photos.length - 1)) / (COUNT - 1))],
          );
---

{featured && (
<section id="events" class="flex-col items-stretch">
    <SectionBar label={label} />
    <div
        class="grid w-full gap-4 my-auto md:gap-4 md:grid-cols-[minmax(0,3fr)_minmax(0,5fr)] md:items-center"
        transition:name={featured.data.id}
    >
        {flyer && (
        <div class="w-full max-w-md mx-auto md:max-w-none md:self-center vt-detail" transition:name={`${featured.data.id}-flyer`}>
            <a href={href} class="block" tabindex="-1" aria-hidden="true">
                <Image
                    src={flyer.src}
                    alt={flyerAlt(featured.data)}
                    width={1200}
                    class="object-contain my-1 h-auto w-full mb-auto md:max-h-[calc(100vh-var(--section-offset)-38px)]"
                />
            </a>
        </div>
        )}
        <div class={flyer ? "" : "md:col-span-2"}>
            <EventDetail summary event={featured} headingHref={href}>
                {photos.length > 0 && (
                <a slot="title-action" href={`/images/event/${groupId}/`} class="section-action">
                    Event images
                </a>
                )}
            </EventDetail>
            {picks.length > 0 && (
            <ul class="grid grid-cols-2 gap-2 mt-4 sm:grid-cols-4">
                {picks.map((image) => (
                    <li class="aspect-square">
                        <a
                            href={`/images/${image.id}/`}
                            class="block h-full"
                            transition:name={image.id}
                        >
                            <Image
                                src={image.src}
                                alt={image.description}
                                width={600}
                                class="block object-cover w-full h-full"
                            />
                        </a>
                    </li>
                ))}
            </ul>
            )}
        </div>
    </div>
    <!-- Mirrors the bar so the row is centred in the whole panel, as on the event
         page, and the flyer holds still between the two. -->
    <div class="invisible" aria-hidden="true"><SectionBar label={label} /></div>
</section>
)}
