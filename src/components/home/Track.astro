<!-- Named, so a page turn to or from an archive moves the panels as one
     piece (see global.css). -->
<div class="home-track vt-page" data-track transition:name="home">
    <slot />
</div>

<script>
    import { bindWheelPager } from "../../scripts/wheel-pager";
    import { pageTrack, trackActive } from "../../scripts/track";
    import "../../scripts/reveal";

    // From the sm breakpoint up the home sections are side-by-side panels.
    // A wheel gesture (or a key, see scripts/keys.ts) moves one panel; a panel
    // taller than the screen scrolls itself first. Below sm the page scrolls
    // vertically as normal.
    bindWheelPager({
        root: trackActive,
        canStep: () => true,
        step: pageTrack,
    });
</script>
