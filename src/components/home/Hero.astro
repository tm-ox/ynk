---
import { Image } from "astro:assets";
import background from "../../content/images/splash2025.jpg";

// The photograph's own proportions (2048x1366) and where the neon sign sits in
// it, as fractions of its width and height.
const ratio = background.width / background.height;
const sign = { x: 0.561, y: 0.358 };
// The crop: how far in to zoom (1 = the photograph just covers the stage) and
// the point of the photograph kept at the stage's centre. The source is 2048px
// wide, so up to about 1.5 times a 1300px stage is still at full sharpness.
const zoom = 1.7;
const focus = { x: 0.58, y: 0.47 };

// The headline: "Experimental" and a word that changes. The founding event
// was "a monthly experimental whatever event" (see About); the last word is the
// one shown when nothing moves. Edit the list to change the cycle.
const words = ["music", "sound", "film", "performance", "whatever", "etc."];
const wordSeconds = 2.6;
const cycle = words.length * wordSeconds;
// Each word fades up, holds, then fades away within its own 1/N of the cycle.
const slot = 100 / words.length;
const wordKeyframes = `@keyframes hero-word {
    0% { opacity: 0; translate: 0 0.2em; }
    ${(slot * 0.12).toFixed(2)}% { opacity: 1; translate: 0 0; }
    ${(slot * 0.88).toFixed(2)}% { opacity: 1; translate: 0 0; }
    ${slot.toFixed(2)}%, 100% { opacity: 0; translate: 0 -0.2em; }
}`;
---

<section id="top">
    <div class="relative flex items-center justify-center self-stretch w-full -mt-3 -mb-4 overflow-hidden hero-stage">
        <!-- The picture and the glow share one box with the photograph's
             proportions, sized to cover the stage, so the glow stays on the sign
             whatever the stage's shape. -->
        <div
            class="hero-art"
            style={`--ratio:${ratio}; --zoom:${zoom}; --sign-x:${sign.x * 100}%; --sign-y:${sign.y * 100}%; --focus-x:${focus.x}; --focus-y:${focus.y};`}
            aria-hidden="true"
        >
            <Image
                src={background}
                alt=""
                widths={[1024, 1600, 2048]}
                sizes={`${Math.ceil(zoom * 100)}vw`}
                loading="eager"
                fetchpriority="high"
                class="block w-full h-full"
            />
            <div class="hero-glow"></div>
        </div>
        <h1 class="relative display-hero hero-title">
            <span class="block">Experimental</span>
            <!-- The words are for the eye; the heading reads "Experimental etc." -->
            <span class="sr-only"> etc.</span>
            <span class="hero-words" aria-hidden="true" style={`--cycle:${cycle}s; --step:${wordSeconds}s;`}>
                {words.map((word, i) => <span class="hero-word" style={`--i:${i}`}>{word}</span>)}
            </span>
        </h1>
    </div>
</section>

<style set:html={wordKeyframes}></style>

<style>
    .hero-stage {
        container-type: size;
    }
    /* The box is the photograph at its zoom, positioned so the focus point is
       at the stage's centre, but never so far that an edge shows. */
    .hero-art {
        --w: calc(max(100cqw, 100cqh * var(--ratio)) * var(--zoom));
        --h: calc(var(--w) / var(--ratio));
        position: absolute;
        width: var(--w);
        height: var(--h);
        left: clamp(calc(100cqw - var(--w)), calc(50cqw - var(--focus-x) * var(--w)), 0px);
        top: clamp(calc(100cqh - var(--h)), calc(50cqh - var(--focus-y) * var(--h)), 0px);
        transform-origin: var(--sign-x) var(--sign-y);
    }
    /* A soft cyan light over the sign; screen blending only ever adds light. */
    .hero-glow {
        position: absolute;
        left: var(--sign-x);
        top: var(--sign-y);
        width: 36%;
        aspect-ratio: 1;
        translate: -50% -50%;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgb(110 220 255 / 0.75) 0%,
            rgb(50 150 255 / 0.42) 22%,
            rgb(40 110 255 / 0.16) 46%,
            transparent 70%
        );
        mix-blend-mode: screen;
        opacity: 0.85;
        pointer-events: none;
    }
    /* A strip down the middle of the stage (--strip wide), with the headline
       large enough to break inside it: "Experimental" over the changing word,
       each wrapping within the strip, lines butted by a cap-height line-height
       (BioRhyme Expanded's capitals are about 0.72em tall; lower --cap-lh to
       overlap them). Tune --strip, --size and --cap-lh. */
    .hero-title {
        --strip: 62cqw;
        --size: clamp(2.25rem, 7cqw, 6.5rem);
        --cap-lh: 0.6;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: var(--strip);
        text-align: center;
        overflow-wrap: anywhere;
        word-break: normal;
        font-size: var(--size);
        line-height: var(--cap-lh);
        padding-block: 1rem;
    }
    /* The words share one cell, so the line is as wide as the longest. Still, or
       with reduced motion, only the last shows. */
    .hero-words {
        display: inline-grid;
        width: 100%;
        text-align: center;
    }
    .hero-word {
        grid-area: 1 / 1;
        min-width: 0;
        opacity: 0;
    }
    .hero-word:last-child {
        opacity: 1;
    }
    @media (prefers-reduced-motion: no-preference) {
        .hero-word {
            animation: hero-word var(--cycle) linear infinite both;
            animation-delay: calc(var(--i) * var(--step));
        }
        /* A very slow push-in towards the sign and back. */
        .hero-art {
            animation: hero-drift 40s ease-in-out infinite alternate;
            will-change: transform;
        }
        /* The light swells and fades, and its tube flickers faintly once a cycle. */
        .hero-glow {
            animation:
                hero-neon 9s ease-in-out infinite,
                hero-swell 6s ease-in-out infinite;
        }
    }
    @keyframes hero-drift {
        to {
            transform: scale(1.07);
        }
    }
    @keyframes hero-swell {
        50% {
            scale: 1.12;
        }
    }
    @keyframes hero-neon {
        0%,
        100% {
            opacity: 0.7;
        }
        45% {
            opacity: 1;
        }
        70% {
            opacity: 1;
        }
        71% {
            opacity: 0.88;
        }
        72% {
            opacity: 1;
        }
        73% {
            opacity: 0.92;
        }
        75% {
            opacity: 1;
        }
    }
</style>
