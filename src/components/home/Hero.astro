---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

// The pictures: documentation photographs from the events (never flyers), one
// per event (its first that qualifies), landscape and wide enough to fill the
// stage sharply. If fewer than `enough` events have one at the preferred width,
// the fallback width is used. The pick is spread across the years: newest year
// first, one event from each year in turn, newest event first within a year,
// up to `most`. The script below keeps the first two in place (the first is the
// eager one; the second is the next, shown and loading from the start) and
// shuffles the rest on every visit.
const pick = { preferred: 1600, fallback: 1200, enough: 6, most: 20 };
// The photograph to use for an event instead of its first that qualifies:
// event id (the frontmatter `id`, e.g. "ynk51") to the photograph's file name
// (without the extension) as in src/content/images, which must be one of that
// event's own images. It is used as is, whatever its size or shape; the event
// still takes part in the pick as usual.
const override: Record<string, string> = {
    ynk51: "ynk51-06",
    ynk46: "ynk46-02",
    ynkprepp2025: "ynkprepp2025-06",
    "pp2025-1": "pp2025-1-40",
    "pp2025-2": "pp2025-2-76",
    "pp2025-3": "pp2025-3-54",
    ynd05: "ynd05-09",
    "pp2024-3": "pp2024-3-76",
    "pp2024-2": "pp2024-2-30",
    "pp2024-1": "pp2024-1-73",
    ynd02: "ynd02-02",
    "pp2023-2": "pp2023-2-10",
    "pp2023-1": "pp2023-1-15",
};
const named = (src: ImageMetadata, name: string) =>
    new RegExp(`/${name}(\\.[^/]*)?\\.[a-z]+(\\?|$)`, "i").test(src.src);

type Candidate = { src: ImageMetadata; date: string };
const events = await getCollection("events");
for (const [id, name] of Object.entries(override)) {
    const event = events.find((e) => e.data.id === id);
    if (!event?.data.images?.some((img) => img?.src && named(img.src, name)))
        throw new Error(
            `Hero.astro: override "${id}: ${name}" matches no image of that event.`,
        );
}
const candidates = (minWidth: number): Candidate[] =>
    events.flatMap((event) => {
        const chosen = override[event.data.id];
        if (chosen) {
            const own = event.data.images?.find(
                (img) => img?.src && named(img.src, chosen),
            );
            return own?.src ? [{ src: own.src, date: event.data.date }] : [];
        }
        const photo = (event.data.images ?? []).find(
            (img) =>
                img?.src &&
                img.src.width > img.src.height &&
                img.src.width >= minWidth,
        );
        return photo?.src ? [{ src: photo.src, date: event.data.date }] : [];
    });
let pool = candidates(pick.preferred);
if (pool.length < pick.enough) pool = candidates(pick.fallback);
const byYear = new Map<string, Candidate[]>();
for (const c of [...pool].sort((a, b) => b.date.localeCompare(a.date))) {
    const year = c.date.slice(0, 4);
    byYear.set(year, [...(byYear.get(year) ?? []), c]);
}
const years = [...byYear.values()];
const photos: ImageMetadata[] = [];
for (
    let round = 0;
    photos.length < pick.most && years.some((y) => y.length > round);
    round++
) {
    for (const year of years) {
        if (year[round] && photos.length < pick.most)
            photos.push(year[round].src);
    }
}
if (photos.length < 2)
    throw new Error(
        "Hero.astro: the sweep needs at least two event photographs.",
    );
// Responsive widths up to the photograph's own (capped), for sizes="100vw".
const widthsFor = (w: number) =>
    [640, 960, 1280, 1600, 1920].filter((x) => x < w).concat(Math.min(w, 2400));

// The headline: "Experimental" and a word that changes. The founding event
// was "a monthly experimental whatever event" (see About); the last word is the
// one shown when nothing moves. Edit the list to change the cycle (two words at
// least). The heading's text for screen readers is "Experimental etc." whatever
// the list holds (the sr-only span below), not the still word: deliberately.
const words = [
    "music",
    "sound",
    "performance",
    "people",
    "et cetera",
    "whatever",
];
if (words.length < 2)
    throw new Error(
        "Hero.astro: the cycling headline needs at least two words.",
    );
const wordSeconds = 1.8;
const cycle = words.length * wordSeconds;

// How each word glitches in and out. Every word gets its own jolt (sideways,
// up/down, tilt) from these lists, used in turn, so entrances differ (the lists have six entries and repeat beyond that).
const jolts = {
    x: ["0.06em", "-0.09em", "0.11em", "-0.05em", "0.08em", "-0.1em"],
    y: ["-0.03em", "0.04em", "0.02em", "-0.05em", "-0.02em", "0.04em"],
    r: ["-3deg", "2.5deg", "-1.5deg", "3.5deg", "-2deg", "1.5deg"],
};
const jolt = (list: string[], i: number) => list[i % list.length];

// One slot is a word's 1/N of the cycle. Keyframes are hard cuts (steps), as a
// signal breaking up: flicker and slice in, settle and hold, then
// slice and flicker out. The slices leave room (-0.3em) on the sides they do not
// cut, because the capitals are taller than the tight line box; settled is no clip.
// Colour fringes echo the photograph's blue and pink.
const slot = 100 / words.length;
const split = (e: number) =>
    `text-shadow: ${e}em 0 var(--hero-fringe-a), -${e}em 0 var(--hero-fringe-b)`;
const frames: [number, string][] = [
    [0, "opacity: 0"],
    [
        0.005,
        `opacity: 1; translate: var(--dx) var(--dy); rotate: var(--dr); clip-path: inset(-0.3em -0.3em 55% -0.3em); ${split(0.05)}`,
    ],
    [0.03, "opacity: 0"],
    [
        0.05,
        `opacity: 1; translate: calc(var(--dx) * -0.6) calc(var(--dy) * -1); rotate: calc(var(--dr) * -0.5); clip-path: inset(38% -0.3em -0.3em -0.3em); ${split(0.04)}`,
    ],
    [
        0.08,
        `translate: calc(var(--dx) * 0.3) 0; rotate: 0deg; clip-path: inset(-0.3em -0.3em 20% -0.3em); ${split(0.02)}`,
    ],
    [0.11, "translate: 0 0; rotate: 0deg; clip-path: none; text-shadow: none"],
    [
        0.84,
        `translate: calc(var(--dx) * -1) calc(var(--dy) * 0.5); rotate: calc(var(--dr) * 0.7); clip-path: inset(20% -0.3em 40% -0.3em); ${split(0.05)}`,
    ],
    [0.88, "opacity: 0"],
    [
        0.91,
        `opacity: 1; translate: calc(var(--dx) * 0.5) 0; rotate: 0deg; clip-path: inset(55% -0.3em -0.3em -0.3em); ${split(0.03)}`,
    ],
    [0.95, "opacity: 0"],
];
const wordKeyframes = `@keyframes hero-word {
${frames
    .map(
        ([at, css]) =>
            `    ${(slot * at).toFixed(3)}% { ${css}; animation-timing-function: steps(1, end); }`,
    )
    .join("\n")}
    ${slot.toFixed(3)}%, 100% { opacity: 0; }
}`;

// The tempo: seconds a picture rests before the next sweep, on a wide stage
// and on a narrow (under 48rem) or portrait one, where there is more to take
// in per picture. The sweep itself takes --seam-duration (global.css).
const dwell = { wide: 5, narrow: 7 };
// The pointer parallax (fine pointers only): the most the pictures move
// against the pointer, in px, and how much of the remaining distance they cover
// per frame (lower is softer). `overscan` scales the pictures up so the shift
// never shows an edge; the script clamps the shift to what it leaves. `title`
// is how far the headline moves the other way, toward the pointer, as a share
// of the pictures' shift (0 holds it still).
const parallax = { shift: 10, ease: 0.06, overscan: 1.02, title: 0.3 };
---

<section id="top">
    <div
        class="relative grid grid-cols-[minmax(0,1fr)] grid-rows-[1fr_auto_1fr] justify-items-center self-stretch w-full -mt-2 -mb-4 overflow-hidden hero-stage"
        style={`--overscan:${parallax.overscan};`}
        data-dwell-wide={dwell.wide}
        data-dwell-narrow={dwell.narrow}
        data-shift={parallax.shift}
        data-ease={parallax.ease}
        data-overscan={parallax.overscan}
        data-title={parallax.title}
    >
        <!-- Two of these show at once: the current picture and, above it, the
             next, masked to the right of the seam. The rest wait (display:none)
             until their turn. -->
        <div class="hero-pics" aria-hidden="true">
            {photos.map((src, i) => (
                <div
                    class="hero-pic"
                    data-role={
                        i === 0 ? "current" : i === 1 ? "next" : undefined
                    }
                >
                    <Image
                        src={src}
                        alt=""
                        widths={widthsFor(src.width)}
                        sizes="100vw"
                        loading={i === 0 ? "eager" : "lazy"}
                        fetchpriority={i === 0 ? "high" : undefined}
                    />
                </div>
            ))}
        </div>
        <!-- The line that rides the seam, between two strips of page background,
             as in the page turn. Below the headline. -->
        <div class="hero-seam" aria-hidden="true"></div>
        <h1 class="relative row-start-2 display-hero hero-title">
            <span class="block hero-lead">Experimental</span>
            <!-- The words are for the eye; the heading reads "Experimental etc." -->
            <span class="sr-only"> etc.</span>
            <span
                class="hero-words"
                aria-hidden="true"
                style={`--cycle:${cycle}s; --step:${wordSeconds}s;`}
            >
                {words.map((word, i) => (
                    <span
                        class="hero-word"
                        style={`--i:${i}; --dx:${jolt(jolts.x, i)}; --dy:${jolt(jolts.y, i)}; --dr:${jolt(jolts.r, i)};`}
                    >
                        {word}
                    </span>
                ))}
            </span>
        </h1>
        <!-- Out of the grid flow altogether (absolute), vertically centred on the
             stage at its right edge, so it cannot move the headline; on
             narrow stages centred in the grid's third row instead. Size and inset: see .hero-nav in the
             styles. -->
        <div class="absolute hero-nav">
            <a
                href="/featured/"
                target="_self"
                aria-label="Next section"
                class="hero-next"
            >
                <Icon name="ion:arrow-forward-sharp" class="icon hero-next-icon" />
            </a>
        </div>
        <!-- How the site moves on, for those who would not guess, in one row
             along the stage's foot: keys and the wheel with a pointer, a swipe
             on a touch screen (the same split as Settings). -->
        <p class="absolute hero-hint" aria-hidden="true">
            <span class="hero-hint-label">Navigate</span>
            <span class="hero-hint-slash"></span>
            <span class="hero-hint-keys">
                <kbd class="hero-key"><Icon name="ion:arrow-back-sharp" class="hero-key-icon" /></kbd><kbd class="hero-key"><Icon name="ion:arrow-forward-sharp" class="hero-key-icon" /></kbd>
                <kbd class="hero-key">h</kbd><kbd class="hero-key">l</kbd>
                <kbd class="hero-key hero-key-word">scroll</kbd>
                <kbd class="hero-key">?</kbd>
            </span>
            <kbd class="hero-key hero-key-word hero-hint-touch">swipe</kbd>
        </p>
    </div>
</section>

<script>
    // The sweep: every dwell, once the next picture is decoded, the seam
    // crosses the stage right to left (the .is-sweeping animation in the
    // styles), the next picture behind it. When it is across, the roles move
    // on in the same frame: the next picture becomes the current one, and the
    // mask resets offstage.
    // It waits while the tab is hidden and while a page turn is being prepared.
    let teardown: (() => void) | undefined;

    const shuffle = <T,>(list: T[]) => {
        for (let i = list.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [list[i], list[j]] = [list[j], list[i]];
        }
        return list;
    };

    function init() {
        const stage = document.querySelector<HTMLElement>(".hero-stage");
        if (!stage) return;
        const ctrl = new AbortController();
        const { signal } = ctrl;
        const timers = new Set<number>();
        let frame = 0;
        teardown = () => {
            ctrl.abort();
            timers.forEach(clearTimeout);
            cancelAnimationFrame(frame);
            teardown = undefined;
        };
        const still = matchMedia("(prefers-reduced-motion: reduce)");
        still.addEventListener(
            "change",
            () => {
                teardown?.();
                init();
            },
            { signal },
        );

        const pics = [...stage.querySelectorAll<HTMLElement>(".hero-pic")];
        const seam = stage.querySelector<HTMLElement>(".hero-seam")!;

        // Back to the server's state (a restart can come mid-cycle), then the
        // order for this visit: the first two stay (the server made the second
        // the next, already loading), the rest shuffled.
        const order = [0, 1, ...shuffle(pics.slice(2).map((_, i) => i + 2))];
        let at = 0;
        const setRoles = () => {
            pics.forEach((pic) => delete pic.dataset.role);
            pics[order[at]].dataset.role = "current";
            const next = pics[order[(at + 1) % order.length]];
            next.dataset.role = "next";
            next.querySelector("img")!.loading = "eager";
        };
        stage.classList.remove("is-sweeping");
        setRoles();
        if (still.matches) return;

        // Paused while hidden or while a page turn is under way; every change
        // of state re-arms whatever is waiting.
        let turning = false;
        const waiting = new Set<() => void>();
        const changed = () => waiting.forEach((arm) => arm());
        const running = () => !document.hidden && !turning;
        document.addEventListener("visibilitychange", changed, { signal });
        document.addEventListener(
            "astro:before-preparation",
            () => ((turning = true), changed()),
            { signal },
        );
        document.addEventListener(
            "astro:after-swap",
            () => ((turning = false), changed()),
            { signal },
        );
        // Resolves after ms of running time, counted afresh whenever a pause
        // ends (so a tab brought back rests a whole dwell first). rest(0)
        // just waits until running.
        const rest = (ms: number) =>
            new Promise<void>((resolve) => {
                let timer = 0;
                const arm = () => {
                    clearTimeout(timer);
                    timers.delete(timer);
                    if (!running()) return;
                    timer = window.setTimeout(() => {
                        waiting.delete(arm);
                        timers.delete(timer);
                        resolve();
                    }, ms);
                    timers.add(timer);
                };
                waiting.add(arm);
                arm();
            });
        // Narrow as the styles' @container (max-width: 48rem) has it, in the
        // root's rems.
        const dwell = () => {
            const rem = parseFloat(
                getComputedStyle(document.documentElement).fontSize,
            );
            const narrow =
                stage.clientWidth <= 48 * rem ||
                stage.clientHeight > stage.clientWidth;
            return (
                Number(
                    narrow
                        ? stage.dataset.dwellNarrow
                        : stage.dataset.dwellWide,
                ) * 1000
            );
        };
        // One crossing; the seam's own animation ends it (the pictures' run
        // alongside on the same clock).
        const sweep = () =>
            new Promise<void>((resolve) => {
                const done = (e: AnimationEvent) => {
                    if (e.target !== seam) return;
                    seam.removeEventListener("animationend", done);
                    at = (at + 1) % order.length;
                    setRoles();
                    stage.classList.remove("is-sweeping");
                    resolve();
                };
                seam.addEventListener("animationend", done, { signal });
                stage.classList.add("is-sweeping");
            });
        (async () => {
            while (!signal.aborted) {
                await rest(dwell());
                // The next picture must be ready, or the seam would uncover a
                // blank; one that fails to load drops out of the order.
                const slot = (at + 1) % order.length;
                try {
                    await pics[order[slot]].querySelector("img")!.decode();
                } catch {
                    if (signal.aborted) return;
                    if (order.length > 2) {
                        order.splice(slot, 1);
                        // The next one wraps to the start: the current one
                        // moves down a place with the rest.
                        if (slot < at) at--;
                        if (at >= order.length) at = 0;
                        setRoles();
                    }
                    continue;
                }
                await rest(0);
                if (signal.aborted) return;
                await sweep();
            }
        })();

        // The parallax: the pictures move against the pointer's offset from
        // the stage's centre, eased toward it frame by frame, never further
        // than the overscan leaves.
        if (matchMedia("(pointer: fine)").matches) {
            const most = Number(stage.dataset.shift);
            const ease = Number(stage.dataset.ease);
            const spare = (Number(stage.dataset.overscan) - 1) / 2;
            const title = Number(stage.dataset.title);
            const target = { x: 0, y: 0 };
            const now = { x: 0, y: 0 };
            const step = () => {
                now.x += (target.x - now.x) * ease;
                now.y += (target.y - now.y) * ease;
                stage.style.setProperty("--px", `${now.x.toFixed(2)}px`);
                stage.style.setProperty("--py", `${now.y.toFixed(2)}px`);
                stage.style.setProperty(
                    "--tx",
                    `${(-now.x * title).toFixed(2)}px`,
                );
                stage.style.setProperty(
                    "--ty",
                    `${(-now.y * title).toFixed(2)}px`,
                );
                const far =
                    Math.abs(target.x - now.x) + Math.abs(target.y - now.y) >
                    0.05;
                frame = far ? requestAnimationFrame(step) : 0;
            };
            const toward = (offset: number, half: number) =>
                Math.max(-1, Math.min(1, offset / half));
            window.addEventListener(
                "pointermove",
                (e) => {
                    const s = stage.getBoundingClientRect();
                    const room = {
                        x: Math.max(0, Math.min(most, s.width * spare - 1)),
                        y: Math.max(0, Math.min(most, s.height * spare - 1)),
                    };
                    target.x =
                        -toward(
                            e.clientX - (s.left + s.width / 2),
                            s.width / 2,
                        ) * room.x;
                    target.y =
                        -toward(
                            e.clientY - (s.top + s.height / 2),
                            s.height / 2,
                        ) * room.y;
                    if (!frame) frame = requestAnimationFrame(step);
                },
                { signal, passive: true },
            );
        }
    }

    document.addEventListener("astro:page-load", () => {
        teardown?.();
        init();
    });
    document.addEventListener("astro:before-swap", () => teardown?.());
</script>

<style set:html={wordKeyframes}></style>

<style>
    /* From the header rule (-mt-2 takes back the section's pt-2) to the
       footer; on phones, which have none, to the screen's foot
       (min-h-section), and edge to edge (the page bleeds there: index.astro). */
    .hero-stage {
        container-type: size;
    }
    /* The seam, as in the page turn (global.css): --seam is its distance right
       of the stage's centre at mid-height, and each masked box's --edge is that
       distance from its own centre, its masks gradients its own size at
       --wipe-angle (so the stop moves by --edge * 0.848). At rest the seam
       waits just past the right edge, by --sweep-overhang (the lean over half
       the stage's height, and enough for the band), so nothing is masked; a
       sweep takes it to just past the left edge over --seam-duration with
       --page-seam-easing, the page turn's tempo. */
    .hero-pic,
    .hero-seam {
        --sweep-overhang: calc(50cqh * 0.625 + 8px);
        --seam: calc(50cqw + var(--sweep-overhang));
        --edge: var(--seam);
    }
    .hero-stage.is-sweeping :is(.hero-pic, .hero-seam) {
        animation: hero-sweep var(--seam-duration) var(--page-seam-easing) both;
    }
    @keyframes hero-sweep {
        to {
            --seam: calc(-50cqw - var(--sweep-overhang));
        }
    }
    .hero-pics {
        position: absolute;
        inset: 0;
        isolation: isolate;
    }
    .hero-pic {
        display: none;
        position: absolute;
        inset: 0;
        overflow: hidden;
    }
    .hero-pic[data-role] {
        display: block;
    }
    /* The pictures are scaled up by --overscan and shifted by the parallax
       (--px, --py, set by the script), inside boxes that stay put, so the
       seam's masks never move with them. */
    .hero-pic > :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        scale: var(--overscan);
        translate: var(--px, 0px) var(--py, 0px);
    }
    /* The incoming picture shows only right of the seam, past the band, as the
       page turn's incoming page does. */
    .hero-pic[data-role="next"] {
        z-index: 1;
        mask-image: linear-gradient(
            var(--wipe-angle),
            transparent calc(50% + var(--edge) * 0.848 + var(--page-band)),
            #000 calc(50% + var(--edge) * 0.848 + var(--page-band))
        );
        mask-size: 100% 100%;
        mask-repeat: no-repeat;
    }
    /* The page turn's band: the line between two strips of page background,
       just behind the edge. */
    .hero-seam {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(
            var(--wipe-angle),
            transparent calc(50% + var(--edge) * 0.848),
            var(--color-bg) calc(50% + var(--edge) * 0.848),
            var(--color-bg) calc(50% + var(--edge) * 0.848 + var(--page-halo)),
            var(--color-border)
                calc(50% + var(--edge) * 0.848 + var(--page-halo)),
            var(--color-border)
                calc(
                    50% + var(--edge) * 0.848 + var(--page-halo) +
                        var(--wipe-line)
                ),
            var(--color-bg)
                calc(
                    50% + var(--edge) * 0.848 + var(--page-halo) +
                        var(--wipe-line)
                ),
            var(--color-bg) calc(50% + var(--edge) * 0.848 + var(--page-band)),
            transparent calc(50% + var(--edge) * 0.848 + var(--page-band))
        );
    }
    /* A strip down the middle of the stage (--strip wide), with the headline
       large enough to break inside it, set left in it: "Experimental" over the changing word,
       each wrapping within the strip. BioRhyme Expanded's capitals are about
       0.72em tall, so a line-height of 0.72 would just touch; --cap-lh is tuned
       lower so the lines overlap. This overrides the --text-hero tokens in
       global.css, which now serve only the 404 page's .display-hero. Tune
       --strip, --size and --cap-lh. */
    .hero-title {
        /* Set flush with the stage's left edge (justify-self), its right end
           9.7cqw short of the stage's right, room for the arrow. --size
           follows --strip (both in cqw, within the clamp), so the lines break
           in the same places as the stage grows; change them together. */
        --strip: 90.3cqw;
        --size: clamp(2.25rem, 10.2cqw, 9.5rem);
        justify-self: start;
        /* Pulled left by the E's side bearing (0.062em in BioRhyme Expanded
           800, the weight a black h1 resolves to), so its stem, not its
           box, meets the edge. Other first letters (the changing word) keep
           their own bearings. */
        margin-left: -0.062em;
        --cap-lh: 0.56;
        color: var(--hero-ink);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: var(--strip);
        text-align: left;
        overflow-wrap: anywhere;
        word-break: normal;
        font-size: var(--size);
        line-height: var(--cap-lh);
        padding-block: 1rem;
    }
    /* Narrow stages: the strip runs edge to edge and the type is as large as
       "EXPERI" across it, so "Experimental" breaks before the M and the
       changing words break wherever they reach the edge. "EXPERI" is about
       6.46em wide in BioRhyme Expanded with the -0.1em tracking, so 15cqw
       leaves it about 3% short of the edges (15.4cqw would touch them). Tune
       --size here for phones. */
    @container (max-width: 48rem) {
        .hero-title {
