---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import background from "../../content/images/splash2025.jpg";

// The photograph's own proportions (2048x1366) and where the neon sign sits in
// it, as fractions of its width and height.
const ratio = background.width / background.height;
const sign = { x: 0.561, y: 0.358 };
// The crop: how far in to zoom (1 = the photograph just covers the stage) and
// the point of the photograph kept at the stage's centre. The source is 2048px
// wide, so up to about 1.5 times a 1300px stage is still at full sharpness.
const zoom = 1.7;
const focus = { x: 0.58, y: 0.47 };

// The headline: "Experimental" and a word that changes. The founding event
// was "a monthly experimental whatever event" (see About); the last word is the
// one shown when nothing moves. Edit the list to change the cycle.
const words = ["music", "sound", "performance", "people", "etc.", "whatever"];
const wordSeconds = 1.8;
const cycle = words.length * wordSeconds;

// How each word glitches in and out. Every word gets its own jolt (sideways,
// up/down, tilt) from these lists, used in turn, so no two entrances are alike.
const jolts = {
    x: ["0.06em", "-0.09em", "0.11em", "-0.05em", "0.08em", "-0.1em"],
    y: ["-0.03em", "0.04em", "0.02em", "-0.05em", "-0.02em", "0.04em"],
    r: ["-3deg", "2.5deg", "-1.5deg", "3.5deg", "-2deg", "1.5deg"],
};
const jolt = (list: string[], i: number) => list[i % list.length];

// One slot is a word's 1/N of the cycle. Keyframes are hard cuts (steps), as a
// signal breaking up: flicker and slice in, settle, a brief twitch mid-way, then
// slice and flicker out. The slices leave room (-0.3em) on the sides they do not
// cut, because the capitals are taller than the tight line box; settled is no clip.
// Colour fringes echo the photograph's blue and pink.
const slot = 100 / words.length;
const split = (e: number) =>
    `text-shadow: ${e}em 0 rgb(255 40 140 / 0.75), -${e}em 0 rgb(0 210 255 / 0.75)`;
const frames: [number, string][] = [
    [0, "opacity: 0"],
    [0.005, `opacity: 1; translate: var(--dx) var(--dy); rotate: var(--dr); clip-path: inset(-0.3em -0.3em 55% -0.3em); ${split(0.05)}`],
    [0.03, "opacity: 0"],
    [0.05, `opacity: 1; translate: calc(var(--dx) * -0.6) calc(var(--dy) * -1); rotate: calc(var(--dr) * -0.5); clip-path: inset(38% -0.3em -0.3em -0.3em); ${split(0.04)}`],
    [0.08, `translate: calc(var(--dx) * 0.3) 0; rotate: 0deg; clip-path: inset(-0.3em -0.3em 20% -0.3em); ${split(0.02)}`],
    [0.11, "translate: 0 0; rotate: 0deg; clip-path: none; text-shadow: none"],
    [0.5, `translate: calc(var(--dx) * 0.4) 0; ${split(0.03)}`],
    [0.52, "translate: 0 0; text-shadow: none"],
    [0.84, `translate: calc(var(--dx) * -1) calc(var(--dy) * 0.5); rotate: calc(var(--dr) * 0.7); clip-path: inset(20% -0.3em 40% -0.3em); ${split(0.05)}`],
    [0.88, "opacity: 0"],
    [0.91, `opacity: 1; translate: calc(var(--dx) * 0.5) 0; rotate: 0deg; clip-path: inset(55% -0.3em -0.3em -0.3em); ${split(0.03)}`],
    [0.95, "opacity: 0"],
];
const wordKeyframes = `@keyframes hero-word {
${frames
    .map(([at, css]) => `    ${(slot * at).toFixed(3)}% { ${css}; animation-timing-function: steps(1, end); }`)
    .join("\n")}
    ${slot.toFixed(3)}%, 100% { opacity: 0; }
}`;
---

<section id="top">
    <div class="relative grid grid-rows-[1fr_auto_1fr] justify-items-center self-stretch w-full -mt-3 -mb-4 overflow-hidden hero-stage">
        <!-- The picture and the glow share one box with the photograph's
             proportions, sized to cover the stage, so the glow stays on the sign
             whatever the stage's shape. -->
        <div
            class="hero-art"
            style={`--ratio:${ratio}; --zoom:${zoom}; --sign-x:${sign.x * 100}%; --sign-y:${sign.y * 100}%; --focus-x:${focus.x}; --focus-y:${focus.y};`}
            aria-hidden="true"
        >
            <Image
                src={background}
                alt=""
                widths={[1024, 1600, 2048]}
                sizes={`${Math.ceil(zoom * 100)}vw`}
                loading="eager"
                fetchpriority="high"
                class="block w-full h-full"
            />
            <div class="hero-glow"></div>
        </div>
        <h1 class="relative row-start-2 display-hero hero-title">
            <span class="block hero-lead">Experimental</span>
            <!-- The words are for the eye; the heading reads "Experimental etc." -->
            <span class="sr-only"> etc.</span>
            <span
                class="hero-words"
                aria-hidden="true"
                style={`--cycle:${cycle}s; --step:${wordSeconds}s;`}
            >
                {words.map((word, i) => (
                    <span
                        class="hero-word"
                        style={`--i:${i}; --dx:${jolt(jolts.x, i)}; --dy:${jolt(jolts.y, i)}; --dr:${jolt(jolts.r, i)};`}
                    >
                        {word}
                    </span>
                ))}
            </span>
        </h1>
        <!-- Rows are 1fr / text / 1fr, so the text stays centred and this sits
             halfway between the text and the bottom edge. -->
        <a href="/#events" target="_self" aria-label="Next section" class="relative self-center row-start-3 hero-next">
            <Icon name="ion:arrow-forward-sharp" class="icon hero-next-icon" />
        </a>
    </div>
</section>

<style set:html={wordKeyframes}></style>

<style>
    .hero-stage {
        container-type: size;
    }
    /* The box is the photograph at its zoom, positioned so the focus point is
       at the stage's centre, but never so far that an edge shows. */
    .hero-art {
        --w: calc(max(100cqw, 100cqh * var(--ratio)) * var(--zoom));
        --h: calc(var(--w) / var(--ratio));
        position: absolute;
        width: var(--w);
        height: var(--h);
        left: clamp(
            calc(100cqw - var(--w)),
            calc(50cqw - var(--focus-x) * var(--w)),
            0px
        );
        top: clamp(
            calc(100cqh - var(--h)),
            calc(50cqh - var(--focus-y) * var(--h)),
            0px
        );
        transform-origin: var(--sign-x) var(--sign-y);
    }
    /* A soft cyan light over the sign; screen blending only ever adds light. */
    .hero-glow {
        position: absolute;
        left: var(--sign-x);
        top: var(--sign-y);
        width: 36%;
        aspect-ratio: 1;
        translate: -50% -50%;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgb(110 220 255 / 0.75) 0%,
            rgb(50 150 255 / 0.42) 22%,
            rgb(40 110 255 / 0.16) 46%,
            transparent 70%
        );
        mix-blend-mode: screen;
        opacity: 0.85;
        pointer-events: none;
    }
    /* A strip down the middle of the stage (--strip wide), with the headline
       large enough to break inside it: "Experimental" over the changing word,
       each wrapping within the strip, lines butted by a cap-height line-height
       (BioRhyme Expanded's capitals are about 0.72em tall; lower --cap-lh to
       overlap them). Tune --strip, --size and --cap-lh. */
    .hero-title {
        --strip: 62cqw;
        --size: clamp(2.25rem, 7cqw, 6.5rem);
        --word-pull: 0.012em; /* moves the changing word up toward "Experimental" */
        --cap-lh: 0.57;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: var(--strip);
        text-align: center;
        overflow-wrap: anywhere;
        word-break: normal;
        font-size: var(--size);
        line-height: var(--cap-lh);
        padding-block: 1rem;
    }
    /* The words share one cell, so the line is as wide as the longest. Still, or
       with reduced motion, only the last shows. */
    .hero-words {
        display: inline-grid;
        margin-top: calc(var(--word-pull) * -1);
        width: 100%;
        text-align: center;
    }
    .hero-word {
        grid-area: 1 / 1;
        min-width: 0;
        opacity: 0;
    }
    .hero-word:last-child {
        opacity: 1;
    }
    .hero-next-icon {
        width: 2.5rem;
        height: 2.5rem;
        filter: drop-shadow(0 0 0.4rem rgb(0 0 0 / 0.7));
    }
    @media (prefers-reduced-motion: no-preference) {
        /* "Experimental" sways very slowly, the calm against the glitching word.
           Movement only, no change of size or spacing, so it never reflows. */
        .hero-lead {
            animation: hero-sway 18s ease-in-out infinite alternate;
        }
        .hero-word {
            animation: hero-word var(--cycle) linear infinite both;
            animation-delay: calc(var(--i) * var(--step));
        }
        /* A very slow push-in towards the sign and back. */
        .hero-art {
            animation:
                hero-drift 40s ease-in-out infinite alternate,
                hero-parallax 10s ease-in-out infinite;
            will-change: transform;
        }
        /* The light swells and fades, and its tube flickers faintly once a cycle. */
        .hero-glow {
            animation:
                hero-neon 9s ease-in-out infinite,
                hero-swell 6s ease-in-out infinite;
        }
    }
    @keyframes hero-sway {
        from {
            translate: -0.07em 0;
            rotate: -1.2deg;
        }
        to {
            translate: 0.07em 0;
            rotate: 1.2deg;
        }
    }
    /* The picture shifts a little, quickly and unevenly: a short, restless
       movement (about 0.12% of its width) behind the words. It is zoomed in, so
       there is room at its edges. */
    @keyframes hero-parallax {
        0%,
        100% {
            translate: 0.12% 0.035%;
        }
        22% {
            translate: -0.07% -0.023%;
        }
        41% {
            translate: 0.035% 0.046%;
        }
        63% {
            translate: -0.12% -0.035%;
        }
        80% {
            translate: 0.07% 0;
        }
    }
    @keyframes hero-drift {
        to {
            transform: scale(1.07);
        }
    }
    @keyframes hero-swell {
        50% {
            scale: 1.12;
        }
    }
    @keyframes hero-neon {
        0%,
        100% {
            opacity: 0.7;
        }
        45% {
            opacity: 1;
        }
        70% {
            opacity: 1;
        }
        71% {
            opacity: 0.88;
        }
        72% {
            opacity: 1;
        }
        73% {
            opacity: 0.92;
        }
        75% {
            opacity: 1;
        }
    }
</style>
