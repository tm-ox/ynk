---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

// The pictures: documentation photographs from the events (never flyers), one
// per event (its first that qualifies), landscape and wide enough to fill the
// stage sharply. If fewer than `enough` events have one at the preferred width,
// the fallback width is used. The pick is spread across the years: newest year
// first, one event from each year in turn, newest event first within a year,
// up to `most`. The script below keeps the first in place (it is the eager
// one) and shuffles the rest on every visit.
const pick = { preferred: 1600, fallback: 1200, enough: 6, most: 10 };

type Candidate = { src: ImageMetadata; date: string };
const events = await getCollection("events");
const candidates = (minWidth: number): Candidate[] =>
    events.flatMap((event) => {
        const photo = (event.data.images ?? []).find(
            (img) => img?.src && img.src.width > img.src.height && img.src.width >= minWidth,
        );
        return photo?.src ? [{ src: photo.src, date: event.data.date }] : [];
    });
let pool = candidates(pick.preferred);
if (pool.length < pick.enough) pool = candidates(pick.fallback);
const byYear = new Map<string, Candidate[]>();
for (const c of [...pool].sort((a, b) => b.date.localeCompare(a.date))) {
    const year = c.date.slice(0, 4);
    byYear.set(year, [...(byYear.get(year) ?? []), c]);
}
const years = [...byYear.values()];
const photos: ImageMetadata[] = [];
for (let round = 0; photos.length < pick.most && years.some((y) => y.length > round); round++) {
    for (const year of years) {
        if (year[round] && photos.length < pick.most) photos.push(year[round].src);
    }
}
if (photos.length < 2) throw new Error("Hero.astro: the sweep needs at least two event photographs.");
// Responsive widths up to the photograph's own (capped), for sizes="100vw".
const widthsFor = (w: number) => [640, 960, 1280, 1600, 1920].filter((x) => x < w).concat(Math.min(w, 2400));

// The headline: "Experimental" and a word that changes. The founding event
// was "a monthly experimental whatever event" (see About); the last word is the
// one shown when nothing moves, and the cycle starts from the first. Edit the
// list to change the cycle (two words at least).
const words = ["music", "sound", "performance", "people", "etc.", "whatever"];
if (words.length < 2) throw new Error("Hero.astro: the cycling headline needs at least two words.");
const still = words[words.length - 1];

// The tempo: seconds a picture rests before the next sweep, on a wide stage
// and on a narrow (under 48rem) or portrait one, where there is more to take
// in per picture. The sweep itself takes --seam-duration (global.css).
const dwell = { wide: 5, narrow: 7 };
// The pointer parallax (fine pointers only): the most the pictures move
// against the pointer, in px, and how much of the remaining distance they cover
// per frame (lower is softer). `overscan` scales the pictures up so the shift
// never shows an edge; the script clamps the shift to what it leaves.
const parallax = { shift: 10, ease: 0.06, overscan: 1.02 };
---

<section id="top">
    <div
        class="relative grid grid-cols-[minmax(0,1fr)] grid-rows-[1fr_auto_1fr] justify-items-center self-stretch w-full -mt-2 -mb-4 overflow-hidden hero-stage"
        style={`--overscan:${parallax.overscan};`}
        data-dwell-wide={dwell.wide}
        data-dwell-narrow={dwell.narrow}
        data-shift={parallax.shift}
        data-ease={parallax.ease}
        data-overscan={parallax.overscan}
    >
        <!-- Two of these show at once: the current picture and, above it, the
             next, masked to the right of the seam. The rest wait (display:none)
             until their turn. The scrim sits over both. -->
        <div class="hero-pics" aria-hidden="true">
            {photos.map((src, i) => (
                <div class="hero-pic" data-role={i === 0 ? "current" : i === 1 ? "next" : undefined}>
                    <Image
                        src={src}
                        alt=""
                        widths={widthsFor(src.width)}
                        sizes="100vw"
                        loading={i === 0 ? "eager" : "lazy"}
                        fetchpriority={i === 0 ? "high" : undefined}
                    />
                </div>
            ))}
            <div class="hero-scrim"></div>
        </div>
        <!-- The line that rides the seam, between two strips of page background,
             as in the page turn. Below the headline: where the seam cuts the
             word, the gap between the two words shows it. -->
        <div class="hero-seam" aria-hidden="true"></div>
        <!-- The two bars of the logo's equals sign, full width, with the
             headline between them. -->
        <div class="relative row-start-2 hero-head">
            <h1 class="display-hero hero-title">
                <span class="block">Experimental</span>
                <!-- The words are for the eye; the heading reads "Experimental etc." -->
                <span class="sr-only"> etc.</span>
                <span class="hero-words" aria-hidden="true" data-words={JSON.stringify(words)}>
                    <!-- Every word, unseen, so the cell is as big as the biggest
                         and nothing reflows as the words change. -->
                    {words.map((word) => <span class="hero-sizer">{word}</span>)}
                    <span class="hero-word" data-word="out">{still}</span>
                    <span class="hero-word" data-word="in">{words[0]}</span>
                </span>
            </h1>
        </div>
        <!-- Out of the grid flow altogether (absolute), vertically centred on the
             stage at its right edge, so it cannot move the headline. Size and
             inset: see .hero-next in the styles. -->
        <a href="/featured/" target="_self" aria-label="Next section" class="absolute hero-next">
            <Icon name="ion:arrow-forward-sharp" class="icon hero-next-icon" />
        </a>
    </div>
</section>

<script>
    // The sweep: every dwell, once the next picture is decoded, the seam
    // crosses the stage right to left (the .is-sweeping animation in the
    // styles), the next picture and word behind it. When it is across, the
    // roles move on in the same frame: the next picture becomes the current
    // one, the incoming word the outgoing one, and the masks reset offstage.
    // It waits while the tab is hidden and while a page turn is being prepared.
    let teardown: (() => void) | undefined;

    const shuffle = <T,>(list: T[]) => {
        for (let i = list.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [list[i], list[j]] = [list[j], list[i]];
        }
        return list;
    };

    function init() {
        const stage = document.querySelector<HTMLElement>(".hero-stage");
        if (!stage) return;
        const ctrl = new AbortController();
        const { signal } = ctrl;
        const timers = new Set<number>();
        let frame = 0;
        teardown = () => {
            ctrl.abort();
            timers.forEach(clearTimeout);
            cancelAnimationFrame(frame);
            teardown = undefined;
        };
        const still = matchMedia("(prefers-reduced-motion: reduce)");
        still.addEventListener(
            "change",
            () => {
                teardown?.();
                init();
            },
            { signal },
        );

        const pics = [...stage.querySelectorAll<HTMLElement>(".hero-pic")];
        const cell = stage.querySelector<HTMLElement>(".hero-words")!;
        const out = cell.querySelector<HTMLElement>('[data-word="out"]')!;
        const inc = cell.querySelector<HTMLElement>('[data-word="in"]')!;
        const seam = stage.querySelector<HTMLElement>(".hero-seam")!;
        const words: string[] = JSON.parse(cell.dataset.words ?? "[]");

        // Back to the server's state (a restart can come mid-cycle), then the
        // order for this visit: the first stays, the rest shuffled.
        const order = [0, ...shuffle(pics.slice(1).map((_, i) => i + 1))];
        let at = 0;
        const setRoles = () => {
            pics.forEach((pic) => delete pic.dataset.role);
            pics[order[at]].dataset.role = "current";
            const next = pics[order[(at + 1) % order.length]];
            next.dataset.role = "next";
            next.querySelector("img")!.loading = "eager";
        };
        stage.classList.remove("is-sweeping");
        setRoles();
        let word = 0;
        out.textContent = words[words.length - 1];
        inc.textContent = words[word];
        if (still.matches) return;

        // The word's masks are its own box's size, so its edge is the stage's
        // seam shifted by where the box sits: the seam leans (tan 32deg, about
        // 0.625 sideways per unit down), so it crosses the box's mid-height
        // left of the stage's centre line by 0.625 times the box's drop below
        // the stage's centre (as Base.astro's page turn shifts do).
        const measure = () => {
            const s = stage.getBoundingClientRect();
            const w = out.getBoundingClientRect();
            const dx = w.left + w.width / 2 - (s.left + s.width / 2);
            const dy = w.top + w.height / 2 - (s.top + s.height / 2);
            stage.style.setProperty("--word-shift", `${-(dx + 0.625 * dy)}px`);
        };
        const sizes = new ResizeObserver(measure);
        sizes.observe(stage);
        sizes.observe(cell);
        signal.addEventListener("abort", () => sizes.disconnect());
        document.fonts?.ready.then(() => signal.aborted || measure());

        // Paused while hidden or while a page turn is under way; every change
        // of state re-arms whatever is waiting.
        let turning = false;
        const waiting = new Set<() => void>();
        const changed = () => waiting.forEach((arm) => arm());
        const running = () => !document.hidden && !turning;
        document.addEventListener("visibilitychange", changed, { signal });
        document.addEventListener("astro:before-preparation", () => ((turning = true), changed()), { signal });
        document.addEventListener("astro:after-swap", () => ((turning = false), changed()), { signal });
        // Resolves after ms of running time, counted afresh whenever a pause
        // ends (so a tab brought back rests a whole dwell first). rest(0)
        // just waits until running.
        const rest = (ms: number) =>
            new Promise<void>((resolve) => {
                let timer = 0;
                const arm = () => {
                    clearTimeout(timer);
                    timers.delete(timer);
                    if (!running()) return;
                    timer = window.setTimeout(() => {
                        waiting.delete(arm);
                        timers.delete(timer);
                        resolve();
                    }, ms);
                    timers.add(timer);
                };
                waiting.add(arm);
                arm();
            });
        const dwell = () => {
            const narrow = stage.clientWidth < 768 || stage.clientHeight > stage.clientWidth;
            return Number(narrow ? stage.dataset.dwellNarrow : stage.dataset.dwellWide) * 1000;
        };
        // One crossing; the seam's own animation ends it (the pictures' and
        // words' run alongside on the same clock).
        const sweep = () =>
            new Promise<void>((resolve) => {
                const done = (e: AnimationEvent) => {
                    if (e.target !== seam) return;
                    seam.removeEventListener("animationend", done);
                    at = (at + 1) % order.length;
                    setRoles();
                    word = (word + 1) % words.length;
                    out.textContent = inc.textContent;
                    inc.textContent = words[word];
                    stage.classList.remove("is-sweeping");
                    resolve();
                };
                seam.addEventListener("animationend", done, { signal });
                stage.classList.add("is-sweeping");
            });
        (async () => {
            while (!signal.aborted) {
                await rest(dwell());
                // The next picture must be ready, or the seam would uncover a
                // blank; one that fails to load drops out of the order.
                const slot = (at + 1) % order.length;
                try {
                    await pics[order[slot]].querySelector("img")!.decode();
                } catch {
                    if (signal.aborted) return;
                    if (order.length > 2) {
                        order.splice(slot, 1);
                        if (at >= order.length) at = 0;
                        setRoles();
                    }
                    continue;
                }
                await rest(0);
                if (signal.aborted) return;
                await sweep();
            }
        })();

        // The parallax: the pictures move against the pointer's offset from
        // the stage's centre, eased toward it frame by frame, never further
        // than the overscan leaves.
        if (matchMedia("(pointer: fine)").matches) {
            const most = Number(stage.dataset.shift);
            const ease = Number(stage.dataset.ease);
            const spare = (Number(stage.dataset.overscan) - 1) / 2;
            const target = { x: 0, y: 0 };
            const now = { x: 0, y: 0 };
            const step = () => {
                now.x += (target.x - now.x) * ease;
                now.y += (target.y - now.y) * ease;
                stage.style.setProperty("--px", `${now.x.toFixed(2)}px`);
                stage.style.setProperty("--py", `${now.y.toFixed(2)}px`);
                const far = Math.abs(target.x - now.x) + Math.abs(target.y - now.y) > 0.05;
                frame = far ? requestAnimationFrame(step) : 0;
            };
            const toward = (offset: number, half: number) => Math.max(-1, Math.min(1, offset / half));
            window.addEventListener(
                "pointermove",
                (e) => {
                    const s = stage.getBoundingClientRect();
                    const room = {
                        x: Math.max(0, Math.min(most, s.width * spare - 1)),
                        y: Math.max(0, Math.min(most, s.height * spare - 1)),
                    };
                    target.x = -toward(e.clientX - (s.left + s.width / 2), s.width / 2) * room.x;
                    target.y = -toward(e.clientY - (s.top + s.height / 2), s.height / 2) * room.y;
                    if (!frame) frame = requestAnimationFrame(step);
                },
                { signal, passive: true },
            );
        }
    }

    document.addEventListener("astro:page-load", () => {
        teardown?.();
        init();
    });
    document.addEventListener("astro:before-swap", () => teardown?.());
</script>

<style>
    .hero-stage {
        container-type: size;
    }
    /* The seam, as in the page turn (global.css): --seam is its distance right
       of the stage's centre at mid-height, and each masked box's --edge is that
       distance from its own centre, its masks gradients its own size at
       --wipe-angle (so the stop moves by --edge * 0.848). At rest the seam
       waits just past the right edge, by --sweep-overhang (the lean over half
       the stage's height, and enough for the band), so nothing is masked; a
       sweep takes it to just past the left edge over --seam-duration with
       --page-seam-easing, the page turn's tempo. */
    .hero-pic,
    .hero-seam,
    .hero-word {
        --sweep-overhang: calc(50cqh * 0.625 + 8px);
        --seam: calc(50cqw + var(--sweep-overhang));
        --edge: var(--seam);
    }
    .hero-stage.is-sweeping :is(.hero-pic, .hero-seam, .hero-word) {
        animation: hero-sweep var(--seam-duration) var(--page-seam-easing) both;
    }
    @keyframes hero-sweep {
        to {
            --seam: calc(-50cqw - var(--sweep-overhang));
        }
    }
    .hero-pics {
        position: absolute;
        inset: 0;
        isolation: isolate;
    }
    .hero-pic {
        display: none;
        position: absolute;
        inset: 0;
        overflow: hidden;
    }
    .hero-pic[data-role] {
        display: block;
    }
    /* The pictures are scaled up by --overscan and shifted by the parallax
       (--px, --py, set by the script), inside boxes that stay put, so the
       seam's masks never move with them. */
    .hero-pic > :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        scale: var(--overscan);
        translate: var(--px, 0px) var(--py, 0px);
    }
    /* The incoming picture shows only right of the seam, past the band, as the
       page turn's incoming page does. */
    .hero-pic[data-role="next"] {
        z-index: 1;
        mask-image: linear-gradient(
            var(--wipe-angle),
            transparent calc(50% + var(--edge) * 0.848 + var(--page-band)),
            #000 calc(50% + var(--edge) * 0.848 + var(--page-band))
        );
        mask-size: 100% 100%;
        mask-repeat: no-repeat;
    }
    /* A wash of the page background over the pictures, so the headline reads
       over any photograph (darkening in the dark theme; in the light one,
       where the headline is dark, it lightens). Tune --scrim. */
    .hero-scrim {
        --scrim: 0.4;
        position: absolute;
        inset: 0;
        z-index: 2;
        background: rgb(var(--rgb-bg) / var(--scrim));
    }
    /* The page turn's band: the line between two strips of page background,
       just behind the edge. */
    .hero-seam {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(
            var(--wipe-angle),
            transparent calc(50% + var(--edge) * 0.848),
            var(--color-bg) calc(50% + var(--edge) * 0.848),
            var(--color-bg) calc(50% + var(--edge) * 0.848 + var(--page-halo)),
            var(--color-border) calc(50% + var(--edge) * 0.848 + var(--page-halo)),
            var(--color-border) calc(50% + var(--edge) * 0.848 + var(--page-halo) + var(--wipe-line)),
            var(--color-bg) calc(50% + var(--edge) * 0.848 + var(--page-halo) + var(--wipe-line)),
            var(--color-bg) calc(50% + var(--edge) * 0.848 + var(--page-band)),
            transparent calc(50% + var(--edge) * 0.848 + var(--page-band))
        );
    }
    /* The bars: 1px rules in the border colour, as the frame's rules, across
       the whole stage, --rule-gap clear of the headline. */
    .hero-head {
        --rule-gap: clamp(0.75rem, 2.5cqh, 2rem);
        justify-self: stretch;
        display: flex;
        justify-content: center;
        border-block: 1px solid var(--color-border);
        padding-block: var(--rule-gap);
    }
    /* A strip down the middle of the stage (--strip wide), with the headline
       large enough to break inside it: "Experimental" over the changing word,
       each wrapping within the strip. BioRhyme Expanded's capitals are about
       0.72em tall, so a line-height of 0.72 would just touch; --cap-lh is tuned
       lower so the lines overlap. This overrides the --text-hero tokens in
       global.css, which now serve only the 404 page's .display-hero. The
       padding makes up the capitals' overhang of the tight line box, so the
       rules' gap is measured from the letters. Tune --strip, --size and
       --cap-lh. */
    .hero-title {
        --strip: 62cqw;
        --size: clamp(2.25rem, 7cqw, 6.5rem);
        --word-pull: 0.012em; /* moves the changing word up toward "Experimental" */
        --cap-lh: 0.57;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: var(--strip);
        margin: 0;
        text-align: center;
        overflow-wrap: anywhere;
        word-break: normal;
        font-size: var(--size);
        line-height: var(--cap-lh);
        padding-block: 0.1em;
    }
    /* The words share one cell, so the line is as wide and tall as the
       biggest (the unseen sizers); the outgoing and incoming words lie on top
       of each other. */
    .hero-words {
        display: inline-grid;
        margin-top: calc(var(--word-pull) * -1);
        width: 100%;
        text-align: center;
    }
    .hero-sizer,
    .hero-word {
        grid-area: 1 / 1;
        min-width: 0;
    }
    .hero-sizer {
        visibility: hidden;
    }
    /* Each word is masked by the seam, its edge shifted to where its box sits
       (--word-shift, from the script): the outgoing word left of the edge, the
       incoming one right of it past the band, so the seam cuts one into the
       other. The boxes reach --word-bleed past the cell (the margins give it
       back), since a mask clips everything outside its box and the capitals
       overhang the tight line box. */
    .hero-word {
        --word-bleed: 0.3em;
        --edge: calc(var(--seam) + var(--word-shift, 0px));
        padding: var(--word-bleed);
        margin: calc(var(--word-bleed) * -1);
        mask-size: 100% 100%;
        mask-repeat: no-repeat;
    }
    .hero-word[data-word="out"] {
        mask-image: linear-gradient(
            var(--wipe-angle),
            #000 calc(50% + var(--edge) * 0.848),
            transparent calc(50% + var(--edge) * 0.848)
        );
    }
    .hero-word[data-word="in"] {
        mask-image: linear-gradient(
            var(--wipe-angle),
            transparent calc(50% + var(--edge) * 0.848 + var(--page-band)),
            #000 calc(50% + var(--edge) * 0.848 + var(--page-band))
        );
    }
    /* Reduced motion: no cycle, a still split frame. The seam stands through
       the stage's centre between two pictures; the word stays the last one
       (its own seam stays offstage). */
    @media (prefers-reduced-motion: reduce) {
        .hero-pic,
        .hero-seam {
            --seam: 0px;
        }
    }
    .hero-next {
        --next-size: clamp(3.5rem, 9cqw, 8rem);
        /* Raise --next-inset to bring the arrow back in from the edge. */
        --next-inset: 0px;
        right: var(--next-inset);
        top: 50%;
        translate: 0 -50%;
    }
    .hero-next:focus-visible {
        outline-offset: -2px;
    }
    .hero-next-icon {
        width: var(--next-size);
        height: var(--next-size);
        /* Pulled out by the empty 13% beside the tip, so the tip meets the edge
           while the link's own box (and its focus ring) stays inside the stage. */
        margin-right: calc(var(--next-size) * -0.13);
        filter: drop-shadow(0 0 0.4rem rgb(0 0 0 / 0.7));
    }
</style>
