---
// Top row of a screen (Featured, About, Contact): the section's label at the
// left and, optionally, its actions (slot) at the right. At every size it is
// the archives' bar row (--bar-row high, text centred, .bar-label), so every
// screen's title sits at the same height.
interface Props {
    label: string;
}
const { label } = Astro.props;
---

<div class="flex items-center justify-between w-full gap-4 h-(--bar-row)">
    <h2 class="bar-label">
        {label}
    </h2>
    <div class="flex gap-6 leading-none"><slot /></div>
</div>
