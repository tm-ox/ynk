---
import * as about from "../../content/about/about.md";
import SectionBar from "./SectionBar.astro";
import { Content } from "../../content/about/about.md";
---

<section id="about" class="flex-col items-stretch">
    <SectionBar label={about.frontmatter.title} />
    <div class="grid grid-cols-1 my-auto text-left lg:gap-6 lg:grid-cols-3">
        <h3
            class="mt-bar-gap mb-4 lg:mt-1 lg:mb-0 text-sm sm:text-2xl lg:text-right lg:self-center col-span-full lg:col-span-1"
        >
            {about.frontmatter.description}
        </h3>
        <div class="col-span-full lg:col-span-2">
            <div class="grid sm:gap-6 sm:grid-cols-2">
                <Content />
            </div>
        </div>
    </div>
</section>
