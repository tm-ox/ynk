<div class="z-(--z-overlay) ml-auto mr-1 cursor-pointer hamburger sm:hidden sm:ml-0">
    <span class="mb-[7px] line"></span>
    <span class="line"></span>
</div>

<style>
    @reference "../styles/global.css";
    .hamburger .line {
        @apply block w-8 h-[5px] bg-accent transition;
    }
    .hamburger:hover .line {
        @apply bg-accent-hover;
    }
</style>

<script is:inline>
    document.addEventListener("astro:page-load", () => {
        document.querySelector(".hamburger").addEventListener("click", () => {
            document.querySelector(".main-nav").classList.toggle("expanded");
        });
    });
</script>
