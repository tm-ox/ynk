<button
    type="button"
    class="z-(--z-overlay) ml-auto cursor-pointer hamburger py-3.5 -my-3.5 sm:hidden sm:ml-0"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="main-nav"
>
    <span class="mb-[7px] line"></span>
    <span class="line"></span>
</button>

<style>
    @reference "../styles/global.css";
    .hamburger .line {
        @apply block w-8 h-[5px] bg-accent-muted transition;
    }
    .hamburger:hover .line {
        @apply bg-accent;
    }
    /* Open (the script sets aria-expanded): the two bars cross into an X. Each
       moves half the distance between their centres (5px bar + 7px gap = 12px,
       so 6px) to meet in the middle, then turns 45 degrees. */
    .hamburger[aria-expanded="true"] .line {
        @apply bg-accent;
    }
    .hamburger[aria-expanded="true"] .line:first-child {
        translate: 0 6px;
        rotate: 45deg;
    }
    .hamburger[aria-expanded="true"] .line:last-child {
        translate: 0 -6px;
        rotate: -45deg;
    }
</style>

<script>
    import { sweep } from "../scripts/sweep";

    // The phone menu (#main-nav, BaseLayout.astro) opens and closes like a
    // page turn (scripts/sweep.ts), clipped to its panel. The router swaps the
    // nav with every page but this module runs once, so it is bound once and
    // everything is looked up when the event happens.
    const panel = () => document.querySelector<HTMLElement>("#main-nav");
    const button = () => document.querySelector<HTMLButtonElement>(".hamburger");
    // While the menu is open the page under it is out of reach (inert): no
    // tabbing or reading into it. (The page's scroll is locked in the styles,
    // BaseLayout.astro.)
    const page = (inert: boolean) => {
        const main = document.querySelector<HTMLElement>("main");
        if (main) main.inert = inert;
    };
    const isOpen = (p: HTMLElement) => p.classList.contains("expanded") && !p.hasAttribute("data-closing");

    const turn = (p: HTMLElement, show: boolean) =>
        sweep(p, p.querySelector("ul")!, p.querySelector<HTMLElement>("[data-menu-seam]")!, show, {
            duration: "--menu-sweep",
            fade: "--menu-fade",
        });

    // Closed at once, nothing of a sweep left: on navigation (before the old
    // page is captured, so a page turn never carries the menu), at the end of
    // a close, and when the screen grows past the phone layout.
    function reset(p: HTMLElement) {
        p.getAnimations({ subtree: true }).forEach((a) => a.cancel());
        p.classList.remove("expanded");
        p.removeAttribute("data-closing");
        p.querySelector<HTMLElement>("[data-menu-seam]")!.hidden = true;
        button()?.setAttribute("aria-expanded", "false");
        page(false);
    }

    // A close still turning is cut short where it is.
    function open(p: HTMLElement) {
        p.getAnimations({ subtree: true }).forEach((a) => a.cancel());
        p.removeAttribute("data-closing");
        p.classList.add("expanded");
        button()?.setAttribute("aria-expanded", "true");
        page(true);
        turn(p, true).catch(() => {});
    }

    // The button and Esc: the panel turns away, then it is hidden.
    // data-closing keeps a second tap from starting it again; one still
    // opening is finished first. Focus left inside goes back to the button.
    // The page is in reach again as the panel starts to turn away.
    function shut(p: HTMLElement) {
        if (!isOpen(p)) return;
        p.getAnimations({ subtree: true }).forEach((a) => a.finish());
        p.setAttribute("data-closing", "");
        button()?.setAttribute("aria-expanded", "false");
        page(false);
        if (p.contains(document.activeElement)) button()?.focus();
        turn(p, false).then(
            () => reset(p),
            () => {},
        );
    }

    document.addEventListener("click", (e) => {
        const p = panel();
        if (!p) return;
        const target = e.target as Element;
        if (target.closest(".hamburger")) {
            if (isOpen(p)) shut(p);
            else open(p);
        } else if (target.closest('.main-nav a[target="_blank"]')) {
            // The social links leave the page open behind a new tab; the
            // others navigate, which closes it below.
            shut(p);
        }
    });

    // Ahead of the page's own keys (scripts/keys.ts, where Esc goes back), and
    // not while Settings is open over it (Esc is its own then).
    document.addEventListener(
        "keydown",
        (e) => {
            const p = panel();
            if (e.key !== "Escape" || !p || !isOpen(p) || document.querySelector("dialog[open]")) return;
            e.preventDefault();
            shut(p);
        },
        true,
    );

    const closeNow = () => {
        const p = panel();
        if (p) reset(p);
    };
    document.addEventListener("astro:before-preparation", closeNow);
    document.addEventListener("astro:page-load", closeNow);
    matchMedia("(min-width: 40rem)").addEventListener("change", closeNow);
</script>
