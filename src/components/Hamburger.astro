<button
    type="button"
    class="z-(--z-overlay) ml-auto mr-1 cursor-pointer hamburger sm:hidden sm:ml-0"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="main-nav"
>
    <span class="mb-[7px] line"></span>
    <span class="line"></span>
</button>

<style>
    @reference "../styles/global.css";
    .hamburger .line {
        @apply block w-8 h-[5px] bg-accent-muted transition;
    }
    .hamburger:hover .line {
        @apply bg-accent;
    }
</style>

<script is:inline>
    // The nav is persisted across page transitions, so bind once and
    // close the menu whenever a new page loads.
    if (!window.__menuBound) {
        window.__menuBound = true;
        const setOpen = (open) => {
            document.querySelector(".main-nav")?.classList.toggle("expanded", open);
            document
                .querySelector(".hamburger")
                ?.setAttribute("aria-expanded", String(open));
        };
        document.addEventListener("click", (e) => {
            if (e.target.closest(".hamburger")) {
                const open = document
                    .querySelector(".main-nav")
                    .classList.contains("expanded");
                setOpen(!open);
            }
        });
        document.addEventListener("astro:page-load", () => setOpen(false));
    }
</script>
