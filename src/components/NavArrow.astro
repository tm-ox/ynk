---
import { Icon } from "astro-icon/components";

export interface Props {
  href?: string;
  direction: "back" | "forward";
  class?: string;
}

const { href, direction, class: className = "icon" } = Astro.props;
const name = `ion:arrow-${direction}-sharp`;
const label = direction === "back" ? "Previous" : "Next";
---

{/* Prefetched once the page has loaded, so paging is ready when the visitor
    gets there. Hover alone would leave the wipe waiting on the network. */}
{
  href ? (
    <a href={href} aria-label={label} data-astro-prefetch="load" rel={direction === "back" ? "prev" : "next"}>
      <Icon name={name} class={className} />
    </a>
  ) : (
    <span aria-disabled="true" class="opacity-30 pointer-events-none">
      <Icon name={name} class={className} />
    </span>
  )
}
