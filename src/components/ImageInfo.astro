---
import { groupSlug, type GalleryImage } from "../utils/events";
import Paging from "./Paging.astro";

interface Props {
    image: GalleryImage;
    /** "3 of 14" for a photograph, "Flyer" for a flyer. */
    position?: string;
    /** The neighbouring pictures' pages, for the arrows at the strip's end. */
    prev?: string;
    next?: string;
}
const { image, position, prev, next } = Astro.props;
const { event } = image;
---

<!-- Info strip for a single picture. It takes the place of the gallery filter
     (same transition name, so the bar stays put between the archive and a
     picture) and is the page's h1. From sm up its row is exactly the filter's
     (--bar-row high, text centred) so the picture below does not move when one becomes
     the other; keep the two in step. Credits for who is in the photograph can
     join it later. -->
<div class="w-full image-info" transition:name="gallery-bar">
    <div class="flex flex-wrap items-baseline w-full gap-x-6 text-xs uppercase font-displayCon md:text-sm max-sm:py-2 max-sm:text-base sm:flex-nowrap sm:items-center sm:h-(--bar-row) sm:leading-none">
        <h1 class="min-w-0 m-0 text-xs font-bold leading-[inherit] truncate md:text-sm max-sm:text-base text-accent">
            <a href={`/events/${event.id}/`} title={event.title} class="hover:text-accent-hover">{event.title}</a>
        </h1>
        <span class="text-accent-muted shrink-0">{event.date}</span>
        {
            event.venue?.name && (
                <span class="min-w-0 truncate text-accent-muted">
                    {event.venue.url ? (
                        <a href={event.venue.url} title={event.venue.name} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
                            {event.venue.name}
                        </a>
                    ) : (
                        event.venue.name
                    )}
                </span>
            )
        }
        <span class="flex items-baseline gap-6 ml-auto shrink-0">
            {position && <span class="text-accent-muted">{position}</span>}
            <a href={`/images/event/${groupSlug(event.title)}/`} class="section-action">Event images</a>
        </span>
        <Paging prev={prev} next={next} close={{ href: "/images/", title: "All images" }} iconClass="icon h-6 w-6" />
    </div>
</div>

<style>
    /* The title and venue truncate (overflow hidden), which would clip the usual
       outside focus ring, so it is drawn inside. */
    .image-info a:focus-visible {
        outline-offset: -2px;
    }
</style>
