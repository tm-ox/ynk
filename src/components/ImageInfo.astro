---
import { groupSlug, prettyDate, type GalleryImage } from "../utils/events";

interface Props {
    image: GalleryImage;
    /** "3 of 14" for a photograph, "Flyer" for a flyer. */
    position?: string;
}
const { image, position } = Astro.props;
const { event } = image;
---

<!-- Info strip for a single picture. It takes the place of the gallery filter
     (same transition name, so the bar stays put between the archive and a
     picture) and is the page's h1. From sm up its row is exactly the filter's
     (h-5, text lifted 3px) so the rule below does not move when one becomes
     the other; keep the two in step. Credits for who is in the photograph can
     join it later. -->
<div class="w-full image-info" transition:name="gallery-bar">
    <div class="flex flex-wrap items-baseline w-full gap-x-6 text-xs uppercase font-displayCon md:text-sm max-sm:py-2 max-sm:text-base sm:flex-nowrap sm:h-5 sm:leading-5 sm:-translate-y-0.75">
        <h1 class="min-w-0 m-0 text-xs font-bold leading-[inherit] truncate md:text-sm max-sm:text-base text-accent">
            <a href={`/events/${event.id}/`} class="hover:text-accent-hover">{event.title}</a>
        </h1>
        <span class="text-accent-muted shrink-0">{prettyDate(event.date)}</span>
        {
            event.venue?.name && (
                <span class="min-w-0 truncate text-accent-muted">
                    {event.venue.url ? (
                        <a href={event.venue.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
                            {event.venue.name}
                        </a>
                    ) : (
                        event.venue.name
                    )}
                </span>
            )
        }
        <span class="flex items-baseline gap-6 ml-auto shrink-0">
            {position && <span class="text-accent-muted">{position}</span>}
            <a href={`/images/event/${groupSlug(event.title)}/`} class="section-action">Event images</a>
        </span>
    </div>
    <hr class="mb-0" />
</div>
