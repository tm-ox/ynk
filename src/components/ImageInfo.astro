---
import { groupSlug, type GalleryImage } from "../utils/events";
import Paging from "./Paging.astro";

interface Props {
    image: GalleryImage;
    /** "3 of 14" for a photograph, "Flyer" for a flyer. */
    position?: string;
    /** The neighbouring pictures' pages, for the arrows at the strip's end. */
    prev?: string;
    next?: string;
}
const { image, position, prev, next } = Astro.props;
const { event } = image;
// A venue written "Place - Venue" is two lines on phones (the " - " drops out),
// one line with the dash from sm up.
const venueParts = event.venue?.name?.split(" - ") ?? [];
---

<!-- Info strip for a single picture. It takes the place of the gallery filter
     (same transition name, so the bar stays put between the archive and a
     picture) and is the page's h1. From sm up its row is exactly the filter's
     (--bar-row high, text centred) so the picture below does not move when one becomes
     the other; keep the two in step. On phones it wraps in rows --bar-row
     apart: the title and the arrows first, as on the bars, then the rest.
     Below lg it holds under the header rule should the page scroll
     (detail-sticky, global.css). The photographer's credit is here from md up;
     below it the position and the Event images link, and the credit, are
     round the picture instead (images/[slug].astro). -->
<div class="w-full image-info max-lg:detail-sticky" transition:name="gallery-bar">
    <div class="flex flex-wrap items-center w-full gap-x-6 text-xs uppercase font-displayCon md:text-sm max-sm:leading-(--bar-row) max-sm:text-base sm:flex-nowrap sm:h-(--bar-row) sm:leading-none">
        <h1 class="min-w-0 m-0 text-xs font-bold leading-[inherit] truncate md:text-sm max-sm:text-base max-sm:leading-(--bar-top) max-sm:flex-1 text-accent">
            <a href={`/events/${event.id}/`} title={event.title} class="hover:text-accent-hover">{event.title}</a>
        </h1>
        <span class="text-accent-muted shrink-0 max-sm:order-3">{event.date}</span>
        {
            event.venue?.name && (
                <span class="min-w-0 truncate text-accent-muted max-sm:order-3 max-sm:basis-full max-sm:overflow-visible max-sm:whitespace-normal max-sm:leading-tight max-sm:py-1">
                    {event.venue.url ? (
                        <a href={event.venue.url} title={event.venue.name} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
                            {venueParts.map((part, i) => (<>{i > 0 && (<><span class="max-sm:hidden"> - </span><br class="sm:hidden" /></>)}{part}</>))}
                        </a>
                    ) : (
                        venueParts.map((part, i) => (<>{i > 0 && (<><span class="max-sm:hidden"> - </span><br class="sm:hidden" /></>)}{part}</>))
                    )}
                </span>
            )
        }
        <span class="flex items-baseline gap-6 ml-auto shrink-0 max-sm:hidden">
            {
                image.kind === "photo" && event.photographer && (
                    <span class="text-accent-muted max-md:hidden">
                        Image:{" "}
                        {event.photographer.url ? (
                            <a href={event.photographer.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
                                {event.photographer.name}
                            </a>
                        ) : (
                            event.photographer.name
                        )}
                    </span>
                )
            }
            {position && <span class="text-accent-muted">{position}</span>}
            <a href={`/images/event/${groupSlug(event.title)}/`} class="section-action">Event images</a>
        </span>
        {/* Phones: ends the first row (the title, then the arrows). */}
        <span class="hidden order-2 max-sm:block basis-full" aria-hidden="true"></span>
        <Paging prev={prev} next={next} close={{ href: "/images/", title: "All images" }} iconClass="icon h-7 w-7 md:h-6 md:w-6" />
    </div>
</div>

<style>
    /* The title and venue truncate (overflow hidden), which would clip the usual
       outside focus ring, so it is drawn inside. */
    .image-info a:focus-visible {
        outline-offset: -2px;
    }
    /* Phones: the arrows follow the title on the first row. */
    @media (width < 40rem) {
        .image-info :global(.paging) {
            order: 1;
        }
    }
</style>
