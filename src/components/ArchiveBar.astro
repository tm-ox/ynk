---
// The bar at the top of the events archive: just the page numbers (slot) at
// the right, placed as on the images archive's filter bar (GalleryFilter.astro).
// The left keeps that bar's height, its row and rule, unseen, so the two
// archives' grids start at the same height.
---

<div class="archive-bar">
    <div class="flex-1 min-w-0 invisible max-sm:hidden" aria-hidden="true">
        <div class="h-(--bar-row)"></div>
        <hr />
    </div>
    <slot />
</div>

<style>
    @reference "../styles/global.css";
    .archive-bar {
        @apply flex items-start justify-end w-full gap-6;
    }
    hr {
        @apply mb-0;
    }
    @media (min-width: 40rem) {
        .archive-bar > :global(nav) {
            display: flex;
            align-items: center;
            height: var(--bar-row);
            line-height: 1;
        }
    }
</style>
