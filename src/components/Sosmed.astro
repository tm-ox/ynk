---
import { Icon } from "astro-icon/components";
---

<div
  class="flex items-center h-full gap-3 sm:gap-1 sm:ml-1 sm:pl-4 sm:slash-l w-fit mx-auto"
>
  <a href="https://soundcloud.com/yesnoklub" aria-label="SoundCloud (opens in a new tab)" target="_blank" rel="noopener noreferrer" class="sm:p-0.5 sm:-m-0.5">
    <Icon name="tabler:brand-soundcloud" class="w-10 h-10 sm:w-7 sm:h-7 icon" />
  </a>
  <a href="https://www.instagram.com/yes.no.klub/" aria-label="Instagram (opens in a new tab)" target="_blank" rel="noopener noreferrer" class="sm:p-0.5 sm:-m-0.5">
    <Icon name="ion:social-instagram" class="w-7 h-7 sm:w-5 sm:h-5 icon" />
  </a>
  <a href="https://www.facebook.com/yesnoklubyk" aria-label="Facebook (opens in a new tab)" target="_blank" rel="noopener noreferrer" class="sm:p-0.5 sm:-m-0.5">
    <Icon
      name="ant-design:facebook-filled"
      class="rounded-full icon w-7 h-7 sm:w-5 sm:h-5"
    />
  </a>
  <a href="https://www.youtube.com/@yesnoklub" aria-label="YouTube (opens in a new tab)" target="_blank" rel="noopener noreferrer" class="sm:p-0.5 sm:-m-0.5">
    <Icon
      name="ion:logo-youtube"
      class="rounded-full icon w-7 h-7 sm:w-5 sm:h-5"
    />
  </a>
</div>