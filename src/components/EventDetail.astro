---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { flyerAlt } from "../utils/events";

interface Props {
  event: CollectionEntry<"events">;
  /** Makes the title a link (used where this sits on another page). In the
   *  summary the link stretches over the whole listing; the venue link and
   *  the title-action slot sit above it. */
  headingHref?: string;
  /** Adds an Event images link beside the title when the event has photographs. */
  docsHref?: string;
  /** From md up: the flyer stays vertically centred whatever the text length
   *  (the row is as tall as the taller of the two, centred in the screen, and
   *  the text column is top-aligned in it, so shorter text lines up with the
   *  flyer's top and longer text is centred). The details column is capped to
   *  the screen height and scrolls on its own beyond that. */
  capped?: boolean;
  /** Just the core details (title, date, time, venue, with) between rules,
   *  without the flyer, info, body text or documentation link. A "footer"
   *  slot follows them. */
  summary?: boolean;
}
const { event, headingHref, docsHref, capped = false, summary = false } = Astro.props;
// The event page owns the h1; the home panel sits under the page's own h1.
const Title = summary ? "h2" : "h1";
// Keeps the h2 look on the h1.
const titleClass = summary ? "" : "text-xl md:text-3xl font-bold";
const label = "mb-0 text-xs font-bold tracking-normal md:text-sm font-displayCon text-accent";
---

<div class:list={[!summary && "detail-rules flex flex-col gap-4 md:grid md:grid-cols-[minmax(0,3fr)_minmax(0,5fr)]", summary && headingHref && "relative group listing-link"]}>
  {!summary && event.data.flyer && (
  <div class:list={[capped && "md:self-center"]}>
    <Image
      src={event.data.flyer.src}
      alt={flyerAlt(event.data)}
      class:list={["fit-picture mb-auto vt-picture", capped && "md:[--fit-h:calc(100vh-var(--section-offset)-var(--spacing-section-inset))]"]}
      style={`--ar:${event.data.flyer.src.width / event.data.flyer.src.height}`}
      transition:name={`${event.data.id}-flyer`}
      loading="eager"
    />
  </div>
  )}
  <div
    data-scroll={capped ? "" : undefined}
    class:list={[
      "w-full",
      capped && "md:max-h-[calc(100vh-var(--section-offset)-var(--spacing-section-inset))] md:overflow-y-auto md:pr-2",
    ]}
  >

    <div class="flex items-center pb-rule">
      <Title class:list={["mb-0 uppercase mx-auto sm:mx-0 vt-title", titleClass]} transition:name={`${event.data.id}-title`}>
        {
          headingHref ? (
            <a href={headingHref} class="after:absolute after:inset-0 group-hover:text-accent-hover">{event.data.title}</a>
          ) : (
            event.data.title
          )
        }
      </Title>
      {summary ? (
        <div class="relative z-10 ml-auto"><slot name="title-action" /></div>
      ) : (
        docsHref && (
          <a href={docsHref} class="ml-auto section-action">Event images</a>
        )
      )}
    </div>
    <hr style="--r:0" />
    <div class="flex flex-col sm:flex-row justify-between py-rule">
      <div class="flex w-full flex-col sm:flex-row">
        <div class="flex flex-col">
          <p class={label}>date:</p>
          <h4>{event.data.date}</h4>
        </div>
        {/* From sm up the items sit apart with a slash centred in each gap. */}
        <span class="hidden sm:block flex-1 slash-c meta-slash" aria-hidden="true" />
        {
          event.data.time !== "" && (
            <>
              <div class="flex flex-col mx-auto">
                <p class={label}>time:</p>
                <h4>{event.data.time}</h4>
              </div>
              <span class="hidden sm:block flex-1 slash-c meta-slash" aria-hidden="true" />
            </>
          )
        }
      </div>
      <hr style="--r:1" />
      <div class="w-full">
        <p class={label}>venue:</p>
        <h4>
          {event.data.venue?.url ? (
            <a
              href={event.data.venue?.url}
              target="_blank"
              rel="noopener noreferrer"
              class="relative z-10"
            >
              {event.data.venue?.name}
            </a>
          ) : (
            <span>{event.data.venue?.name}</span>
          )}
        </h4>
      </div>
    </div>
    <hr style="--r:2" />
    {
      event.data.with !== "" && (
        <>
          <div class="py-rule">
            <p class={label}>with:</p>
            <h3 class="mb-0">{event.data.with}</h3>
          </div>
          <hr style="--r:3" />
        </>
      )
    }
    {
      !summary && event.data.info !== "" && (
        <>
          <div class="py-rule">
            <p class={label}>info:</p>
            <h4>{event.data.info}</h4>
          </div>
          <hr style="--r:4" />
        </>
      )
    }
    {
      summary ? (
        <slot name="footer" />
      ) : (
        <div class="py-rule">
          <slot />
        </div>
      )
    }
  </div>
</div>

<style>
  /* The listing is one link (see headingHref): hovering anywhere on it
     brightens all of its text, except the action link in the title row. */
  .listing-link:hover :is(h2, h3, h4, p, a):not(.section-action) {
    color: rgb(var(--rgb-accent-hover));
  }
  /* The slash between date, time and venue spans the text: from the label's
     cap height to the value's baseline. Worked out from BioRhyme's metrics
     (ascent 1.127em, descent 0.422em, cap height 0.686em) and the two lines'
     sizes: the label's (--lf, line --ll) and the value's (h4: 1rem, line
     1.5rem). Anchored at the top, so a venue that wraps does not stretch it. */
  .meta-slash {
    --lf: 0.75rem;
    --ll: 1rem;
    --top: calc(var(--ll) / 2 - 0.3335 * var(--lf));
    --slash-height: calc(var(--ll) + 0.75rem + 0.3525rem - var(--top));
  }
  @media (min-width: 48rem) {
    .meta-slash {
      --lf: 0.875rem;
      --ll: 1.25rem;
    }
  }
  /* At the right of its gap, as if leading the next item: its top leans
     about 9px right of centre, so this leaves about 8px clear of the text. */
  .meta-slash::before {
    left: auto;
    right: 1.25rem;
    top: var(--top);
    transform: skewX(-32deg);
  }
</style>
