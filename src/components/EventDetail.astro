---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { flyerAlt } from "../utils/events";

interface Props {
  event: CollectionEntry<"events">;
  /** Makes the title a link (used where this sits on another page). */
  headingHref?: string;
  /** Adds a Documentation link when the event has photographs. */
  docsHref?: string;
  /** From md up, fill the available height: the flyer as large as it fits and
   *  the details scrolling on their own. For use inside a fixed-height panel. */
  contained?: boolean;
  /** From md up, the flyer keeps its usual size and floats vertically centred.
   *  The details start level with its top when shorter than the flyer, and are
   *  centred with it when taller; they scroll only past the screen height. The
   *  flyer stays put however much text there is. An invisible spacer the
   *  flyer's shape sizes the middle grid row so the two share one centre. */
  pinned?: boolean;
}
const { event, headingHref, docsHref, contained = false, pinned = false } = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-4",
    pinned ? "md:grid md:gap-y-0 md:w-full md:min-h-[calc(100vh-var(--section-offset)-30px)] md:grid-cols-[3fr_5fr] md:grid-rows-[1fr_auto_1fr]" : "md:flex-row",
    contained && "md:h-full md:min-h-0",
  ]}
>
  <div
    class:list={[
      contained
        ? "md:h-full md:max-w-[62%] md:shrink-0"
        : pinned
          ? "md:col-start-1 md:row-start-1 md:row-span-3 md:self-center"
          : "md:w-3/5",
    ]}
  >
    <Image
      src={event.data.flyer.src}
      alt={flyerAlt(event.data)}
      width={contained ? 1600 : undefined}
      class:list={[
        "object-contain my-1",
        contained ? "md:h-full md:w-auto" : "h-auto mb-auto",
      ]}
    />
  </div>
  {
    pinned && (
      <div
        aria-hidden="true"
        class="hidden md:block md:col-start-1 md:row-start-2"
        style={`aspect-ratio: ${event.data.flyer!.src.width} / ${event.data.flyer!.src.height}`}
      />
    )
  }
  <div
    class:list={[
      "w-full",
      contained && "md:min-w-0 md:flex-1 md:h-full md:overflow-y-auto md:pr-2",
      pinned && "md:col-start-2 md:row-start-2 md:self-start md:overflow-y-auto md:pr-2 md:max-h-[calc(100vh-var(--section-offset)-30px)]",
    ]}
  >

    <div class="flex items-center mb-2">
      <h2 class="mb-0 uppercase mx-auto sm:mx-0">
        {
          headingHref ? (
            <a href={headingHref}>{event.data.title}</a>
          ) : (
            event.data.title
          )
        }
      </h2>
    </div>
    <hr />
    <div class="flex flex-col sm:flex-row justify-between py-rule">
      <div class="flex w-full flex-col sm:flex-row">
        <div class="flex flex-col">
          <h5>date:</h5>
          <h4>{event.data.date}</h4>
        </div>
        {
          event.data.time !== "" && (
            <div class="flex flex-col mx-auto">
              <h5>time:</h5>
              <h4>{event.data.time}</h4>
            </div>
          )
        }
      </div>
      <hr />
      <div class="w-full">
        <h5>venue:</h5>
        <h4>
          {event.data.venue.url ? (
            <a
              href={event.data.venue.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {event.data.venue.name}
            </a>
          ) : (
            <span>{event.data.venue.name}</span>
          )}
        </h4>
      </div>
    </div>
    <hr />
    {
      event.data.with !== "" && (
        <>
          <div class="py-rule">
            <h5>with:</h5>
            <h3 class="mb-0">{event.data.with}</h3>
          </div>
          <hr />
        </>
      )
    }
    {
      event.data.info !== "" && (
        <>
          <div class="py-rule">
            <h5>info:</h5>
            <h4>{event.data.info}</h4>
          </div>
          <hr />
        </>
      )
    }
    <div class="py-rule">
      <slot />
    </div>
    {
      docsHref && (
        <>
          <hr />
          <div class="py-rule">
            <h4>
              <a href={docsHref}>Documentation</a>
            </h4>
          </div>
        </>
      )
    }
  </div>
</div>
