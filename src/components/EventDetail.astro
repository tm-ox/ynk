---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { flyerAlt, photographerOf } from "../utils/events";

interface Props {
  event: CollectionEntry<"events">;
  /** Makes the title a link (used where this sits on another page). In the
   *  summary the link stretches over the whole listing; the venue link and
   *  the title-action slot sit above it. */
  headingHref?: string;
  /** Adds an Event images link beside the title when the event has photographs. */
  docsHref?: string;
  /** From md up: the flyer stays vertically centred whatever the text length
   *  (the row is as tall as the taller of the two, centred in the screen, and
   *  the text column is top-aligned in it, so shorter text lines up with the
   *  flyer's top and longer text is centred). The details column is capped to
   *  the screen height and scrolls on its own beyond that. */
  capped?: boolean;
  /** Just the core details (title, date, time, venue, with) between rules,
   *  without the flyer, info, body text or documentation link. A "footer"
   *  slot follows them. */
  summary?: boolean;
}
const { event, headingHref, docsHref, capped = false, summary = false } = Astro.props;
// The event page owns the h1; on Featured the summary sits under the page's own h1.
const Title = summary ? "h2" : "h1";
// Keeps the h2 look on the h1.
const titleClass = summary ? "" : "text-xl md:text-3xl font-bold";
const photographer = photographerOf(event.data);
const label = "mb-0 text-xs font-bold tracking-normal md:text-sm font-displayCon text-accent";
---

<div class:list={[!summary && "detail-rules flex flex-col gap-4 md:grid md:grid-cols-[minmax(0,3fr)_minmax(0,5fr)]", summary && headingHref && "relative group listing-link"]}>
  {!summary && event.data.flyer && (
  <div class:list={[capped && "md:self-center"]}>
    <Image
      src={event.data.flyer.src}
      alt={flyerAlt(event.data)}
      class:list={["fit-picture mb-auto vt-picture", capped && "md:[--fit-h:calc(100vh-var(--section-offset)-var(--spacing-section-inset))]"]}
      style={`--ar:${event.data.flyer.src.width / event.data.flyer.src.height}`}
      transition:name={`${event.data.id}-flyer`}
      loading="eager"
    />
  </div>
  )}
  <div
    data-scroll={capped ? "" : undefined}
    class:list={[
      "w-full",
      // From md the page's bar lies over the section's top (absolute, top-2),
      // so a long details column, centred at its full height, would rise
      // under it: it is capped --bar-clear (the bar's foot and a bar gap)
      // short at both ends, so centred it starts at least that far down and
      // scrolls sooner. Shorter text still lines up with the flyer's top.
      capped && "md:[--bar-clear:calc(var(--spacing)*2+var(--bar-row)+var(--spacing-bar-gap))] md:max-h-[calc(100vh-var(--section-offset)-var(--spacing-section-inset)-var(--bar-clear)*2)] md:overflow-y-auto md:pr-2",
    ]}
  >

    <div class="flex items-center">
      <Title class:list={["min-w-0 mb-0 uppercase wrap-break-word vt-title", titleClass]} transition:name={`${event.data.id}-title`}>
        {
          headingHref ? (
            <a href={headingHref} class="after:absolute after:inset-0 group-hover:text-accent-hover">{event.data.title}</a>
          ) : (
            event.data.title
          )
        }
      </Title>
      {summary ? (
        <div class="relative z-10 ml-auto"><slot name="title-action" /></div>
      ) : (
        docsHref && (
          <a href={docsHref} class="ml-auto section-action">Event images</a>
        )
      )}
    </div>
    <hr style="--r:0" />
    <div class="flex flex-col sm:flex-row justify-between">
      <div class="flex w-full flex-col sm:flex-row">
        <div class="flex flex-col">
          <p class={label}>date:</p>
          <h4 class="whitespace-nowrap">{event.data.date}</h4>
        </div>
        {/* From sm up the items sit apart with a slash centred in each gap. */}
        <span class="hidden sm:block flex-1 slash-c meta-slash" aria-hidden="true" />
        {
          event.data.time !== "" && (
            <>
              <div class="flex flex-col">
                <p class={label}>time:</p>
                <h4>
                  {event.data.time.split(/(\d{4}-\d{2}-\d{2})/).map((part) =>
                    /^\d{4}-\d{2}-\d{2}$/.test(part) ? <span class="whitespace-nowrap">{part}</span> : part,
                  )}
                </h4>
              </div>
              <span class="hidden sm:block flex-1 slash-c meta-slash" aria-hidden="true" />
            </>
          )
        }
      </div>
      <hr style="--r:1" />
      <div class="w-full">
        <p class={label}>venue:</p>
        <h4>
          {event.data.venue?.url ? (
            <a
              href={event.data.venue?.url}
              target="_blank"
              rel="noopener noreferrer"
              class="relative z-10"
            >
              {event.data.venue?.name}
            </a>
          ) : (
            <span>{event.data.venue?.name}</span>
          )}
        </h4>
      </div>
    </div>
    <hr style="--r:2" />
    {
      event.data.with !== "" && (
        <>
          <div>
            <p class={label}>with:</p>
            <h3 class="mb-0">{event.data.with}</h3>
          </div>
          <hr style="--r:3" />
        </>
      )
    }
    {
      !summary && event.data.info !== "" && (
        <>
          <div>
            <p class={label}>info:</p>
            <h4>{event.data.info}</h4>
          </div>
          <hr style="--r:4" />
        </>
      )
    }
    {
      !summary && photographer && (
        <>
          <div>
            <p class={label}>images:</p>
            <h4>
              {photographer.url ? (
                <a href={photographer.url} target="_blank" rel="noopener noreferrer" class="relative z-10">
                  {photographer.name}
                </a>
              ) : (
                photographer.name
              )}
            </h4>
          </div>
          <hr style="--r:5" />
        </>
      )
    }
    {
      summary ? (
        <slot name="footer" />
      ) : (
        <div class="detail-body">
          <slot />
        </div>
      )
    }
  </div>
</div>

<style>
  /* The listing is one link (see headingHref): hovering anywhere on it
     brightens all of its text, except the action link in the title row. */
  .listing-link:hover :is(h2, h3, h4, p, a):not(.section-action) {
    color: rgb(var(--rgb-accent-hover));
  }
  /* The rows sit --gap from their rules, about the space between a label
     and its value, so the rules read as line breaks. */
  hr,
  .meta-slash {
    --gap: 0.375rem;
  }
  hr {
    margin-block: var(--gap);
  }
  /* The body text's first paragraph sits as far below its rule as one
     paragraph sits below another: their margin (mb-2) plus the half-leading
     above a line (3px at text-sm's 14/20, 4px at text-base's 16/24), less
     the rule's own --gap. */
  .detail-body {
    --gap: 0.375rem;
    padding-top: calc(0.5rem + 3px - var(--gap));
  }
  @media (min-width: 48rem) {
    .detail-body {
      padding-top: calc(0.5rem + 4px - var(--gap));
    }
  }
  /* The slash between date, time and venue runs the row's full height, from
     the rule above to the rule below. It leads the next item: it leans from
     the top rule down and to the left (skewed about its top end), its top
     two --gap before the text that follows, so that text stays set against
     it, left aligned. The gap is never narrower than the lean (--lean, the
     slash's sideways run over the row's height, about 0.625 of it) plus the
     same clear space (--clear) on each side, so the text before it keeps off
     its foot as far as the text after keeps off its top. */
  .meta-slash {
    --lean: 2.5rem;
    --clear: 0.75rem;
    min-width: calc(var(--lean) + 2 * var(--clear));
  }
  .meta-slash::before {
    left: auto;
    right: var(--clear);
    top: calc(var(--gap) * -1);
    height: calc(100% + 2 * var(--gap));
    transform: skewX(-32deg);
    transform-origin: top;
  }
</style>
