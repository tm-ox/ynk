---
interface Props {
    events: { id: string; label: string; count: number }[];
    current?: string;
}
const { events, current } = Astro.props;
---

<div class="gallery-filter">
    <div class="flex-1 min-w-0">
    <div class="select-wrap">
    <select aria-label="Filter by event" data-gallery-filter>
        <option value="/images/" selected={!current}>ALL IMAGES</option>
        {
            events.map((event) => (
                <option
                    value={`/images/event/${event.id}/`}
                    selected={event.id === current}
                >
                    {event.label} ({event.count})
                </option>
            ))
        }
    </select>
    <span class="chevron" aria-hidden="true"></span>
    </div>
    <hr />
    <noscript>
        <ul>
            <li><a href="/images/">All images</a></li>
            {
                events.map((event) => (
                    <li>
                        <a href={`/images/event/${event.id}/`}>
                            {event.label} ({event.count})
                        </a>
                    </li>
                ))
            }
        </ul>
    </noscript>
    </div>
    <slot />
</div>

<script>
    import { navigate } from "astro:transitions/client";

    // Arrowing through the options changes the value, but must not leave the
    // page (WCAG 3.2.2): after a keyboard step, navigate on Enter or blur only.
    // Mouse and touch picks navigate straight away.
    const STEPS = ["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End"];
    const sel = "[data-gallery-filter]";
    let stepped = false;

    const isFilter = (t: EventTarget | null) =>
        t instanceof HTMLSelectElement && t.matches(sel);
    const commit = (select: HTMLSelectElement) => {
        const current = [...select.options].find((o) => o.defaultSelected);
        stepped = false;
        if (select.value && select.value !== current?.value) navigate(select.value);
    };

    // Focus is marked only when it arrived by keyboard.
    let byKey = false;
    document.addEventListener("pointerdown", () => (byKey = false), true);
    document.addEventListener("keydown", () => (byKey = true), true);
    document.addEventListener("focusin", (e) => {
        if (isFilter(e.target)) (e.target as HTMLSelectElement).toggleAttribute("data-kb", byKey);
    });
    document.addEventListener("focusout", (e) => {
        if (isFilter(e.target)) (e.target as HTMLSelectElement).removeAttribute("data-kb");
    });

    document.addEventListener("pointerdown", (e) => {
        if (isFilter(e.target)) stepped = false;
    });
    document.addEventListener("keydown", (e) => {
        // Vim keys step like the arrows. With the open list (Chrome's styleable
        // picker) focus sits on an option, otherwise on the select itself.
        if ((e.key === "j" || e.key === "k") && !e.altKey && !e.ctrlKey && !e.metaKey) {
            const dir = e.key === "j" ? 1 : -1;
            if (e.target instanceof HTMLOptionElement && e.target.closest(sel)) {
                const options = [...(e.target.closest(sel) as HTMLSelectElement).options];
                e.preventDefault();
                options[options.indexOf(e.target) + dir]?.focus();
                return;
            }
            if (isFilter(e.target)) {
                const select = e.target as HTMLSelectElement;
                const next = select.selectedIndex + dir;
                e.preventDefault();
                stepped = true;
                if (next >= 0 && next < select.options.length) select.selectedIndex = next;
                return;
            }
        }
        if (!isFilter(e.target)) return;
        if (STEPS.includes(e.key)) stepped = true;
        else if (e.key === "Enter") commit(e.target as HTMLSelectElement);
    });
    document.addEventListener("change", (e) => {
        if (isFilter(e.target) && !stepped) commit(e.target as HTMLSelectElement);
    });
    document.addEventListener("focusout", (e) => {
        if (isFilter(e.target) && stepped) commit(e.target as HTMLSelectElement);
    });
</script>

<style>
    @reference "../styles/global.css";
    .gallery-filter {
        @apply flex items-start w-full gap-6;
    }
    /* The text is lifted on its own; the chevron is drawn here (not the browser's
       arrow) so it stays centred in the row's box. */
    .select-wrap {
        @apply relative;
    }
    select {
        @apply w-full pr-6 appearance-none font-displayCon text-xs md:text-sm bg-bg text-accent-muted py-0 hover:text-accent sm:h-5 sm:leading-5 sm:-translate-y-[3px] max-sm:py-2 max-sm:text-base;
    }
    .chevron {
        @apply absolute w-[0.45rem] h-[0.45rem] border-b border-r pointer-events-none right-1.5 top-1/2 border-accent-muted;
        transform: translateY(calc(-70% - 3px)) rotate(45deg);
    }
    /* No ring, and nothing left behind after a mouse click. Only keyboard focus
       is marked (data-kb, set in the script): the text brightens. The transparent
       outline keeps an indicator in forced-colours mode. */
    select:focus-visible {
        outline: 2px solid transparent;
    }
    select[data-kb] {
        @apply text-accent-hover;
    }
    /* Where the browser allows styling the open list (Chrome 135+), drop its
       border and use the page's own colours and the site's typeface; elsewhere
       the browser's list is left as it is. */
    @supports (appearance: base-select) {
        select,
        select::picker(select) {
            appearance: base-select;
        }
        select::picker-icon {
            display: none;
        }
        select::picker(select) {
            border: 0;
            padding: 0;
            box-shadow: none;
            background: rgb(var(--rgb-bg));
        }
        option {
            @apply px-0 py-1 text-accent-muted;
            outline: none;
        }
        option:hover,
        option:focus,
        option:focus-visible {
            @apply text-accent;
            background: transparent;
        }
        option:checked {
            @apply text-accent;
        }
        option::checkmark {
            display: none;
        }
    }
    select:hover + .chevron {
        @apply border-accent;
    }
    /* Rule under the dropdown only; the slotted action sits free beside it. */
    hr {
        @apply mb-0;
    }
</style>
