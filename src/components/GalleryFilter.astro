---
interface Props {
    events: { id: string; label: string; count: number }[];
    current?: string;
}
const { events, current } = Astro.props;
---

<div class="gallery-filter">
    <select aria-label="Filter by event" data-gallery-filter>
        <option value="/images/" selected={!current}>All events</option>
        {
            events.map((event) => (
                <option
                    value={`/images/event/${event.id}/`}
                    selected={event.id === current}
                >
                    {event.label} ({event.count})
                </option>
            ))
        }
    </select>
    <noscript>
        <ul>
            <li><a href="/images/">All events</a></li>
            {
                events.map((event) => (
                    <li>
                        <a href={`/images/event/${event.id}/`}>
                            {event.label} ({event.count})
                        </a>
                    </li>
                ))
            }
        </ul>
    </noscript>
    <hr />
</div>

<script>
    import { navigate } from "astro:transitions/client";

    document.addEventListener("change", (e) => {
        const select = e.target as HTMLSelectElement;
        if (select.matches?.("[data-gallery-filter]")) {
            navigate(select.value);
        }
    });
</script>

<style>
    @reference "../styles/global.css";
    .gallery-filter {
        @apply w-full pt-1 mb-4;
    }
    select {
        @apply w-full bg-bg text-accent-muted py-0 hover:text-accent max-sm:py-2 max-sm:text-base;
    }
    hr {
        @apply my-1;
    }
</style>
