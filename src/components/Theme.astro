---
import { Icon } from "astro-icon/components";
---

<button
  class="z-(--z-overlay) h-7 ml-1 pl-3 border-l border-l-border"
  data-theme-toggle
  aria-label="Toggle theme"
  transition:persist="theme"
>
  <Icon name="bx:bxs-moon" class="w-6 sm:h-6 icon theme-moon" />
  <Icon name="bx:bxs-sun" class="w-6 sm:h-6 icon theme-sun" />
</button>

<script is:inline>
document.querySelectorAll("[data-theme-toggle]").forEach((toggle) => {
    toggle.addEventListener("click", () => {
        const next = window.__currentTheme() === "light" ? "dark" : "light";
        try {
            localStorage.setItem("theme", next);
        } catch (e) {}
        window.__applyTheme(next);
    });
});
</script>
