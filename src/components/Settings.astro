---
import { Icon } from "astro-icon/components";

// Reference for the Keyboard group: [keys, what they do].
const keyboard: [string[], string][] = [
  [["←", "→", "h", "l"], "Move between panels, events, photographs and pages."],
  [["↑", "↓", "j", "k"], "Scroll the panel, event or page. Steps through the image filter."],
  [["Esc"], "Close and go back."],
  [["?"], "Open settings."],
];
const themes = [
  ["system", "System"],
  ["light", "Light"],
  ["dark", "Dark"],
];
const label = "mb-0 text-xs font-bold tracking-normal uppercase md:text-sm font-displayCon text-accent";
---

<button
  type="button"
  class="z-(--z-overlay) h-7 ml-1 pl-3 border-l border-l-border cursor-pointer"
  data-settings-open
  aria-label="Settings"
  aria-haspopup="dialog"
  transition:persist="settings"
>
  <Icon name="bx:bxs-cog" class="w-6 sm:h-6 icon" />
</button>

<!-- A native modal dialog: centred on screen, the page behind is inert, focus
     stays inside, and Esc closes it. Focus starts on the title (autofocus),
     not on the close button, so no ring shows until the keyboard user tabs. The padding lives on the inner div so a
     click on the dialog element itself can only be a click on the backdrop. -->
<dialog
  data-settings
  aria-labelledby="settings-title"
  class="m-auto w-[min(92vw,44rem)] max-h-[85dvh] p-0 overflow-y-auto border-y border-border bg-bg text-fg backdrop:bg-scrim-heavy backdrop:backdrop-blur-sm"
>
  <div class="flex flex-col p-4 pb-0 sm:p-6 sm:pb-0">
    <div class="flex items-center justify-between gap-4 pb-3">
      <h2 id="settings-title" tabindex="-1" autofocus class="focus:outline-none mb-0 text-xl uppercase sm:text-left md:text-3xl">Settings</h2>
      <button type="button" data-settings-close aria-label="Close settings" class="cursor-pointer -translate-y-0.75">
        <Icon name="ion:close-sharp" class="icon" />
      </button>
    </div>

    <div>
      <hr class="mt-0" />
      <h3 id="settings-theme" class={`${label} sm:text-left`}>Theme</h3>
      <hr class="mb-0" />
      <div class="grid grid-cols-3" role="radiogroup" aria-labelledby="settings-theme">
        {themes.map(([value, text]) => (
          <label class="settings-choice">
            <input type="radio" name="theme" value={value} class="sr-only peer" data-theme-choice />
            <span class="font-displayCon peer-checked:text-accent peer-checked:bg-accent-muted/10 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:-outline-offset-2 peer-focus-visible:outline-accent">{text}</span>
          </label>
        ))}
      </div>
    </div>

    <div>
      <hr class="mt-0" />
      <h3 class={`${label} sm:text-left`}>Keyboard</h3>
      <hr class="mb-0" />
      <dl class="grid items-baseline gap-x-6 gap-y-3 py-3 sm:grid-cols-[auto_1fr]">
        {keyboard.map(([keys, text]) => (
          <>
            <dt class="flex flex-wrap gap-1">
              {keys.map((key) => <kbd class="inline-flex items-center justify-center h-7 px-1.5 text-sm leading-none border min-w-7 font-displayCon text-accent border-accent-muted">{key}</kbd>)}
            </dt>
            <dd class="m-0 text-sm font-light tracking-wide font-body md:text-base">{text}</dd>
          </>
        ))}
      </dl>
    </div>

    <div>
      <hr class="mt-0" />
      <h3 class={`${label} sm:text-left`}>Good to know</h3>
      <hr class="mb-0" />
      <ul class="flex flex-col py-3 text-sm font-light tracking-wide list-none font-body md:text-base">
        <li class="normal-case">The mouse wheel and swiping also move between home panels.</li>
        <li class="normal-case">Shortcuts pause while you type in a form.</li>
        <li class="normal-case">Animations are reduced if your device asks.</li>
      </ul>
    </div>

    <div>
      <hr class="my-0" />
      <p class="flex items-center justify-center pt-1.5 pb-1 mb-0 text-xs h-footer font-displayCon text-accent-muted">© 2010–{new Date().getFullYear()} Yes No Klub</p>
    </div>
  </div>
</dialog>

<style>
  /* Theme choices share the row equally; the chosen one carries a tint. */
  .settings-choice span {
    display: block;
    padding: 0.875rem 0 0.625rem;
    text-align: center;
    text-transform: uppercase;
    font-size: 0.875rem;
    /* A little more room above than below optically centres the capitals. */
    line-height: 1;
    cursor: pointer;
    color: var(--color-accent-muted);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  /* A divider between the options only, as the nav and social icons have. */
  .settings-choice + .settings-choice {
    border-left: 1px solid var(--color-border);
  }
  .settings-choice:hover span {
    color: var(--color-accent);
  }
</style>

<script>
  // Bound once (module scripts are not re-run by the router), so everything is
  // looked up when the event happens.
  const dialog = () => document.querySelector<HTMLDialogElement>("dialog[data-settings]");

  // The browser hands focus back to the cog when the dialog closes and, for a
  // dialog opened with the mouse, can draw the keyboard ring on it. Only keep
  // focus there if it was opened from the keyboard.
  let openedByKeyboard = false;

  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    const d = dialog();
    if (!d) return;
    if (target.closest("[data-settings-open]")) {
      const current = window.__storedTheme();
      d.querySelectorAll<HTMLInputElement>("[data-theme-choice]").forEach((input) => {
        input.checked = input.value === current;
      });
      openedByKeyboard = e.detail === 0;
      d.showModal();
    } else if (target.closest("[data-settings-close]") || target === d) {
      d.close();
    }
  });

  // "close" does not bubble, so listen in the capture phase.
  document.addEventListener(
    "close",
    (e) => {
      if (!openedByKeyboard && (e.target as Element).matches("dialog[data-settings]")) {
        document.querySelector<HTMLElement>("[data-settings-open]")?.blur();
      }
    },
    true,
  );

  document.addEventListener("change", (e) => {
    const input = e.target as HTMLInputElement;
    if (input.matches("[data-theme-choice]")) window.__setTheme(input.value);
  });
</script>
