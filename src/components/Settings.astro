---
import { Icon } from "astro-icon/components";

// Reference for the Keyboard group: [keys, what they do].
const keyboard: [string[], string][] = [
  [["←", "→", "h", "l"], "Move between screens, events, photographs and pages."],
  [["↑", "↓", "j", "k"], "Scroll the event or page. Steps through the image filter."],
  [["Esc"], "Close and go back."],
  [["?"], "Open settings."],
];
const themes = [
  ["system", "System"],
  ["light", "Light"],
  ["dark", "Dark"],
];
const label = "mb-0 text-xs font-bold tracking-normal uppercase md:text-sm font-displayCon text-accent";
---

<button
  type="button"
  class="h-7 ml-2 pl-3.5 slash-l cursor-pointer"
  data-settings-open
  aria-label="Settings"
  aria-haspopup="dialog"
  transition:persist="settings"
>
  <Icon name="bx:bxs-cog" class="w-6 sm:h-6 icon" />
</button>

<!-- A native modal dialog: centred on screen, the page behind is inert, focus
     stays inside, and Esc closes it. Focus starts on the title (autofocus),
     not on the close button, so no ring shows until the keyboard user tabs. The padding lives on the inner div so a
     click on the dialog element itself can only be a click on the backdrop. -->
<dialog
  data-settings
  aria-labelledby="settings-title"
  class="m-auto overscroll-contain w-[min(92vw,44rem)] max-h-[85dvh] p-0 overflow-y-auto border-y border-border bg-bg text-fg backdrop:bg-scrim-heavy backdrop:backdrop-blur-sm"
>
  <div class="flex flex-col p-4 pb-0 sm:p-6 sm:pb-0">
    <div class="flex items-center justify-between gap-4 pb-3">
      <h2 id="settings-title" tabindex="-1" autofocus class="focus:outline-none mb-0 text-xl uppercase sm:text-left md:text-3xl">Settings</h2>
      <button type="button" data-settings-close aria-label="Close settings" class="cursor-pointer -translate-y-0.75">
        <Icon name="ion:close-sharp" class="icon" />
      </button>
    </div>

    <div>
      <hr class="mt-0" />
      <h3 id="settings-theme" class={`${label} sm:text-left`}>Theme</h3>
      <hr class="mb-0" />
      <div class="grid grid-cols-3 overflow-hidden" role="radiogroup" aria-labelledby="settings-theme">
        {themes.map(([value, text]) => (
          <label class="settings-choice">
            <input type="radio" name="theme" value={value} class="sr-only peer" data-theme-choice />
            <span class="font-displayCon">{text}</span>
          </label>
        ))}
      </div>
    </div>

    <div>
      <hr class="mt-0" />
      <h3 class={`${label} sm:text-left`}>Keyboard</h3>
      <hr class="mb-0" />
      <dl class="grid items-baseline gap-x-6 gap-y-3 py-3 sm:grid-cols-[auto_1fr]">
        {keyboard.map(([keys, text]) => (
          <>
            <dt class="flex flex-wrap gap-1">
              {keys.map((key) => <kbd class="inline-flex items-center justify-center h-7 px-1.5 text-sm leading-none border min-w-7 font-displayCon text-accent border-accent-muted">{key}</kbd>)}
            </dt>
            <dd class="m-0 text-sm font-light tracking-wide font-body md:text-base">{text}</dd>
          </>
        ))}
      </dl>
    </div>

    <div>
      <hr class="mt-0" />
      <h3 class={`${label} sm:text-left`}>Good to know</h3>
      <hr class="mb-0" />
      <ul class="flex flex-col py-3 text-sm font-light tracking-wide list-none font-body md:text-base">
        <li class="normal-case">The mouse wheel moves on the same way, once the page has scrolled to its end.
</li>
        <li class="normal-case">Shortcuts pause while you type in a form.</li>
        <li class="normal-case">Animations are reduced if your device asks.</li>
      </ul>
    </div>

    <div>
      <hr class="my-0" />
      <p class="flex items-center justify-center pt-1.5 pb-1 mb-0 text-xs h-footer font-displayCon text-accent-muted">© 2010–{new Date().getFullYear()} Yes No Klub</p>
    </div>
  </div>
  <!-- The line that rides the edge as the panel opens and closes, in a window
       the panel's size. -->
  <span class="settings-seam" aria-hidden="true" hidden data-settings-seam><span></span></span>
</dialog>

<style>
  /* Opening and closing, the panel turns like a page: the page turn's edge
     and line (see the page turn rules in global.css) cross its own box, right
     to left to show it and back to hide it, with --page-seam-easing. The panel
     is small, so the edge crosses it in --settings-sweep, quicker than
     --seam-duration. The backdrop fades in --settings-fade, as the edge sets
     off on the way in and as it arrives on the way out. With reduced motion
     the panel only fades, as the backdrop does. The script runs it all. */
  dialog[data-settings] {
    --settings-sweep: 0.45s;
    --settings-fade: 0.2s;
  }
  /* ::backdrop is not caught by the reduced-motion rule in global.css, so its
     fade stays either way. */
  dialog[data-settings]::backdrop {
    transition: opacity var(--settings-fade) ease;
  }
  @starting-style {
    dialog[data-settings][open]::backdrop {
      opacity: 0;
    }
  }
  dialog[data-settings][data-closing]::backdrop {
    opacity: 0;
    transition-delay: calc(var(--settings-sweep) - var(--settings-fade));
  }
  @media (prefers-reduced-motion: reduce) {
    dialog[data-settings][data-closing]::backdrop {
      transition-delay: 0s;
    }
  }
  /* Fixed, so it stays put while the panel scrolls, and laid over the panel's
     box (by the script), whose edges cut the line off: it never shows over the
     backdrop. The line is slanted as the slashes are, about its mid-height. */
  .settings-seam {
    position: fixed;
    overflow: hidden;
    pointer-events: none;
  }
  .settings-seam > span {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--wipe-line);
    height: 100%;
    background: var(--color-border);
    transform: skewX(-32deg);
  }

  /* Theme choices share the row equally; the chosen one carries a tint. */
  .settings-choice span {
    display: block;
    padding: 0.75rem 0 0.75rem;
    text-align: center;
    text-transform: uppercase;
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-accent-muted);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  /* A divider between the options only, as the nav and social icons have:
     the slash (see slash-l in global.css). */
  .settings-choice + .settings-choice {
    position: relative;
  }
  /* Full height here, so the slashes split the row into slanted cells. */
  .settings-choice + .settings-choice::before {
    content: "";
    position: absolute;
    z-index: 1;
    left: calc(var(--slash-weight) / -2);
    top: 0;
    width: var(--slash-weight);
    height: 100%;
    background: var(--color-border);
    transform: skewX(-32deg);
    pointer-events: none;
  }
  /* The chosen one's tint, and the keyboard focus ring, are a box slanted the
     same way, so they meet the slashes either side (the row clips the outer
     ends straight). */
  .settings-choice span {
    position: relative;
    isolation: isolate;
  }
  .settings-choice span::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: skewX(-32deg);
    transition: background-color 0.2s ease;
  }
  /* At the row's ends the slanted box would leave a corner bare; it runs on
     past them instead, and the row cuts it straight. */
  .settings-choice:first-child span::before {
    left: -2rem;
  }
  .settings-choice:last-child span::before {
    right: -2rem;
  }
  .settings-choice input:checked + span {
    color: var(--color-accent);
  }
  .settings-choice input:checked + span::before {
    background: rgb(var(--rgb-accent-muted) / 0.1);
  }
  .settings-choice input:focus-visible + span::before {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .settings-choice:hover span {
    color: var(--color-accent);
  }
</style>

<script>
  // Bound once (module scripts are not re-run by the router), so everything is
  // looked up when the event happens.
  const dialog = () => document.querySelector<HTMLDialogElement>("dialog[data-settings]");

  // The browser hands focus back to the cog when the dialog closes and, for a
  // dialog opened with the mouse, can draw the keyboard ring on it. Only keep
  // focus there if it was opened from the keyboard.
  let openedByKeyboard = false;

  // The sweep (see the style above). The edge is a line on screen at the
  // logo's angle: ex is where it crosses the panel's mid-height, and it leans
  // tan 32deg sideways per unit of height. The panel shows what is right of
  // it; its contents start --page-band further right, and in that gap the
  // line rides between two strips of the panel's background, as on a page
  // turn. Every clip is a polygon in its own box, so the contents' clip
  // follows them however far they are scrolled.
  const TAN = Math.tan((32 * Math.PI) / 180);
  const ms = (style: CSSStyleDeclaration, name: string) => {
    const value = style.getPropertyValue(name).trim();
    return value.endsWith("ms") ? parseFloat(value) : parseFloat(value) * 1000;
  };
  const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Resolves when it is done; rejects if it is cancelled (by the close below).
  function turn(d: HTMLDialogElement, show: boolean) {
    const style = getComputedStyle(d);
    const fill: FillMode = show ? "none" : "forwards";
    if (reduced()) {
      return d.animate({ opacity: show ? [0, 1] : [1, 0] }, { duration: ms(style, "--settings-fade"), easing: "ease", fill }).finished;
    }
    const contents = d.firstElementChild as HTMLElement;
    const seam = d.querySelector<HTMLElement>("[data-settings-seam]")!;
    const line = seam.firstElementChild as HTMLElement;
    const box = d.getBoundingClientRect();
    const inner = contents.getBoundingClientRect();
    const halo = parseFloat(style.getPropertyValue("--page-halo")) || 0;
    const band = (parseFloat(style.getPropertyValue("--wipe-line")) || 0) + 2 * halo;
    const mid = box.top + box.height / 2;
    const lean = (box.height / 2) * TAN;
    // Hidden: the edge's foot is at the box's right side. Shown: the line and
    // the gap are past its left side at the top.
    const hidden = box.right + lean;
    const shown = box.left - lean - band;
    const [from, to] = show ? [hidden, shown] : [shown, hidden];
    const clip = (b: DOMRect, ex: number, gap: number) => {
      const x = (y: number) => ex + (mid - y) * TAN + gap - b.left;
      return `polygon(${x(b.top)}px 0, 10000px 0, 10000px ${b.height}px, ${x(b.bottom)}px ${b.height}px)`;
    };
    const timing = { duration: ms(style, "--settings-sweep"), easing: style.getPropertyValue("--page-seam-easing").trim(), fill };
    Object.assign(seam.style, { left: `${box.left}px`, top: `${box.top}px`, width: `${box.width}px`, height: `${box.height}px` });
    seam.hidden = false;
    return Promise.all(
      [
        d.animate({ clipPath: [clip(box, from, 0), clip(box, to, 0)] }, timing),
        contents.animate({ clipPath: [clip(inner, from, band), clip(inner, to, band)] }, timing),
        line.animate({ translate: [`${from + halo - box.left}px 0`, `${to + halo - box.left}px 0`] }, timing),
      ].map((a) => a.finished),
    ).finally(() => {
      // Unless it was cut short by a close, which needs the line again.
      if (show && !d.hasAttribute("data-closing")) seam.hidden = true;
    });
  }

  // Every way of closing comes here: the panel turns away, then the dialog
  // closes. data-closing (which also fades the backdrop) keeps a second
  // click or Esc from starting it again. One still opening is finished first.
  function shut(d: HTMLDialogElement) {
    if (!d.open || d.hasAttribute("data-closing")) return;
    d.getAnimations({ subtree: true }).forEach((a) => a.finish());
    d.setAttribute("data-closing", "");
    turn(d, false).then(
      () => d.close(),
      () => {},
    );
  }

  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    const d = dialog();
    if (!d) return;
    if (target.closest("[data-settings-open]")) {
      const current = window.__storedTheme();
      d.querySelectorAll<HTMLInputElement>("[data-theme-choice]").forEach((input) => {
        input.checked = input.value === current;
      });
      openedByKeyboard = e.detail === 0;
      d.showModal();
      turn(d, true).catch(() => {});
    } else if (target.closest("[data-settings-close]") || (target === d && pressedOnBackdrop)) {
      shut(d);
    }
  });

  // A drag that starts inside the dialog and ends over the backdrop must not
  // close it: only a press that began on the backdrop counts.
  let pressedOnBackdrop = false;
  document.addEventListener("pointerdown", (e) => {
    pressedOnBackdrop = (e.target as Element).matches("dialog[data-settings]");
  });

  // Esc asks first ("cancel"), so it can turn away too. (Chromium closes
  // outright on a second Esc with no click or key between; the close below
  // then tidies up.)
  document.addEventListener(
    "cancel",
    (e) => {
      const d = e.target as HTMLDialogElement;
      if (!d.matches("dialog[data-settings]")) return;
      e.preventDefault();
      shut(d);
    },
    true,
  );

  // "close" and "cancel" do not bubble, so listen in the capture phase.
  document.addEventListener(
    "close",
    (e) => {
      const d = e.target as HTMLDialogElement;
      if (!d.matches("dialog[data-settings]")) return;
      d.removeAttribute("data-closing");
      d.getAnimations({ subtree: true }).forEach((a) => a.cancel());
      d.querySelector<HTMLElement>("[data-settings-seam]")!.hidden = true;
      if (!openedByKeyboard) document.querySelector<HTMLElement>("[data-settings-open]")?.blur();
    },
    true,
  );

  document.addEventListener("change", (e) => {
    const input = e.target as HTMLInputElement;
    if (input.matches("[data-theme-choice]")) window.__setTheme(input.value as "system" | "light" | "dark");
  });
</script>
