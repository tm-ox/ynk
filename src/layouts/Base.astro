---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Logo from "../components/Logo.astro";
import Theme from "../components/Theme.astro";
import { GoogleAnalytics } from "astro-google-analytics";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object | object[];
}

const siteName = "Yes No Klub";
const defaultDescription =
  "Yes No Klub - Experimental etc. event organiser out of Yogyakarta, Indonesia.";
const { title, description = defaultDescription, image, jsonLd } = Astro.props;
const fullTitle = title
  ? `${title} – ${siteName}`
  : `${siteName} – Experimental etc., Yogyakarta`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? "/og-default.jpg", Astro.site).href;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <!-- Meta/manifest colours can't use CSS variables: dark theme values.
             theme-color is kept in sync with --color-bg by the script below. -->
        <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#03c91d" />
        <meta name="msapplication-TileColor" content="#041b1b" />
        <meta name="theme-color" content="#041b1b" />
        <script is:inline>
            (function () {
                var root = document.documentElement;
                var stored = function () {
                    try {
                        return localStorage.getItem("theme");
                    } catch (e) {
                        return null;
                    }
                };
                var syncMeta = function () {
                    var m = document.querySelector('meta[name="theme-color"]');
                    if (m) m.content = getComputedStyle(root).backgroundColor;
                };
                window.__applyTheme = function (theme, doc) {
                    (doc || document).documentElement.setAttribute("data-theme", theme);
                    if (!doc && document.readyState === "complete") syncMeta();
                };
                window.__currentTheme = function () {
                    return (
                        root.getAttribute("data-theme") ||
                        (matchMedia("(prefers-color-scheme: light)").matches
                            ? "light"
                            : "dark")
                    );
                };
                if (stored()) window.__applyTheme(stored());
                window.addEventListener("load", syncMeta);
                document.addEventListener("astro:before-swap", function (e) {
                    if (stored()) window.__applyTheme(stored(), e.newDocument);
                });
                document.addEventListener("astro:after-swap", syncMeta);
            })();
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{fullTitle}</title>
        <meta name="title" content={fullTitle} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonical} />
        <meta property="twitter:title" content={fullTitle} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ogImage} />
        {
            jsonLd && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
                />
            )
        }
        <Font
            cssVariable="--font-biorhyme-expanded"
            preload={[
                { subset: "latin", style: "normal", weight: 700 },
                { subset: "latin", style: "normal", weight: 800 },
            ]}
        />
        <Font cssVariable="--font-biorhyme" />
        <Font
            cssVariable="--font-pathway-extreme"
            preload={[{ subset: "latin", style: "normal", weight: 300 }]}
        />
        <ClientRouter />
        <GoogleAnalytics id="G-T32SXCFCXD" />
        <!-- Google tag (gtag.js) -->
        <!-- <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-T32SXCFCXD"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-T32SXCFCXD");
    </script> -->
    </head>
    <body>
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-(--z-overlay) focus:bg-bg focus:p-2"
            >Skip to content</a
        >
        <header>
            <nav>
                <Logo />
                <slot name="nav" transition:persist />
                <Theme />
            </nav>
        </header>
        <main id="main">
            <slot />
        </main>
        <footer class="flex items-center justify-between h-footer">
            <a
                href="/privacy"
                class="text-xs tracking-wide font-displayCon text-accent-muted hover:text-accent"
                >Privacy</a
            >
            <small
                class="text-xs tracking-wide font-displayCon text-accent-muted"
                >© 2010–{new Date().getFullYear()} Yes No Klub</small
            >
        </footer>
    <script>
            // Arrow keys follow the on-page Previous/Next links (events, images,
            // paginated lists); Escape follows the close link. Bound once: module
            // scripts are not re-run by the view-transition router.
            document.addEventListener("keydown", (e) => {
                if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
                const t = e.target as HTMLElement;
                if (t.closest("input, textarea, select, [contenteditable]")) return;
                const selector =
                    e.key === "ArrowLeft" ? 'a[aria-label="Previous"]'
                    : e.key === "ArrowRight" ? 'a[aria-label="Next"]'
                    : e.key === "Escape" ? 'a[aria-label="All events"], a[aria-label="All images"]'
                    : null;
                const link = selector && document.querySelector<HTMLAnchorElement>(selector);
                if (link) {
                    e.preventDefault();
                    link.click();
                }
            });
        </script>
    </body>
</html>
