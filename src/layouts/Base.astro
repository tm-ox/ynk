---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Logo from "../components/Logo.astro";
import Settings from "../components/Settings.astro";
import { THEME_CHOICE } from "../utils/theme";
import { GoogleAnalytics } from "astro-google-analytics";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object | object[];
  /** The page's first screen runs edge to edge (body.bleed, global.css). */
  bleed?: boolean;
}

const siteName = "Yes No Klub";
const defaultDescription =
  "Yes No Klub - Experimental etc. event organiser out of Yogyakarta, Indonesia.";
const { title, description = defaultDescription, image, jsonLd, bleed } = Astro.props;
const fullTitle = title
  ? `${title} – ${siteName}`
  : `${siteName} – Experimental etc., Yogyakarta`;
// Thumbnail look at rest: "" (full colour, default) or "duotone" (two-tone of
// the theme, colour on hover). Change this one word to try it site-wide.
const thumbs: "" | "duotone" = "";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? "/og-default.jpg", Astro.site).href;
---

<html lang="en" data-theme="dark" data-thumbs={thumbs || undefined}>
    <head>
        <meta charset="utf-8" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <!-- Meta/manifest colours can't use CSS variables: dark theme values.
             theme-color is kept in sync with --color-bg by the script below. -->
        <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#03c91d" />
        <meta name="msapplication-TileColor" content="#041b1b" />
        <meta name="theme-color" content="#041b1b" />
        {!THEME_CHOICE && <meta name="color-scheme" content="dark" />}
        <!-- Thumbnail duotone: set `thumbs` in the frontmatter above to "duotone". -->
        <script is:inline define:vars={{ themeChoice: THEME_CHOICE }}>
            (function () {
                var root = document.documentElement;
                // The visitor's choice: "system" (follow the device), "light"
                // or "dark". Dark until they choose (the light theme is not
                // finished), so "system" is stored like the others.
                var stored = function () {
                    if (!themeChoice) return "dark";
                    try {
                        var t = localStorage.getItem("theme");
                        return t === "light" || t === "dark" || t === "system" ? t : "dark";
                    } catch (e) {
                        return "dark";
                    }
                };
                var syncMeta = function () {
                    var m = document.querySelector('meta[name="theme-color"]');
                    if (m) m.content = getComputedStyle(root).backgroundColor;
                };
                window.__applyTheme = function (theme, doc) {
                    var r = (doc || document).documentElement;
                    if (theme === "system") r.removeAttribute("data-theme");
                    else r.setAttribute("data-theme", theme);
                    if (!doc && document.readyState === "complete") syncMeta();
                };
                window.__setTheme = function (choice) {
                    try {
                        localStorage.setItem("theme", choice);
                    } catch (e) {}
                    window.__applyTheme(choice);
                    syncMeta();
                };
                window.__storedTheme = stored;
                window.__applyTheme(stored());
                window.addEventListener("load", syncMeta);
                document.addEventListener("astro:before-swap", function (e) {
                    window.__applyTheme(stored(), e.newDocument);
                });
                document.addEventListener("astro:after-swap", syncMeta);
            })();
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{fullTitle}</title>
        <meta name="title" content={fullTitle} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonical} />
        <meta property="twitter:title" content={fullTitle} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ogImage} />
        {
            jsonLd && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
                />
            )
        }
        <Font
            cssVariable="--font-biorhyme-expanded"
            preload={[
                { subset: "latin", style: "normal", weight: 700 },
                { subset: "latin", style: "normal", weight: 800 },
            ]}
        />
        <Font cssVariable="--font-biorhyme" />
        <Font
            cssVariable="--font-pathway-extreme"
            preload={[{ subset: "latin", style: "normal", weight: 300 }]}
        />
        <!-- Extras a page wants in the head (neighbour pictures to prefetch). -->
        <slot name="head" />
        <ClientRouter />
        <GoogleAnalytics id="G-T32SXCFCXD" />
        <!-- Google tag (gtag.js) -->
        <!-- <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-T32SXCFCXD"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-T32SXCFCXD");
    </script> -->
    </head>
    <body class:list={[bleed && "bleed"]}>
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-(--z-overlay) focus:bg-bg focus:p-2"
            >Skip to content</a
        >
        <!-- Named, so a page turn captures it apart from the page and draws it
             over the turning screen (global.css), as it lies over the page
             scrolled under it. -->
        <header transition:name="header">
            <nav aria-label="Main">
                <Logo />
                <slot name="nav" />
                <Settings />
            </nav>
        </header>
        <main id="main">
            <!-- The rule under the header (see .frame-rule in global.css), and
                 what lies on it (the position mark, BaseLayout.astro). -->
            <div class="frame-rule" aria-hidden="true" transition:name="frame-rule"><slot name="rule" /></div>
            <slot />
        </main>
        <!-- Not on phones: there it sits at the foot of the menu panel
             (BaseLayout.astro), display:none here so it is read once. -->
        <footer class="flex items-center justify-center h-footer max-sm:hidden">
            <a
                href="/privacy/"
                class="text-xs tracking-wide uppercase font-displayCon text-accent-muted hover:text-accent"
                >Privacy</a
            >
        </footer>
    <script>
            import { bindWheelPager } from "../scripts/wheel-pager";
            // Keyboard paging, scrolling and Escape (binds itself once on import).
            import "../scripts/keys";
            // A sideways swipe steps as the arrows do (binds itself once on import).
            import "../scripts/swipe";
            // The archive rise-in's order along the diagonal.
            import "../scripts/diagonal";

            import { screenOf } from "../utils/row";
            import { stepFor, prefetchNeighbours } from "../scripts/step";
            // Once the page has loaded, so it never competes with the page itself.
            document.addEventListener("astro:page-load", prefetchNeighbours);

            // The wheel steps as the arrow keys do (scripts/step.ts): Next /
            // Previous, and past them the neighbouring screen of the row. Only
            // once whatever is under the pointer has scrolled to its end, and
            // never while a step is still turning the page (PAGING.lock).
            bindWheelPager({
                root: () => document.documentElement,
                canStep: (dir) => !!stepFor(dir),
                step: (dir) => stepFor(dir)?.(),
            });


            // Paging between neighbours (Previous / Next, by click, key or wheel)
            // turns the page, and so do page numbers and moves between the
            // screens of the row (below). Everything else keeps the morph. The
            // custom direction value is what global.css keys the turn on.
            document.addEventListener("astro:before-preparation", (e: any) => {
                const label = e.sourceElement
                    ?.closest?.("a")
                    ?.getAttribute("aria-label");
                if (label === "Previous") e.direction = "paging-back";
                else if (label === "Next") e.direction = "paging-forward";
                // Page numbers wipe too, by which way the target page lies.
                // The page you are already on keeps Astro's default.
                if (e.sourceElement?.closest?.('nav[aria-label="Pagination"]')) {
                    const page = (u: URL) =>
                        Number(u.pathname.match(/\/(\d+)\/?$/)?.[1] ?? 1);
                    if (page(e.to) !== page(e.from))
                        e.direction =
                            page(e.to) > page(e.from)
                                ? "paging-forward"
                                : "paging-back";
                }
                // Home, Featured, About, the archives and Contact are one row
                // of screens (utils/row.ts), as the nav and the arrow keys
                // have them. A move between two of them that are different
                // screens turns the page that way, like page numbers do.
                // Details are not in the row and keep the morph (privacy,
                // below, turns all the same).
                const screen = (url: URL) => screenOf(url.pathname);
                const from = screen(e.from);
                const to = screen(e.to);
                if (
                    !e.direction?.startsWith("paging") &&
                    from !== undefined &&
                    to !== undefined &&
                    from !== to
                )
                    e.direction = to > from ? "paging-forward" : "paging-back";
                // Privacy is off the row, a page laid over it: going to it
                // from anywhere turns forward, leaving it turns back.
                if (!e.direction?.startsWith("paging") && isPrivacy(e.to) !== isPrivacy(e.from))
                    e.direction = isPrivacy(e.to) ? "paging-forward" : "paging-back";
                paging = !!e.direction && e.direction.startsWith("paging");
                // Names and classes changed for the last transition (see
                // unname, fold and turnBox) come back first, so any of them can
                // travel this time.
                document
                    .querySelectorAll<HTMLElement>('[style*="view-transition-name"]')
                    .forEach((el) => (el.style.viewTransitionName = ""));
                document
                    .querySelectorAll<HTMLElement>('[style*="view-transition-class"]')
                    .forEach((el) => (el.style.viewTransitionClass = ""));
                // Pages wipe as a whole, under one edge: the titles and
                // thumbnails in grid cards, and the flyer, title and label
                // inside an event, must not be captured separately.
                if (paging) {
                    unname(document);
                    fold(document);
                }

                // Remember where a detail page was opened from, so its close
                // button returns there: the screen of the row it was opened on
                // (Featured, an archive page and its grid position). Paging
                // between details keeps it; anything else clears it.
                const isDetail = (url: URL) =>
                    /^\/(events|images)\/(?!\d+\/?$)[^/]+\/?$/.test(
                        url.pathname,
                    );
                // Slashless group URLs (typed by hand) count too.
                const isArchive = (url: URL) =>
                    /^\/(events|images)(\/(\d+\/?)?)?$/.test(url.pathname) ||
                    /^\/images\/event\/[^/]+(\/(\d+\/?)?)?$/.test(url.pathname);
                // Back / forward keeps whatever was remembered.
                if (e.navigationType !== "traverse") {
                    if (isDetail(e.to) && screen(e.from) !== undefined)
                        closeTo = e.from.pathname + e.from.search;
                    else if (!(isDetail(e.from) && isDetail(e.to)))
                        closeTo = null;
                    try {
                        if (closeTo) sessionStorage.setItem("closeTo", closeTo);
                        else sessionStorage.removeItem("closeTo");
                    } catch {}
                }


                // Coming back to an archive from one of its pictures or events
                // (close or back): the grid was already seen, so its thumbnails
                // do not rise in again (global.css keys on data-returning).
                // Page turns set it too: the grid slides in and wipes instead.
                pagedDetail = paging && isDetail(e.to);
                returning = (isDetail(e.from) || paging) && isArchive(e.to);
                // A page turn onto a screen of the row, to or from privacy,
                // or Previous / Next between details: the seam crosses the two
                // snapshots (global.css), placed by the boxes measured below.
                turn =
                    paging &&
                    (screen(e.to) !== undefined ||
                        isPrivacy(e.to) ||
                        isPrivacy(e.from) ||
                        (isDetail(e.from) && isDetail(e.to)))
                        ? e.direction === "paging-back"
                            ? "back"
                            : "forward"
                        : null;
                // The outgoing box turns as a .page (a detail's is not one
                // otherwise; see turnBox).
                if (turn) {
                    turnBox(document)?.style.setProperty("view-transition-class", "page");
                    unbar(document);
                }
                // A turn between two pages of one archive (page numbers,
                // arrows, keys): only the grid turns. The bar holds still
                // above it (global.css), the current page number the one
                // change in it. Leaving the archive, it goes with the page.
                // Its page numbers are in it, not captured on their own: a
                // group of their own would morph between the old and new
                // rows (which differ in width), under the bar's background.
                still =
                    !!turn &&
                    isArchive(e.from) &&
                    isArchive(e.to) &&
                    screen(e.from) === screen(e.to);
                if (still) {
                    pin(document);
                    unnumber(document);
                }
                // A move to another set of page numbers (another screen, or
                // between all images and one event's, or two events'), not
                // between pages of one set: they go with their own page rather
                // than morph from one row into the other (which stretches
                // them). A set is its path less the page number.
                const numbers = (u: URL) => u.pathname.replace(/\/\d+\/?$/, "/").replace(/\/?$/, "/");
                crossing = numbers(e.from) !== numbers(e.to);
                if (crossing) unnumber(document);
                // Opening a picture or event from a grid (archive or
                // Featured), or closing back to it: only its own thumbnail and
                // title travel.
                // The others are left to fade with the page beneath it, rather
                // than captured on their own and painted over it.
                focus = isDetail(e.to) ? e.to.pathname : isDetail(e.from) ? e.from.pathname : null;
                // Any other move (off the row, or a detail by the nav): no
                // thumbnail travels, so matching flyers do not fly about.
                if (!paging) unname(document, focus ?? undefined);
                // Closing a picture back to its grid: global.css keeps the
                // crossfade there (the photograph opening rule is for opening
                // only). Set on both pages, as the root's attributes are
                // swapped mid-way.
                closing = !paging && !!focus && isDetail(e.from);
                document.documentElement.toggleAttribute("data-closing", closing);
            });

            const isPrivacy = (url: URL) => /^\/privacy\/?$/.test(url.pathname);
            let paging = false;
            let pagedDetail = false;
            let returning = false;
            let turn: "forward" | "back" | null = null;
            let focus: string | null = null;
            let closing = false;
            let crossing = false;
            let still = false;
            const unnumber = (root: ParentNode) =>
                root
                    .querySelectorAll<HTMLElement>('nav[aria-label="Pagination"]')
                    .forEach((el) => (el.style.viewTransitionName = "none"));
            // The images archive's filter bar is named so it morphs into a
            // picture's info strip; on a page turn it goes with its screen
            // instead, as every screen's title row does.
            const unbar = (root: ParentNode) =>
                root
                    .querySelectorAll<HTMLElement>(".gallery-filter")
                    .forEach((el) => (el.style.viewTransitionName = "none"));
            // The archive's bar (either archive's) held still over a turn
            // between its pages: named on its own, after unbar and fold have
            // taken its names off, so it is captured apart from the grid.
            const pin = (root: ParentNode) =>
                root
                    .querySelectorAll<HTMLElement>(":is(.gallery-filter, .archive-bar)")
                    .forEach((el) => (el.style.viewTransitionName = "archive-bar"));
            const bare = (path: string) => path.replace(/\/$/, "");
            // The named parts of grid thumbnails and of Featured (links
            // themselves, or the titles, pictures and rows around them).
            const gridNamed = (root: ParentNode) =>
                root.querySelectorAll<HTMLElement>(
                    ":is(.gallery-grid, .photo-grid) a, :is(.gallery-grid, .photo-grid, #featured) [data-astro-transition-scope]",
                );
            // Takes the names off them for one transition. With `keep`, those
            // that lead to it stay (the link they are in, or the first link they
            // hold), and so do parts with no link at all (the featured label).
            const unname = (root: ParentNode, keep?: string) =>
                gridNamed(root).forEach((el) => {
                    const link = el.closest("a") ?? el.querySelector("a");
                    const href = link?.getAttribute("href");
                    if (keep && (!href || bare(href) === bare(keep))) return;
                    el.style.viewTransitionName = "none";
                });
            // Named parts inside a named section (an event's flyer, title and
            // label) join the section's own picture for one transition; not
            // the event page's top bar, which stays put as the page turns.
            const fold = (root: ParentNode) =>
                root
                    .querySelectorAll<HTMLElement>("section[data-astro-transition-scope] [data-astro-transition-scope]:not(.detail-bar)")
                    .forEach((el) => (el.style.viewTransitionName = "none"));
            document.addEventListener("astro:before-swap", (e: any) => {
                if (paging) {
                    unname(e.newDocument);
                    fold(e.newDocument);
                    // An event's top bar is named featured-label on the
                    // featured event (to meet Featured's) and detail-bar on
                    // the rest, so Previous / Next between the two would fade
                    // one bar out and the other in: the incoming bar takes the
                    // outgoing one's name, and the bar holds still, only its
                    // label changing.
                    const was = document.querySelector<HTMLElement>(".detail-bar");
                    const bar = (e.newDocument as Document).querySelector<HTMLElement>(".detail-bar");
                    const name = was && getComputedStyle(was).viewTransitionName;
                    if (bar && name && name !== "none") bar.style.viewTransitionName = name;
                }
                // As on the outgoing page (before-preparation): another set
                // of page numbers goes with its page, and off a page turn only
                // the opened or closed thumbnail travels, the rest fading with
                // the page (closing back to an archive is always crossing).
                if (crossing) unnumber(e.newDocument);
                if (!paging) unname(e.newDocument, focus ?? undefined);
                if (closing) e.newDocument.documentElement.dataset.closing = "";
                // Paging onto a detail page: its rules do not draw in (global.css
                // keys on data-paged). Set here, before the swap, so the attribute
                // is already on the root when the new page's rules first get styled.
                if (pagedDetail) e.newDocument.documentElement.dataset.paged = "";
                // The new page's root attributes replace the current ones, so
                // this lasts until the next navigation.
                if (returning) e.newDocument.documentElement.dataset.returning = "";
                if (turn) {
                    // The incoming box turns as a .page too, and is the one
                    // global.css draws the seam's line on (.into: its group
                    // takes its classes, also when it holds both pages).
                    turnBox(e.newDocument)?.style.setProperty("view-transition-class", "page into");
                    unbar(e.newDocument);
                    if (still) {
                        pin(e.newDocument);
                        unnumber(e.newDocument);
                    }
                    // The outgoing screen, as captured for the slide (this
                    // runs before the swap). See seamShift.
                    const old = turnBox(document);
                    oldShift = seamShift(old);
                    oldTop = old?.getBoundingClientRect().top ?? 0;
                    oldName = old ? getComputedStyle(old).viewTransitionName : "";
                }
            });

            // What a page turn moves: a screen's main content (.vt-page: the
            // hero, Featured, an archive grid, About, Contact, Privacy), or on a

            // detail page the named piece that is the page (an event's
            // section, its parts folded into it; a picture). Run after fold,
            // so folded parts are not it.

            const turnBox = (root: ParentNode) =>
                root.querySelector<HTMLElement>(".vt-page") ??
                [
                    ...root.querySelectorAll<HTMLElement>(
                        ":is(.vt-detail, .vt-picture, .vt-photo)[data-astro-transition-scope]",
                    ),
                ].find((el) => el.style.viewTransitionName !== "none") ??
                null;
            // tan 32deg: how far the seam (rising at 58 degrees) leans
            // sideways per pixel of height.
            const SLANT = 0.6249;
            // global.css draws a page turn's seam relative to each snapshot's
            // own box, assuming it is centred on the screen. A box that is not
            // (an archive grid sits lower than the hero, and below xl runs on
            // past the screen) needs this added to keep the outgoing and
            // incoming edges one line: minus its centre's offset right of the
            // screen's centre, and the seam's lean over its centre's offset
            // below it.
            const seamShift = (el: Element | null) => {
                if (!el) return "0px";
                const r = el.getBoundingClientRect();
                const dx = r.left + r.width / 2 - innerWidth / 2;
                const dy = r.top + r.height / 2 - innerHeight / 2;
                return `${-(dx + SLANT * dy)}px`;
            };
            let oldShift = "0px";
            // Where the outgoing grid's top was, so global.css can keep it
            // there when the incoming one sits lower (the images archive has
            // its filter bar above the grid).
            let oldTop = 0;
            // Only when the two grids are one group (archive to archive): any
            // other outgoing screen has a group of its own, already where it
            // was, and moving it would make it jump as the turn starts.
            let oldName = "";

            // Kept in sessionStorage so a reload keeps the close destination.
            let closeTo: string | null = null;
            try {
                closeTo = sessionStorage.getItem("closeTo");
            } catch {}

            // A detail page's close button goes back to where it was opened
            // (otherwise its archive, as built).
            document.addEventListener("astro:page-load", () => {
                if (!closeTo) return;
                document
                    .querySelectorAll<HTMLAnchorElement>("a[data-close]")
                    .forEach((a) => (a.href = closeTo!));
            });


            document.addEventListener("astro:after-swap", () => {
                // Each page turn's seam offsets (see seamShift): the root's
                // attributes were just replaced, so set again on every turn.
                if (turn) {
                    const root = document.documentElement.style;
                    root.setProperty("--turn-old-shift", oldShift);
                    const box = turnBox(document);
                    root.setProperty("--turn-new-shift", seamShift(box));
                    const newTop = box?.getBoundingClientRect().top ?? oldTop;
                    const shared = !!box && getComputedStyle(box).viewTransitionName === oldName;
                    root.setProperty("--turn-old-dy", shared ? `${oldTop - newTop}px` : "0px");
                }
            });
        </script>
    </body>
</html>
