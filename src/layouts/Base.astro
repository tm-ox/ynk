---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Logo from "../components/Logo.astro";
import Settings from "../components/Settings.astro";
import { GoogleAnalytics } from "astro-google-analytics";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object | object[];
}

const siteName = "Yes No Klub";
const defaultDescription =
  "Yes No Klub - Experimental etc. event organiser out of Yogyakarta, Indonesia.";
const { title, description = defaultDescription, image, jsonLd } = Astro.props;
const fullTitle = title
  ? `${title} – ${siteName}`
  : `${siteName} – Experimental etc., Yogyakarta`;
// Thumbnail look at rest: "" (full colour, default) or "duotone" (two-tone of
// the theme, colour on hover). Change this one word to try it site-wide.
const thumbs: "" | "duotone" = "";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? "/og-default.jpg", Astro.site).href;
---

<html lang="en" data-thumbs={thumbs || undefined}>
    <head>
        <meta charset="utf-8" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <!-- Meta/manifest colours can't use CSS variables: dark theme values.
             theme-color is kept in sync with --color-bg by the script below. -->
        <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#03c91d" />
        <meta name="msapplication-TileColor" content="#041b1b" />
        <meta name="theme-color" content="#041b1b" />
        <!-- Thumbnail duotone: set `thumbs` in the frontmatter above to "duotone". -->
        <script is:inline>
            (function () {
                var root = document.documentElement;
                var stored = function () {
                    try {
                        var t = localStorage.getItem("theme");
                        return t === "light" || t === "dark" ? t : null;
                    } catch (e) {
                        return null;
                    }
                };
                var syncMeta = function () {
                    var m = document.querySelector('meta[name="theme-color"]');
                    if (m) m.content = getComputedStyle(root).backgroundColor;
                };
                window.__applyTheme = function (theme, doc) {
                    (doc || document).documentElement.setAttribute("data-theme", theme);
                    if (!doc && document.readyState === "complete") syncMeta();
                };
                // choice: "system" (follow the device), "light" or "dark".
                window.__setTheme = function (choice) {
                    try {
                        if (choice === "system") localStorage.removeItem("theme");
                        else localStorage.setItem("theme", choice);
                    } catch (e) {}
                    if (choice === "system") root.removeAttribute("data-theme");
                    else root.setAttribute("data-theme", choice);
                    syncMeta();
                };
                window.__storedTheme = function () {
                    return stored() || "system";
                };
                if (stored()) window.__applyTheme(stored());
                window.addEventListener("load", syncMeta);
                document.addEventListener("astro:before-swap", function (e) {
                    if (stored()) window.__applyTheme(stored(), e.newDocument);
                });
                document.addEventListener("astro:after-swap", syncMeta);
            })();
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{fullTitle}</title>
        <meta name="title" content={fullTitle} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonical} />
        <meta property="twitter:title" content={fullTitle} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ogImage} />
        {
            jsonLd && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
                />
            )
        }
        <Font
            cssVariable="--font-biorhyme-expanded"
            preload={[
                { subset: "latin", style: "normal", weight: 700 },
                { subset: "latin", style: "normal", weight: 800 },
            ]}
        />
        <Font cssVariable="--font-biorhyme" />
        <Font
            cssVariable="--font-pathway-extreme"
            preload={[{ subset: "latin", style: "normal", weight: 300 }]}
        />
        <!-- Extras a page wants in the head (neighbour pictures to prefetch). -->
        <slot name="head" />
        <ClientRouter />
        <GoogleAnalytics id="G-T32SXCFCXD" />
        <!-- Google tag (gtag.js) -->
        <!-- <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-T32SXCFCXD"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-T32SXCFCXD");
    </script> -->
    </head>
    <body>
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-(--z-overlay) focus:bg-bg focus:p-2"
            >Skip to content</a
        >
        <header>
            <nav aria-label="Main">
                <Logo />
                <slot name="nav" transition:persist />
                <Settings />
            </nav>
        </header>
        <main id="main">
            <slot />
        </main>
        <footer class="flex items-center justify-center h-footer">
            <a
                href="/privacy"
                class="text-xs tracking-wide uppercase font-displayCon text-accent-muted hover:text-accent"
                >Privacy</a
            >
        </footer>
    <script>
            import { bindWheelPager } from "../scripts/wheel-pager";
            // Keyboard paging, scrolling and Escape (binds itself once on import).
            import "../scripts/keys";
            import { panelsOf, seamShift } from "../scripts/track";

            const link = (label: string) =>
                document.querySelector<HTMLAnchorElement>(`a[aria-label="${label}"]`);

            // Detail pages (events, photos): the wheel follows Next / Previous.
            // Not on the home page, where the panel track pages instead.
            bindWheelPager({
                root: () =>
                    !document.querySelector("[data-track]") &&
                    (link("Next") || link("Previous"))
                        ? document.documentElement
                        : null,
                canStep: (dir) => !!link(dir > 0 ? "Next" : "Previous"),
                step: (dir) => link(dir > 0 ? "Next" : "Previous")?.click(),
            });

            // Paging between neighbours (Previous / Next, by click, key or wheel)
            // wipes, and so do page numbers and moves between home and the
            // archives (below). Everything else keeps the morph. The custom
            // direction value is what global.css keys the wipe on.
            document.addEventListener("astro:before-preparation", (e: any) => {
                const label = e.sourceElement
                    ?.closest?.("a")
                    ?.getAttribute("aria-label");
                if (label === "Previous") e.direction = "paging-back";
                else if (label === "Next") e.direction = "paging-forward";
                // Page numbers wipe too, by which way the target page lies.
                // The page you are already on keeps Astro's default.
                if (e.sourceElement?.closest?.('nav[aria-label="Pagination"]')) {
                    const page = (u: URL) =>
                        Number(u.pathname.match(/\/(\d+)\/?$/)?.[1] ?? 1);
                    if (page(e.to) !== page(e.from))
                        e.direction =
                            page(e.to) > page(e.from)
                                ? "paging-forward"
                                : "paging-back";
                }
                // Home and the archives are one row of screens: the home
                // panels left to right, then the events archive, then the
                // images archive (an event's pictures included), as the nav
                // and the arrow keys have them. A move between two of them
                // that are different pages turns the page that way, like
                // page numbers do. (Within home it is a scroll, not a
                // navigation, so which home panel is involved never decides
                // anything: every one of them comes before both archives.)
                // Details are not in the row and keep the morph.
                const screen = (url: URL) =>
                    url.pathname === "/"
                        ? 0
                        : /^\/events(\/(\d+\/?)?)?$/.test(url.pathname)
                          ? 1
                          : /^\/images(\/(\d+\/?)?)?$/.test(url.pathname) ||
                              /^\/images\/event\/[^/]+(\/(\d+\/?)?)?$/.test(url.pathname)
                            ? 2
                            : undefined;
                const from = screen(e.from);
                const to = screen(e.to);
                if (
                    !e.direction?.startsWith("paging") &&
                    from !== undefined &&
                    to !== undefined &&
                    from !== to
                )
                    e.direction = to > from ? "paging-forward" : "paging-back";
                paging = !!e.direction && e.direction.startsWith("paging");
                // Names taken off for the last transition (see unname and
                // fold) come back first, so any of them can travel this time.
                document
                    .querySelectorAll<HTMLElement>('[style*="view-transition-name"]')
                    .forEach((el) => (el.style.viewTransitionName = ""));
                // Pages wipe as a whole, under one edge: the titles and
                // thumbnails in grid cards, and the flyer, title and label
                // inside an event, must not be captured separately.
                if (paging) {
                    unname(document);
                    fold(document);
                }

                // Remember where a detail page was opened from, so its close
                // button returns there: the home panel for pages reached from
                // home, otherwise the archive page (and its grid position).
                // Paging between details keeps it; anything else clears it.
                const isDetail = (url: URL) =>
                    /^\/(events|images)\/(?!\d+\/?$)[^/]+\/?$/.test(
                        url.pathname,
                    );
                // Slashless group URLs (typed by hand) count too.
                const isArchive = (url: URL) =>
                    /^\/(events|images)(\/(\d+\/?)?)?$/.test(url.pathname) ||
                    /^\/images\/event\/[^/]+(\/(\d+\/?)?)?$/.test(url.pathname);
                // Leaving the home page remembers the panel in view, so closing
                // out of an archive or detail page lands back on it.
                if (e.from.pathname === "/" && e.to.pathname !== "/") {
                    // From the track's own scroll position where the panels are
                    // side by side (exact); otherwise the nav's active link.
                    const track = document.querySelector<HTMLElement>("[data-track]");
                    const panel =
                        (track && matchMedia("(min-width: 40rem)").matches
                            ? panelsOf(track)[Math.round(track.scrollLeft / track.clientWidth)]?.id
                            : undefined) ||
                        document.querySelector<HTMLElement>("#main-nav a.active[data-section]")?.dataset.section;
                    if (panel) {
                        homePanel = panel;
                        try {
                            sessionStorage.setItem("homePanel", panel);
                        } catch {}
                    }
                }
                // Back / forward keeps whatever was remembered.
                if (e.navigationType !== "traverse") {
                    if (isDetail(e.to) && e.from.pathname === "/")
                        closeTo = "home";
                    else if (isDetail(e.to) && isArchive(e.from))
                        closeTo = e.from.pathname + e.from.search;
                    else if (!(isDetail(e.from) && isDetail(e.to)))
                        closeTo = null;
                    try {
                        if (closeTo) sessionStorage.setItem("closeTo", closeTo);
                        else sessionStorage.removeItem("closeTo");
                    } catch {}
                }

                homeHash = e.to.pathname === "/" ? e.to.hash : "";
                // Coming back to an archive from one of its pictures or events
                // (close or back): the grid was already seen, so its thumbnails
                // do not rise in again (global.css keys on data-returning).
                // Page turns set it too: the grid slides in and wipes instead.
                returning = (isDetail(e.from) || paging) && isArchive(e.to);
                // A page turn onto an archive or home: the seam crosses the
                // two snapshots (global.css), placed by the boxes measured
                // below. Not for Previous / Next between details, which keep
                // their own wipe.
                turn =
                    paging && (isArchive(e.to) || e.to.pathname === "/")
                        ? e.direction === "paging-back"
                            ? "back"
                            : "forward"
                        : null;
                // A turn between screens (home, events, images), not between
                // pages of one archive: the page numbers are another set, so
                // they go with their own grid rather than morph from one row
                // into the other (which stretches them).
                crossing =
                    !!turn && e.from.pathname.split("/")[1] !== e.to.pathname.split("/")[1];
                if (crossing) unnumber(document);
                // Opening a picture or event from a grid (archive or home), or
                // closing back to it: only its own thumbnail and title travel.
                // The others are left to fade with the page beneath it, rather
                // than captured on their own and painted over it.
                focus = isDetail(e.to) ? e.to.pathname : isDetail(e.from) ? e.from.pathname : null;
                // Any other move (between archives, home and an archive): no
                // thumbnail travels, so matching flyers do not fly about.
                if (!paging) unname(document, focus ?? undefined);
                // Closing a picture back to its grid: global.css keeps the
                // crossfade there (the photograph opening rule is for opening
                // only). Set on both pages, as the root's attributes are
                // swapped mid-way.
                closing = !paging && !!focus && isDetail(e.from);
                document.documentElement.toggleAttribute("data-closing", closing);
            });

            let paging = false;
            let returning = false;
            let turn: "forward" | "back" | null = null;
            let focus: string | null = null;
            let closing = false;
            let crossing = false;
            const unnumber = (root: ParentNode) =>
                root
                    .querySelectorAll<HTMLElement>('nav[aria-label="Pagination"]')
                    .forEach((el) => (el.style.viewTransitionName = "none"));
            const bare = (path: string) => path.replace(/\/$/, "");
            // The named parts of grid thumbnails and of the home featured panel
            // (links themselves, or the titles, pictures and rows around them).
            const gridNamed = (root: ParentNode) =>
                root.querySelectorAll<HTMLElement>(
                    ":is(.gallery-grid, .photo-grid) a, :is(.gallery-grid, .photo-grid, #events) [data-astro-transition-scope]",
                );
            // Takes the names off them for one transition. With `keep`, those
            // that lead to it stay (the link they are in, or the first link they
            // hold), and so do parts with no link at all (the featured label).
            const unname = (root: ParentNode, keep?: string) =>
                gridNamed(root).forEach((el) => {
                    const link = el.closest("a") ?? el.querySelector("a");
                    const href = link?.getAttribute("href");
                    if (keep && (!href || bare(href) === bare(keep))) return;
                    el.style.viewTransitionName = "none";
                });
            // Named parts inside a named section (an event's flyer, title and
            // label) join the section's own picture for one transition.
            const fold = (root: ParentNode) =>
                root
                    .querySelectorAll<HTMLElement>("section[data-astro-transition-scope] [data-astro-transition-scope]")
                    .forEach((el) => (el.style.viewTransitionName = "none"));
            document.addEventListener("astro:before-swap", (e: any) => {
                if (paging) {
                    unname(e.newDocument);
                    fold(e.newDocument);
                }
                if (crossing) unnumber(e.newDocument);
                else unname(e.newDocument, focus ?? undefined);
                if (closing) e.newDocument.documentElement.dataset.closing = "";
                // The new page's root attributes replace the current ones, so
                // this lasts until the next navigation.
                if (returning) e.newDocument.documentElement.dataset.returning = "";
                if (turn) {
                    // Which group the incoming page is, so global.css draws
                    // the seam's line on it.
                    e.newDocument.documentElement.dataset.turnInto =
                        e.newDocument.querySelector("[data-track]") ? "home" : "gallery-page";
                    // The outgoing screen, as captured for the slide (this
                    // runs before the swap). See seamShift.
                    oldShift = seamShift(document.querySelector(".vt-page"));
                    oldTop = document.querySelector(".vt-page")?.getBoundingClientRect().top ?? 0;
                }
            });

            let oldShift = "0px";
            // Where the outgoing grid's top was, so global.css can keep it
            // there when the incoming one sits lower (the images archive has
            // its filter bar above the grid).
            let oldTop = 0;

            // Kept in sessionStorage so a reload keeps the close destination.
            let closeTo: string | null = null;
            try {
                closeTo = sessionStorage.getItem("closeTo");
            } catch {}
            let homeHash = "";
            // The home panel last in view; "Back to home" and the close
            // buttons return to it.
            let homePanel: string | null = null;
            try {
                homePanel = sessionStorage.getItem("homePanel");
            } catch {}

            document.addEventListener("astro:page-load", () => {
                const home = `/#${homePanel ?? "events"}`;
                document
                    .querySelectorAll<HTMLAnchorElement>('a[aria-label="Back to home"]')
                    .forEach((a) => (a.href = home));
                if (!closeTo) return;
                document
                    .querySelectorAll<HTMLAnchorElement>("a[data-close]")
                    .forEach((a) => {
                        a.href = closeTo === "home" ? home : closeTo!;
                    });
            });

            // Arriving on the home page with a #section: place the horizontal
            // track there before the new page is shown, so it does not slide
            // in from the first panel.
            document.addEventListener("astro:after-swap", () => {
                // Each page turn's seam offsets (see seamShift): the root's
                // attributes were just replaced, so set again on every turn.
                if (turn) {
                    const root = document.documentElement.style;
                    root.setProperty("--turn-old-shift", oldShift);
                    root.setProperty(
                        "--turn-new-shift",
                        seamShift(document.querySelector(".vt-page")),
                    );
                    const newTop = document.querySelector(".vt-page")?.getBoundingClientRect().top ?? oldTop;
                    root.setProperty("--turn-old-dy", `${oldTop - newTop}px`);
                }
                const t = document.querySelector<HTMLElement>("[data-track]");
                const target = homeHash && document.getElementById(homeHash.slice(1));
                if (!t || !target || !matchMedia("(min-width: 40rem)").matches)
                    return;
                const index = panelsOf(t).indexOf(target as HTMLElement);
                if (index >= 0)
                    t.scrollTo({ left: index * t.clientWidth, behavior: "instant" });
            });
        </script>
    </body>
</html>
