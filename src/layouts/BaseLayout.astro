---
import Hamburger from "../components/Hamburger.astro";
import "../styles/global.css";
import Base from "./Base.astro";
import Sosmed from "../components/Sosmed.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { EVENTS_PER_PAGE, IMAGES_PER_PAGE, getGalleryImages } from "../utils/events";
import { ROW, pageOf, screenOf } from "../utils/row";

const { title, description, image, jsonLd, bleed } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove the first "/"
const isHome = currentPath === "";
const isCurrent = (name: string) =>
    currentPath === name || currentPath.startsWith(`${name}/`);
// How many pages each screen of the row has: one, or an archive's count.
const pages: Record<string, number> = {
    events: Math.max(1, Math.ceil((await getCollection("events")).length / EVENTS_PER_PAGE)),
    images: Math.max(1, Math.ceil((await getGalleryImages()).length / IMAGES_PER_PAGE)),
};
const pagesOf = (name: string) => pages[name] ?? 1;
// The position line under the header (.position, below): the whole row of
// screens (utils/row.ts), each archive counting each of its pages. Detail
// pages, privacy and 404 are not in the row and have no line.
const screens = ROW.reduce((n, s) => n + pagesOf(s.name), 0);
const screen = screenOf(pathname);
const screenIndex =
    screen === undefined
        ? null
        : ROW.slice(0, screen).reduce((n, s) => n + pagesOf(s.name), 0) + pageOf(pathname) - 1;
// One run of links, in the row's order. An archive's carries its last page:
// stepping back from the next screen (keys, wheel) lands there, so the pages
// run in order (scripts/step.ts).
const links = ROW.map((s, i) => ({
    label: s.label,
    href: s.href,
    section: s.name,
    current: i === 0 ? isHome : isCurrent(s.name),
    last: s.paged ? (pagesOf(s.name) > 1 ? `${s.href}${pagesOf(s.name)}/` : s.href) : undefined,
}));

---

<Base title={title} description={description} image={image} jsonLd={jsonLd} bleed={bleed}>
    <div slot="nav" class="flex items-center justify-center w-full">
        <Hamburger />
        <div
            id="main-nav"
            class="absolute top-full left-0 ml-auto justify-center hidden w-full overflow-y-auto overscroll-contain max-sm:flex-col sm:flex sm:w-auto sm:h-auto sm:overflow-visible sm:relative sm:top-auto main-nav bg-scrim-heavy sm:bg-transparent"
        >
            <!-- Phones: the open menu is a panel from the header rule down, set
                 left in the page's gutter as everything else is: the links at
                 its top, as wide as the gutters allow, the social icons and
                 the footer line at its foot. Above the links, on a row of its
                 own, the Settings cog, which on phones lives here rather
                 than in the header (Settings.astro hides that one below sm):
                 at the right, its edge under the menu button's. Settings
                 opens over the open menu, which is still there when it
                 closes (Esc closes Settings first: Hamburger.astro). -->
            <ul
                class="flex flex-col items-stretch text-left max-sm:grow max-sm:shrink-0 max-sm:px-gutter max-sm:pt-2 sm:my-auto sm:items-center sm:flex-row sm:gap-x-3"
            >
                <li class="flex justify-end sm:hidden">
                    <button
                        type="button"
                        class="flex items-center justify-end w-10 h-10 cursor-pointer"
                        data-settings-open
                        aria-label="Settings"
                        aria-haspopup="dialog"
                    >
                        <Icon name="bx:bxs-cog" class="w-6 h-6 icon" />
                    </button>
                </li>
                {
                    links.map((link) => (
                        <li transition:name={`nav-${link.section}`}>
                            <a
                                class:list={["max-sm:block sm:relative sm:top-[2px]", link.current && "active"]}
                                aria-current={link.current ? "true" : undefined}
                                href={link.href}
                                data-section={link.section}
                                data-last={link.last}
                                target="_self">{link.label}</a
                            >
                        </li>
                    ))
                }
                <li class="max-sm:mt-auto max-sm:pt-4" transition:name="nav-social">
                    <Sosmed />
                </li>
                <!-- Phones only: the footer line (Base.astro hides the footer
                     there), small and quiet under the social icons, centred
                     in the --menu-foot between them and the panel's foot: ©
                     at the left, Privacy at the right, on one baseline. -->
                <li class="flex items-center h-(--menu-foot) text-xs tracking-wide uppercase sm:hidden font-displayCon text-accent-muted">
                    <div class="flex items-baseline justify-between w-full">
                        <span>© 2010–{new Date().getFullYear()} Yes No Klub</span>
                        <a href="/privacy" class="w-auto text-xs" target="_self">Privacy</a>
                    </div>
                </li>
            </ul>
            <!-- The line that rides the panel's edge as it opens and closes. -->
            <span class="sweep-seam" aria-hidden="true" hidden data-menu-seam><span></span></span>
        </div>
    </div>
    <slot name="head" slot="head" />
    {
        screenIndex !== null && (
            <div
                slot="rule"
                class="position"
                data-position
                aria-hidden="true"
                style={`--i:${screenIndex};--n:${screens}`}
                transition:name="position"
            />
        )
    }
    <slot />
</Base>


<script>
    import { ROW } from "../utils/row";

    // Marks the nav link for the screen the page belongs to: its own, or for
    // a detail page its archive's. The nav is persisted across transitions
    // (its markup is not swapped), so this runs on every page load.
    const setActive = (id: string | null) => {
        document
            .querySelectorAll<HTMLAnchorElement>("#main-nav a[data-section]")
            .forEach((a) => {
                const on = a.dataset.section === id;
                a.classList.toggle("active", on);
                if (on) a.setAttribute("aria-current", "true");
                else a.removeAttribute("aria-current");
            });
    };

    // Bound once (module scripts are not re-run by the router).
    document.addEventListener("astro:page-load", () => {
        const path = location.pathname;
        const first = path.split("/")[1];
        setActive(path === "/" ? ROW[0].name : (ROW.find((s) => s.name === first)?.name ?? null));
    });
</script>


<style>
    @reference "../styles/global.css";
    /* A segment lying on the header's bottom rule (.frame-rule, Base.astro),
       showing where this screen sits in the whole row. It keeps to --track,
       the nav's own width: the whole rule from sm up, and on phones, where
       the rule runs edge to edge, the gutter in from each side (the gutter
       less the rule's own --rule-inset, global.css). Knobs: --position-min is its narrowest width (it is 1/n of the
       track otherwise, which gets thin on a long row); --position-color is
       its colour. Its left edge runs from the track's start to its end as
       --i goes from 0 to n - 1 (both set at build, above). It is named, so a page turn

       morphs it from the old place to the new on the morph's own tempo. At
       every size: phones have the same rule under the same header. It lies
       inside the rule (Base.astro), so it stays on it as the page scrolls. */
    .position {
        --position-min: 2rem;
        /* Brighter and thicker than the rule it lies on, which is the accent
           at 1px: the same colour and weight would not show. */
        --position-color: var(--color-accent-hover);
        --position-weight: 3px;
        --pad: calc(var(--spacing-gutter) - var(--rule-inset));
        --track: calc(100% - 2 * var(--pad));
        --w: max(calc(var(--track) / var(--n)), var(--position-min));
        position: absolute;
        /* Centred on the 1px rule. */
        top: calc((var(--position-weight) - 1px) / -2);
        left: calc(var(--pad) + (var(--track) - var(--w)) * var(--i) / (var(--n) - 1));
        width: var(--w);
        height: var(--position-weight);
        background: var(--position-color);
        /* Its ends cut at the logo's angle, as the page turn's seam. */
        clip-path: polygon(
            calc(var(--position-weight) * 0.625) 0,
            100% 0,
            calc(100% - var(--position-weight) * 0.625) 100%,
            0 100%
        );
        pointer-events: none;
    }
    /* The phone menu's panel: from the header's foot (the rule lies on its
       top edge) to the screen's. It opens and closes like a page turn
       (Hamburger.astro, scripts/sweep.ts): --menu-sweep is how long the edge
       takes to cross it, --menu-fade how long it fades instead with reduced
       motion. */
    .main-nav {
        --menu-sweep: 0.45s;
        --menu-fade: 0.2s;
    }
    @media (width < 40rem) {
        .main-nav {
            height: calc(100vh - var(--spacing-header));
            height: calc(100dvh - var(--spacing-header));
        }
        /* The links' width is the list's (the panel less its gutters), so
           their size can be a share of it (cqw). */
        .main-nav ul {
            container-type: inline-size;
        }
        /* The links, as large as fits: "FEATURED", the longest, runs gutter
           to gutter. It is 6.477em wide in BioRhyme at 800 (advance widths
           from the font file, no tracking), so 100cqw / 6.477 would touch
           both gutters; --menu-size is 2% under that so it never wraps.
           --menu-leading sets the rows tight, about 0.95 of the 0.686em cap
           height, but never under --menu-target, the least tap height. A
           longer label in utils/row.ts needs --menu-size measured again. */
        .main-nav {
            --menu-size: calc(100cqw / 6.477 * 0.98);
            --menu-leading: 0.65em;
            --menu-target: 40px;
            /* What the footer line has under the social icons, its middle
               the line's. */
            --menu-foot: calc(var(--spacing) * 12);
        }
        .main-nav a[data-section] {
            font-size: var(--menu-size);
            font-weight: 800;
            letter-spacing: 0;
            line-height: max(var(--menu-leading), var(--menu-target));
            white-space: nowrap;
        }
    }
    .main-nav a {
        @apply text-accent-muted hover:text-accent;
    }
    .main-nav a.active {
        @apply text-accent;
    }
    .expanded {
        @apply flex;
    }
</style>
