---
import Hamburger from "../components/Hamburger.astro";
import "../styles/global.css";
import Base from "./Base.astro";
import Sosmed from "../components/Sosmed.astro";

const { title, description, image, jsonLd } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove the first "/"
const isHome = currentPath === "";
const isCurrent = (name: string) =>
    currentPath === name || currentPath.startsWith(`${name}/`);
---

<Base title={title} description={description} image={image} jsonLd={jsonLd}>
    <div slot="nav" class="flex items-center justify-center w-full">
        <slot name="subnav" transition:persist />
        <Hamburger />
        <div
            id="main-nav"
            class="absolute top-0 left-0 ml-auto justify-center hidden w-full h-screen sm:flex sm:w-auto sm:h-auto sm:relative main-nav bg-scrim-heavy sm:bg-transparent"
        >
            <ul
                class="flex flex-col items-center justify-center text-center sm:flex-row sm:gap-x-3"
            >
                {
                    isHome ? (
                        <li class="sm:hidden">
                            <hr class="sm:hidden" />
                            <a class="active" aria-current="page" href="/" target="_self">
                                Yes No Klub
                            </a>
                        </li>
                    ) : (
                        <li>
                            <hr class="sm:hidden" />
                            <a href="/" target="_self">Home</a>
                            <hr class="sm:hidden" />
                        </li>
                    )
                }
                {
                    isHome && (
                        <>
                <li>
                    <hr class="sm:hidden" />
                    <a href="/#about" data-section="about" target="_self">About</a>
                    <hr class="sm:hidden" />
                </li>
                <li>
                    <a
                        class={isCurrent("events") ? "active" : ""}
                        aria-current={isCurrent("events") ? "true" : undefined}
                        href="/#events"
                        data-section="events"
                        target="_self">Events</a
                    >
                    <hr class="sm:hidden" />
                </li>
                <li>
                    <a
                        class={isCurrent("images") ? "active" : ""}
                        aria-current={isCurrent("images") ? "true" : undefined}
                        href="/#images"
                        data-section="images"
                        target="_self">Images</a
                    >
                    <hr class="sm:hidden" />
                </li>
                <li>
                    <a href="/#contact" data-section="contact" target="_self">Contact</a>
                    <hr class="sm:hidden" />
                </li>
                        </>
                    )
                }
                <li>
                    <Sosmed />
                </li>
            </ul>
        </div>
    </div>
    <slot />
</Base>

<script>
    // Marks the nav link for the section in view on the home page, and the
    // events/images links on their own routes. The nav is persisted across
    // transitions, so this runs on every page load.
    let observer: IntersectionObserver | undefined;

    const setActive = (id: string | null) => {
        document
            .querySelectorAll<HTMLAnchorElement>("#main-nav a[data-section]")
            .forEach((a) => {
                const on = a.dataset.section === id;
                a.classList.toggle("active", on);
                if (on) a.setAttribute("aria-current", "true");
                else a.removeAttribute("aria-current");
            });
    };

    document.addEventListener("astro:page-load", () => {
        observer?.disconnect();
        const path = location.pathname;
        if (path === "/") {
            observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) setActive(entry.target.id);
                    }
                },
                {
                    // Panels sit side by side from sm up, stacked below it.
                    rootMargin: matchMedia("(min-width: 40rem)").matches
                        ? "0px -45% 0px -45%"
                        : "-45% 0px -45% 0px",
                },
            );
            document
                .querySelectorAll("main section[id]")
                .forEach((section) => observer!.observe(section));
        } else {
            setActive(
                path.startsWith("/events")
                    ? "events"
                    : path.startsWith("/images")
                      ? "images"
                      : null,
            );
        }
    });
</script>

<style>
    @reference "../styles/global.css";
    .main-nav a {
        @apply text-accent-muted hover:text-accent;
    }
    .main-nav a.active {
        @apply text-accent;
    }
    .expanded {
        @apply flex;
    }
</style>
