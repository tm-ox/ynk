---
import Hamburger from "../components/Hamburger.astro";
import "../styles/global.css";
import Base from "./Base.astro";
import Sosmed from "../components/Sosmed.astro";
import { getCollection } from "astro:content";
import { EVENTS_PER_PAGE, IMAGES_PER_PAGE, HOME_PANELS, getGalleryImages } from "../utils/events";

const { title, description, image, jsonLd } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove the first "/"
const isHome = currentPath === "";
const isCurrent = (name: string) =>
    currentPath === name || currentPath.startsWith(`${name}/`);
// The archives' last pages: stepping back from the next screen (keys) lands
// there, so the pages run in order (scripts/keys.ts).
const eventsPages = Math.max(1, Math.ceil((await getCollection("events")).length / EVENTS_PER_PAGE));
const eventsLast = eventsPages > 1 ? `/events/${eventsPages}/` : "/events/";
// The position line under the header (scripts/position.ts): the whole row of
// screens is the home panels, then the events pages, then the images pages,
// then About and Contact. Detail pages, privacy and 404 are not in the row and
// have no line.
const imagesPages = Math.max(1, Math.ceil((await getGalleryImages()).length / IMAGES_PER_PAGE));
const imagesLast = imagesPages > 1 ? `/images/${imagesPages}/` : "/images/";
const screens = HOME_PANELS + eventsPages + imagesPages + 2;
const pageNo = Number(pathname.match(/^\/(?:events|images)\/(\d+)\/?$/)?.[1] ?? 1);
const screenIndex =
    isHome ? 0
    : /^\/events(\/(\d+\/?)?)?$/.test(pathname) ? HOME_PANELS + pageNo - 1
    // An event's own gallery counts as the images archive's first page.
    : /^\/images(\/(\d+\/?)?)?$/.test(pathname) || /^\/images\/event\//.test(pathname)
      ? HOME_PANELS + eventsPages + (pathname.startsWith("/images/event/") ? 0 : pageNo - 1)
    : /^\/about\/?$/.test(pathname) ? HOME_PANELS + eventsPages + imagesPages
    : /^\/contact\/?$/.test(pathname) ? HOME_PANELS + eventsPages + imagesPages + 1
    : null;
// One run of links, in the row's order: the home panels, the archives, then
// About and Contact.
const links = [
    { label: "Home", href: isHome ? "/#top" : "/", section: "top", current: false },
    { label: "Featured", href: "/#events", section: "events", current: false },
    { label: "Events", href: "/events/", section: "events-page", current: isCurrent("events"), last: eventsLast },
    { label: "Images", href: "/images/", section: "images-page", current: isCurrent("images"), last: imagesLast },
    { label: "About", href: "/about/", section: "about", current: isCurrent("about") },
    { label: "Contact", href: "/contact/", section: "contact", current: isCurrent("contact") },
];
---

<Base title={title} description={description} image={image} jsonLd={jsonLd}>
    <div slot="nav" class="flex items-center justify-center w-full">
        <div class="contents sm:hidden"><slot name="subnav" /></div>
        <Hamburger />
        <div
            id="main-nav"
            class="absolute top-0 left-0 ml-auto justify-center hidden w-full h-viewport overflow-y-auto sm:flex sm:w-auto sm:h-auto sm:overflow-visible sm:relative main-nav bg-scrim-heavy sm:bg-transparent"
        >
            <ul
                class="flex flex-col items-center my-auto text-center sm:flex-row sm:gap-x-3"
            >
                {
                    links.map((link, i) => (
                        <li transition:name={`nav-${link.section}`}>
                            {i === 0 && <hr class="sm:hidden" />}
                            <a
                                class:list={["sm:relative sm:top-[2px]", link.current && "active"]}
                                aria-current={link.current ? "true" : undefined}
                                href={link.href}
                                data-section={link.section}
                                data-last={link.last}
                                target="_self">{link.label}</a
                            >
                            <hr class="sm:hidden" />
                        </li>
                    ))
                }
                {Astro.slots.has("subnav") && (
                <li class="hidden sm:flex w-auto items-center [&>div]:my-0 [&>div]:-mr-1 [&>div]:ml-1 [&>div]:after:hidden [&>div]:pl-2.5 [&>div]:pr-0" transition:name="nav-subnav">
                    <slot name="subnav" />
                </li>
                )}
                <li transition:name="nav-social">
                    <Sosmed />
                </li>
            </ul>
        </div>
    </div>
    <slot name="head" slot="head" />
    {
        screenIndex !== null && (
            <div
                class="position"
                data-position
                aria-hidden="true"
                style={`--i:${screenIndex};--n:${screens}`}
                transition:name="position"
            />
        )
    }
    <slot />
</Base>

<script>
    import "../scripts/position";
</script>

<script>
    // Marks the nav link for the panel in view on the home page, and the
    // events/images links on their own routes (archives and detail pages), and
    // About and Contact on their pages. Only the theme is persisted
    // across transitions, so this runs on every page load.
    let observer: IntersectionObserver | undefined;
    // Panels sit side by side from sm up, stacked below it.
    const wide = matchMedia("(min-width: 40rem)");

    const setActive = (id: string | null) => {
        document
            .querySelectorAll<HTMLAnchorElement>("#main-nav a[data-section]")
            .forEach((a) => {
                const on = a.dataset.section === id;
                a.classList.toggle("active", on);
                if (on) a.setAttribute("aria-current", "true");
                else a.removeAttribute("aria-current");
            });
    };

    const observe = () => {
        observer?.disconnect();
        observer = undefined;
        const path = location.pathname;
        if (path === "/") {
            observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) setActive(entry.target.id);
                    }
                },
                {
                    rootMargin: wide.matches
                        ? "0px -45% 0px -45%"
                        : "-45% 0px -45% 0px",
                },
            );
            document
                .querySelectorAll("main section[id]")
                .forEach((section) => observer!.observe(section));
        } else {
            // Inner pages: the archive (or detail page) the route belongs to,
            // or About and Contact.
            setActive(
                path.startsWith("/events") ? "events-page"
                : path.startsWith("/images") ? "images-page"
                : /^\/about\/?$/.test(path) ? "about"
                : /^\/contact\/?$/.test(path) ? "contact"
                : null,
            );
        }
    };

    // Bound once (module scripts are not re-run by the router).
    document.addEventListener("astro:page-load", observe);
    // The layout flips when the viewport crosses sm: re-create the observer.
    wide.addEventListener("change", observe);
</script>

<style>
    @reference "../styles/global.css";
    /* A segment lying on the header's bottom rule (.frame-rule, Base.astro),
       showing where this screen sits in the whole row. Knobs: --position-min
       is its narrowest width (it is 1/n of the rule otherwise, which gets
       thin on a long row); --position-color is its colour. Its left edge runs
       from the rule's start to its end as --i goes from 0 to n - 1; --i may
       be fractional while the home track scrolls. It is named, so a page turn
       morphs it from the old place to the new on the morph's own tempo. From
       sm up only (below it, a phone pass later). */
    .position {
        --position-min: 2rem;
        /* Brighter and thicker than the rule it lies on, which is the accent
           at 1px: the same colour and weight would not show. */
        --position-color: var(--color-accent-hover);
        --position-weight: 3px;
        display: none;
    }
    @media (min-width: 40rem) {
        .position {
            --w: max(calc(100% / var(--n)), var(--position-min));
            display: block;
            position: absolute;
            /* Centred on the 1px rule. */
            top: calc(var(--spacing-header) - (var(--position-weight) - 1px) / 2);
            left: calc((100% - var(--w)) * var(--i) / (var(--n) - 1));
            width: var(--w);
            height: var(--position-weight);
            background: var(--position-color);
            /* Its ends cut at the logo's angle, as the page turn's seam. */
            clip-path: polygon(
                calc(var(--position-weight) * 0.625) 0,
                100% 0,
                calc(100% - var(--position-weight) * 0.625) 100%,
                0 100%
            );
            pointer-events: none;
            /* Above the rule itself and the panels' own layers. */
            z-index: 2;
        }
    }
    .main-nav a {
        @apply text-accent-muted hover:text-accent;
    }
    .main-nav a.active {
        @apply text-accent;
    }
    .expanded {
        @apply flex;
    }
</style>
