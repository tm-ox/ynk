---
import Hamburger from "../components/Hamburger.astro";
import "../styles/global.css";
import Base from "./Base.astro";
import Sosmed from "../components/Sosmed.astro";
import { getCollection } from "astro:content";
import { EVENTS_PER_PAGE, IMAGES_PER_PAGE, getGalleryImages } from "../utils/events";
import { ROW, pageOf, screenOf } from "../utils/row";

const { title, description, image, jsonLd } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove the first "/"
const isHome = currentPath === "";
const isCurrent = (name: string) =>
    currentPath === name || currentPath.startsWith(`${name}/`);
// How many pages each screen of the row has: one, or an archive's count.
const pages: Record<string, number> = {
    events: Math.max(1, Math.ceil((await getCollection("events")).length / EVENTS_PER_PAGE)),
    images: Math.max(1, Math.ceil((await getGalleryImages()).length / IMAGES_PER_PAGE)),
};
const pagesOf = (name: string) => pages[name] ?? 1;
// The position line under the header (.position, below): the whole row of
// screens (utils/row.ts), each archive counting each of its pages. Detail
// pages, privacy and 404 are not in the row and have no line.
const screens = ROW.reduce((n, s) => n + pagesOf(s.name), 0);
const screen = screenOf(pathname);
const screenIndex =
    screen === undefined
        ? null
        : ROW.slice(0, screen).reduce((n, s) => n + pagesOf(s.name), 0) + pageOf(pathname) - 1;
// One run of links, in the row's order. An archive's carries its last page:
// stepping back from the next screen (keys, wheel) lands there, so the pages
// run in order (scripts/step.ts).
const links = ROW.map((s, i) => ({
    label: s.label,
    href: s.href,
    section: s.name,
    current: i === 0 ? isHome : isCurrent(s.name),
    last: s.paged ? (pagesOf(s.name) > 1 ? `${s.href}${pagesOf(s.name)}/` : s.href) : undefined,
}));

---

<Base title={title} description={description} image={image} jsonLd={jsonLd}>
    <div slot="nav" class="flex items-center justify-center w-full">
        <Hamburger />
        <div
            id="main-nav"
            class="absolute top-0 left-0 ml-auto justify-center hidden w-full h-viewport overflow-y-auto sm:flex sm:w-auto sm:h-auto sm:overflow-visible sm:relative main-nav bg-scrim-heavy sm:bg-transparent"
        >
            <ul
                class="flex flex-col items-center my-auto text-center sm:flex-row sm:gap-x-3"
            >
                {
                    links.map((link, i) => (
                        <li transition:name={`nav-${link.section}`}>
                            {i === 0 && <hr class="sm:hidden" />}
                            <a
                                class:list={["sm:relative sm:top-[2px]", link.current && "active"]}
                                aria-current={link.current ? "true" : undefined}
                                href={link.href}
                                data-section={link.section}
                                data-last={link.last}
                                target="_self">{link.label}</a
                            >
                            <hr class="sm:hidden" />
                        </li>
                    ))
                }
                <li transition:name="nav-social">
                    <Sosmed />
                </li>
            </ul>
        </div>
    </div>
    <slot name="head" slot="head" />
    {
        screenIndex !== null && (
            <div
                class="position"
                data-position
                aria-hidden="true"
                style={`--i:${screenIndex};--n:${screens}`}
                transition:name="position"
            />
        )
    }
    <slot />
</Base>


<script>
    import { ROW } from "../utils/row";

    // Marks the nav link for the screen the page belongs to: its own, or for
    // a detail page its archive's. The nav is persisted across transitions
    // (its markup is not swapped), so this runs on every page load.
    const setActive = (id: string | null) => {
        document
            .querySelectorAll<HTMLAnchorElement>("#main-nav a[data-section]")
            .forEach((a) => {
                const on = a.dataset.section === id;
                a.classList.toggle("active", on);
                if (on) a.setAttribute("aria-current", "true");
                else a.removeAttribute("aria-current");
            });
    };

    // Bound once (module scripts are not re-run by the router).
    document.addEventListener("astro:page-load", () => {
        const path = location.pathname;
        const first = path.split("/")[1];
        setActive(path === "/" ? ROW[0].name : (ROW.find((s) => s.name === first)?.name ?? null));
    });
</script>


<style>
    @reference "../styles/global.css";
    /* A segment lying on the header's bottom rule (.frame-rule, Base.astro),
       showing where this screen sits in the whole row. Knobs: --position-min
       is its narrowest width (it is 1/n of the rule otherwise, which gets
       thin on a long row); --position-color is its colour. Its left edge runs
       from the rule's start to its end as --i goes from 0 to n - 1 (both set
       at build, above). It is named, so a page turn

       morphs it from the old place to the new on the morph's own tempo. From
       sm up only (below it, a phone pass later). */
    .position {
        --position-min: 2rem;
        /* Brighter and thicker than the rule it lies on, which is the accent
           at 1px: the same colour and weight would not show. */
        --position-color: var(--color-accent-hover);
        --position-weight: 3px;
        display: none;
    }
    @media (min-width: 40rem) {
        .position {
            --w: max(calc(100% / var(--n)), var(--position-min));
            display: block;
            position: absolute;
            /* Centred on the 1px rule. */
            top: calc(var(--spacing-header) - (var(--position-weight) - 1px) / 2);
            left: calc((100% - var(--w)) * var(--i) / (var(--n) - 1));
            width: var(--w);
            height: var(--position-weight);
            background: var(--position-color);
            /* Its ends cut at the logo's angle, as the page turn's seam. */
            clip-path: polygon(
                calc(var(--position-weight) * 0.625) 0,
                100% 0,
                calc(100% - var(--position-weight) * 0.625) 100%,
                0 100%
            );
            pointer-events: none;
            /* Above the rule itself and the screens' own layers. */
            z-index: 2;
        }
    }
    .main-nav a {
        @apply text-accent-muted hover:text-accent;
    }
    .main-nav a.active {
        @apply text-accent;
    }
    .expanded {
        @apply flex;
    }
</style>
