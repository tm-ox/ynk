---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/home/About.astro";
import Events from "../components/home/Events.astro";
import Images from "../components/home/Images.astro";
import Contact from "../components/home/Contact.astro";

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Yes No Klub",
  alternateName: "YNK",
  url: "https://www.yesnoklub.net/",
  logo: "https://www.yesnoklub.net/android-chrome-512x512.png",
  foundingDate: "2010",
  description:
    "Yogyakarta-based DIY collective assisting local and visiting artists with projects in Indonesia and Southeast Asia.",
  location: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Yogyakarta",
      addressCountry: "ID",
    },
  },
  sameAs: [
    "https://www.instagram.com/yes.no.klub/",
    "https://www.facebook.com/yesnoklubyk",
    "https://www.youtube.com/@yesnoklub",
    "https://soundcloud.com/yesnoklub",
  ],
};
---

<BaseLayout jsonLd={organization}>
    <Hero />
    <About />
    <Events />
    <Images />
    <Contact />
</BaseLayout>
