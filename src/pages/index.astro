---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Yes No Klub",
  alternateName: "YNK",
  url: "https://www.yesnoklub.net/",
  logo: "https://www.yesnoklub.net/android-chrome-512x512.png",
  foundingDate: "2010",
  description:
    "Yogyakarta-based DIY collective assisting local and visiting artists with projects in Indonesia and Southeast Asia.",
  location: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Yogyakarta",
      addressCountry: "ID",
    },
  },
  sameAs: [
    "https://www.instagram.com/yes.no.klub/",
    "https://www.facebook.com/yesnoklubyk",
    "https://www.youtube.com/@yesnoklub",
    "https://soundcloud.com/yesnoklub",
  ],
};
---

<BaseLayout jsonLd={organization}>
    <!-- The first screen of the row: named and a .vt-page, so a turn to or
         from it slides it whole (see global.css). -->
    <div class="vt-page" transition:name="home">
        <Hero />
    </div>
</BaseLayout>
