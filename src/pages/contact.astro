---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/home/Contact.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Yes No Klub to collaborate or partner on a project."
>
  <!-- The last screen of the row: named and a .vt-page, so a turn to or from
       it slides it whole (see global.css). -->
  <div class="vt-page" transition:name="contact">
    <Contact />
  </div>
</BaseLayout>
