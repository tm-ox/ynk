---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Pagination from "../../../../components/Pagination.astro";
import GalleryGrid from "../../../../components/GalleryGrid.astro";
import GalleryFilter from "../../../../components/GalleryFilter.astro";
import { getGalleryEvents, getGalleryImages } from "../../../../utils/events";

export const getStaticPaths = (async ({ paginate }) => {
    const images = await getGalleryImages();
    const events = await getGalleryEvents();
    return events.flatMap((event) =>
        paginate(
            images.filter((image) => image.groupId === event.id),
            { pageSize: 24, params: { event: event.id }, props: { event } },
        ),
    );
}) satisfies GetStaticPaths;

const { page, event } = Astro.props;
const events = await getGalleryEvents();
const basePath = `/images/event/${event.id}/`;
---

<BaseLayout
    title={`Images – ${event.label}${page.currentPage > 1 ? `, page ${page.currentPage}` : ""}`}
    description={`Photographs from ${event.label}, Yes No Klub, Yogyakarta, Indonesia.`}
>
    <div
      slot="subnav"
      class="flex items-center gap-1 px-3 ml-4 mr-auto border-x border-x-border"
    >
      <a href="/#images" aria-label="Back to home">
        <Icon name="ion:close-sharp" class="icon" />
      </a>
    </div>
    <section class="flex-col pt-0">
        <GalleryFilter events={events} current={event.id} />
        <GalleryGrid images={page.data} />
        <Pagination
            prevUrl={page.url.prev}
            nextUrl={page.url.next}
            lastPage={page.lastPage}
            currentPage={page.currentPage}
            basePath={basePath}
        />
    </section>
</BaseLayout>
