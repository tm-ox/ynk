---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import NavArrow from "../../components/NavArrow.astro";
import { getGalleryImages } from "../../utils/events";

export async function getStaticPaths() {
  const images = await getGalleryImages();
  const numberOfImages = images.length;
  return images.map((image: any, i) => ({
    params: {
      slug: image.id,
    },
    props: {
      image,
      nextImage: i + 1 === numberOfImages ? { data: "" } : images[i + 1],
      prevImage: i === 0 ? { data: "" } : images[i - 1],
    },
  }));
}

const { image, prevImage, nextImage } = Astro.props;
---

<BaseLayout
  title={`${image.alt} – photo`}
  description={`${image.description}.`}
>
  <div
    slot="subnav"
    class="flex items-center gap-1 px-3 ml-3 mr-auto border-x border-x-border"
  >
    
    <div class="flex items-center gap-1">
      <NavArrow
        direction="back"
        class="icon h-6 w-6"
        href={prevImage.id ? `/images/${prevImage.id}/` : undefined}
      />
      <NavArrow
        direction="forward"
        class="icon h-6 w-6"
        href={nextImage.id ? `/images/${nextImage.id}/` : undefined}
      />
      <a href="/images" aria-label="All images">
        <Icon name="ion:close-sharp" class="icon" />
      </a>
    </div>
  </div>
  <section class="h-section flex flex-col vt-detail" transition:name={image.id}>
    <h3 class="md:hidden">{image.alt}</h3>
    <Image
      src={image.src}
      alt={image.description}
      width="1600"
      class="object-contain w-full h-full"
    />
  </section>
</BaseLayout>
