---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import NavArrow from "../../components/NavArrow.astro";
import { getGalleryImages } from "../../utils/events";

export async function getStaticPaths() {
  const images = await getGalleryImages();
  const numberOfImages = images.length;
  return images.map((image: any, i) => ({
    params: {
      slug: image.id,
    },
    props: {
      image,
      nextImage: i + 1 === numberOfImages ? { data: "" } : images[i + 1],
      prevImage: i === 0 ? { data: "" } : images[i - 1],
    },
  }));
}

const { image, prevImage, nextImage } = Astro.props;
// "Photograph 3 of 24 from ..." is built in getGalleryImages.
const position = image.description.match(/^Photograph (\d+) of (\d+)/);
const pageTitle = position
  ? `${image.alt} – photo ${position[1]} of ${position[2]}`
  : `${image.alt} – photo`;
---

<BaseLayout
  title={pageTitle}
  description={`${image.description}.`}
>
  <div
    slot="subnav"
    class="flex items-center gap-1 px-3 ml-3 mr-auto border-x border-x-border"
  >
    
    <div class="flex items-center gap-1">
      <NavArrow
        direction="back"
        class="icon h-6 w-6"
        href={prevImage.id ? `/images/${prevImage.id}/` : undefined}
      />
      <NavArrow
        direction="forward"
        class="icon h-6 w-6"
        href={nextImage.id ? `/images/${nextImage.id}/` : undefined}
      />
      <a href="/images/" data-close data-home-href="/#events" aria-label="Close" title="All images">
        <Icon name="ion:close-sharp" class="icon" />
      </a>
    </div>
  </div>
  <section class="h-section flex flex-col pb-3 vt-detail" transition:name={image.id}>
    <h1 class="mb-2 text-base font-bold normal-case md:text-lg md:sr-only">{image.alt}</h1>
    <Image
      src={image.src}
      alt={image.description}
      width="1600"
      class="object-contain w-full h-full"
    />
  </section>
</BaseLayout>
