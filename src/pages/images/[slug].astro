---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import NavArrow from "../../components/NavArrow.astro";
import ImageInfo from "../../components/ImageInfo.astro";
import { getGalleryImages } from "../../utils/events";

export async function getStaticPaths() {
  const images = await getGalleryImages();
  return images.map((image, i) => ({
    params: {
      slug: image.id,
    },
    props: {
      image,
      nextImage: images[i + 1],
      prevImage: images[i - 1],
    },
  }));
}

const { image, prevImage, nextImage } = Astro.props;
const { position } = image;
const pageTitle = image.kind === "flyer"
  ? `${image.alt} – flyer`
  : position
  ? `${image.alt} – photo ${position.n} of ${position.of}`
  : `${image.alt} – photo`;
const positionLabel = image.kind === "flyer" ? "Flyer" : position ? `${position.n} of ${position.of}` : undefined;
// The neighbours' pictures, prefetched with the same options the neighbour
// page renders them with, so the hashed URLs match.
const neighbourPictures = await Promise.all(
  [prevImage, nextImage]
    .filter(Boolean)
    .map((n) => getImage({ src: n.src, width: 1600 })),
);
---

<BaseLayout
  title={pageTitle}
  description={`${image.description}.`}
>
  {neighbourPictures.map((p) => (
    <link slot="head" rel="prefetch" as="image" href={p.src} />
  ))}
  <div
    slot="subnav"
    class="flex items-center gap-1 px-3 ml-3 mr-auto slash-l slash-r"
  >
    
    <div class="flex items-center gap-1">
      <NavArrow
        direction="back"
        class="icon h-6 w-6"
        href={prevImage ? `/images/${prevImage.id}/` : undefined}
      />
      <NavArrow
        direction="forward"
        class="icon h-6 w-6"
        href={nextImage ? `/images/${nextImage.id}/` : undefined}
      />
      <a href="/images/" data-close aria-label="Close" title="All images">
        <Icon name="ion:close-sharp" class="icon" />
      </a>
    </div>
  </div>
  <section class="h-section flex flex-col pb-3">
    <ImageInfo image={image} position={positionLabel} />
    <div class="grid w-full flex-1 min-h-0 mt-3 place-items-center [container-type:size]">
      <Image
        src={image.src}
        alt={image.description}
        width="1600"
        class:list={["fit-picture [--fit-h:100cqh]", image.kind === "photo" ? "vt-photo" : "vt-picture"]}
        loading="eager"
        style={`--ar:${image.src.width / image.src.height}`}
        transition:name={image.id}
      />
    </div>
  </section>
</BaseLayout>
