---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImageInfo from "../../components/ImageInfo.astro";
import { getGalleryImages, groupSlug } from "../../utils/events";

export async function getStaticPaths() {
  const images = await getGalleryImages();
  return images.map((image, i) => ({
    params: {
      slug: image.id,
    },
    props: {
      image,
      nextImage: images[i + 1],
      prevImage: images[i - 1],
    },
  }));
}

const { image, prevImage, nextImage } = Astro.props;
const { position } = image;
const pageTitle = image.kind === "flyer"
  ? `${image.alt} – flyer`
  : position
  ? `${image.alt} – photo ${position.n} of ${position.of}`
  : `${image.alt} – photo`;
// Phones: a landscape picture (wide enough to fit edge to edge in the room
// there is) runs out into the gutters; a taller one (a flyer, a portrait
// photograph) keeps to the content's width.
const wide = image.src.width / image.src.height >= 1.3;
const positionLabel = image.kind === "flyer" ? "Flyer" : position ? `${position.n} of ${position.of}` : undefined;
// The neighbours' pictures, prefetched with the same options the neighbour
// page renders them with, so the hashed URLs match.
const neighbourPictures = await Promise.all(
  [prevImage, nextImage]
    .filter(Boolean)
    .map((n) => getImage({ src: n.src, width: 1600 })),
);
---

<BaseLayout
  title={pageTitle}
  description={`${image.description}.`}
>
  {neighbourPictures.map((p) => (
    <link slot="head" rel="prefetch" as="image" href={p.src} />
  ))}
  <section class="h-section flex flex-col pb-3">
    <ImageInfo
      image={image}
      position={positionLabel}
      prev={prevImage ? `/images/${prevImage.id}/` : undefined}
      next={nextImage ? `/images/${nextImage.id}/` : undefined}
    />
    {/* Phones: the position and the Event images link (a touch target of its
        own) are a row under the strip, and the picture starts just under it,
        so both stay in the same place from the flyer to every photograph
        (whatever the strip holds, they follow it down). From sm up the row is
        in the info strip and the picture is centred in its box. */}
    <div class="sm:hidden flex w-full items-center justify-between shrink-0 text-xs uppercase font-displayCon text-accent-muted">
      <span>{positionLabel}</span>
      <a href={`/images/event/${groupSlug(image.event.title)}/`} class="section-action flex items-center h-11">Event images</a>
    </div>
    <div
      class:list={[
        "grid w-full flex-1 min-h-0 sm:mt-3 place-items-center [container-type:size] max-sm:items-start",
        wide && "max-sm:-mx-gutter max-sm:w-[calc(100%+2*var(--spacing-gutter))]",
      ]}
    >
      <Image
        src={image.src}
        alt={image.description}
        width="1600"
        class:list={["fit-picture [--fit-h:100cqh]", image.kind === "photo" ? "vt-photo" : "vt-picture"]}
        loading="eager"
        style={`--ar:${image.src.width / image.src.height}`}
        transition:name={image.id}
      />
    </div>
    {
      image.kind === "photo" && image.event.photographer && (
        <p class="md:hidden w-full mt-auto pt-2 mb-0 shrink-0 text-xs text-center uppercase font-displayCon text-accent">
          Image:{" "}
          {image.event.photographer.url ? (
            <a href={image.event.photographer.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover">
              {image.event.photographer.name}
            </a>
          ) : (
            image.event.photographer.name
          )}
        </p>
      )
    }
  </section>
</BaseLayout>
