---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import NavArrow from "../../components/NavArrow.astro";
import ImageInfo from "../../components/ImageInfo.astro";
import { getGalleryImages } from "../../utils/events";

export async function getStaticPaths() {
  const images = await getGalleryImages();
  return images.map((image, i) => ({
    params: {
      slug: image.id,
    },
    props: {
      image,
      nextImage: images[i + 1],
      prevImage: images[i - 1],
    },
  }));
}

const { image, prevImage, nextImage } = Astro.props;
const { position } = image;
const pageTitle = image.kind === "flyer"
  ? `${image.alt} – flyer`
  : position
  ? `${image.alt} – photo ${position.n} of ${position.of}`
  : `${image.alt} – photo`;
const positionLabel = image.kind === "flyer" ? "Flyer" : position ? `${position.n} of ${position.of}` : undefined;
---

<BaseLayout
  title={pageTitle}
  description={`${image.description}.`}
>
  <div
    slot="subnav"
    class="flex items-center gap-1 px-3 ml-3 mr-auto border-x border-x-border"
  >
    
    <div class="flex items-center gap-1">
      <NavArrow
        direction="back"
        class="icon h-6 w-6"
        href={prevImage ? `/images/${prevImage.id}/` : undefined}
      />
      <NavArrow
        direction="forward"
        class="icon h-6 w-6"
        href={nextImage ? `/images/${nextImage.id}/` : undefined}
      />
      <a href="/images/" data-close aria-label="Close" title="All images">
        <Icon name="ion:close-sharp" class="icon" />
      </a>
    </div>
  </div>
  <section class="h-section flex flex-col pb-3 vt-detail" transition:name={image.id}>
    <ImageInfo image={image} position={positionLabel} />
    <Image
      src={image.src}
      alt={image.description}
      width="1600"
      class="object-contain w-full h-full min-h-0 flex-1 mt-3"
    />
  </section>
</BaseLayout>
