---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Pagination from "../../components/Pagination.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import GalleryFilter from "../../components/GalleryFilter.astro";
import { getGalleryEvents, getGalleryImages } from "../../utils/events";

export const getStaticPaths = (async ({ paginate }) => {
    return paginate(await getGalleryImages(), { pageSize: 24 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const events = await getGalleryEvents();
---

<BaseLayout
    title={page.currentPage > 1 ? `Images – page ${page.currentPage}` : "Images"}
    description="Photographs from Yes No Klub events in Yogyakarta, Indonesia."
>
    <div
      slot="subnav"
      class="flex items-center gap-1 px-3 ml-4 mr-auto border-x border-x-border"
    >
      <a href="/#images" aria-label="Back to home">
        <Icon name="ion:close-sharp" class="icon" />
      </a>
    </div>
    <section class="flex-col pt-0">
        <GalleryFilter events={events} />
        <GalleryGrid images={page.data} />
        <Pagination
            prevUrl={page.url.prev}
            nextUrl={page.url.next}
            lastPage={page.lastPage}
            currentPage={page.currentPage}
        />
    </section>
</BaseLayout>
