---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavArrow from "../../components/NavArrow.astro";
import Pagination from "../../components/Pagination.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import GalleryFilter from "../../components/GalleryFilter.astro";
import { slash, getGalleryEvents, getGalleryImages } from "../../utils/events";

export const getStaticPaths = (async ({ paginate }) => {
    return paginate(await getGalleryImages(), { pageSize: 24 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const events = await getGalleryEvents();
---

<BaseLayout
    title={page.currentPage > 1 ? `Images – page ${page.currentPage}` : "Images"}
    description="Photographs from Yes No Klub events in Yogyakarta, Indonesia."
>
    <div
      slot="subnav"
      class="flex items-center gap-1 px-3 ml-4 mr-auto border-x border-x-border"
    >
      <NavArrow direction="back" href={slash(page.url.prev)} />
      <NavArrow direction="forward" href={slash(page.url.next)} />
      <a href="/#images" aria-label="Back to home">
        <Icon name="ion:close-sharp" class="icon" />
      </a>
    </div>
    <section class="flex-col pt-0 xl:h-section xl:min-h-0 xl:overflow-hidden">
        <div class="w-full py-1">
            <Pagination
            lastPage={page.lastPage}
            currentPage={page.currentPage}
        />
        </div>
        <GalleryGrid images={page.data}>
            <GalleryFilter events={events} />
        </GalleryGrid>
    </section>
</BaseLayout>
