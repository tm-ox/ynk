---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Paging from "../../components/Paging.astro";
import Pagination from "../../components/Pagination.astro";
import GalleryGrid from "../../components/GalleryGrid.astro";
import GalleryFilter from "../../components/GalleryFilter.astro";
import { slash, getGalleryEvents, getGalleryImages, IMAGES_PER_PAGE } from "../../utils/events";

export const getStaticPaths = (async ({ paginate }) => {
    return paginate(await getGalleryImages(), { pageSize: IMAGES_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const events = await getGalleryEvents();
---

<BaseLayout
    title={page.currentPage > 1 ? `Images – page ${page.currentPage}` : "Images"}
    description={`Photographs from Yes No Klub events in Yogyakarta, Indonesia.${page.currentPage > 1 ? ` Page ${page.currentPage}.` : ""}`}
>
    <!-- The archive's screen: its bar and grid, named and a .vt-page, so a
       turn slides the whole of it (see global.css). -->
  <section class="flex-col xl:h-section xl:min-h-0 xl:overflow-hidden vt-page" transition:name="gallery-page">
        <h1 class="sr-only">Images</h1>
        <GalleryFilter label="Images" events={events}>
            <Pagination lastPage={page.lastPage} currentPage={page.currentPage} />
            {page.lastPage > 1 && <Paging prev={slash(page.url.prev)} next={slash(page.url.next)} />}
        </GalleryFilter>
        <GalleryGrid images={page.data} />
    </section>
</BaseLayout>
