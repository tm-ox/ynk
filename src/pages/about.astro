---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/home/About.astro";
---

<BaseLayout
  title="About"
  description="Yes No Klub, a Yogyakarta-based DIY collective assisting local and visiting artists with projects in Indonesia and Southeast Asia."
>
  <!-- One screen of the row, after the images archive: named and a .vt-page,
       so a turn to or from it slides it whole (see global.css). -->
  <div class="vt-page" transition:name="about">
    <About />
  </div>
</BaseLayout>
