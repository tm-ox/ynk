---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

const events = await getCollection("events");
events.sort((b, a) => Date.parse(a.data.date) - Date.parse(b.data.date));
---

<BaseLayout
  title="Events"
  description="Archive of Yes No Klub events, gigs and projects from Yogyakarta, Indonesia."
>
  <section>
    <ul class="eventGrid">
      {
        events.map((event: any) => (
          <li>
            <a href={`/events/${event.id}`} transition:name={event.data.id}>
              <h5 class="uppercase">{event.data.title}</h5>
              <hr />
              <Image
                src={event.data.flyer.src}
                alt={event.data.flyer.alt}
                height={400}
              />
              <hr />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
