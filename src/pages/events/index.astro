---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { flyerAltShort } from "../../utils/events";

const events = await getCollection("events");
events.sort((b, a) => Date.parse(a.data.date) - Date.parse(b.data.date));
---

<BaseLayout
  title="Events"
  description="Archive of Yes No Klub events, gigs and projects from Yogyakarta, Indonesia."
>
  <div
    slot="subnav"
    class="flex items-center gap-1 px-3 ml-4 mr-auto border-x border-x-border"
  >
    <a href="/#events" aria-label="Back to home">
      <Icon name="ion:close-sharp" class="icon" />
    </a>
  </div>
  <section>
    <ul class="eventGrid">
      {
        events.map((event: any) => (
          <li>
            <a href={`/events/${event.id}`} transition:name={event.data.id}>
              <h5 class="uppercase">{event.data.title}</h5>
              <hr />
              <Image
                src={event.data.flyer.src}
                alt={flyerAltShort(event.data)}
                height={400}
              />
              <hr />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
