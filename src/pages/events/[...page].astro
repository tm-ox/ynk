---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EVENTS_PER_PAGE, slash } from "../../utils/events";
import EventGrid from "../../components/EventGrid.astro";
import NavArrow from "../../components/NavArrow.astro";
import ArchiveBar from "../../components/ArchiveBar.astro";
import Pagination from "../../components/Pagination.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const events = await getCollection("events");
  events.sort((b, a) => Date.parse(a.data.date) - Date.parse(b.data.date));
  return paginate(events, { pageSize: EVENTS_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout
  title={page.currentPage > 1 ? `Events – page ${page.currentPage}` : "Events"}
  description={`Archive of Yes No Klub events, gigs and projects from Yogyakarta, Indonesia.${page.currentPage > 1 ? ` Page ${page.currentPage}.` : ""}`}
>
  <div
    slot="subnav"
    class="flex items-center gap-1 px-4 ml-4 mr-auto slash-l slash-r"
  >
    <NavArrow direction="back" href={slash(page.url.prev)} />
    <NavArrow direction="forward" href={slash(page.url.next)} />
    <a href="/" aria-label="Back to home">
      <Icon name="ion:close-sharp" class="icon" />
    </a>
  </div>
  <!-- The archive's screen: its bar and grid, named and a .vt-page, so a
       turn slides the whole of it (see global.css). -->
  <section class="flex-col xl:h-section xl:min-h-0 xl:overflow-hidden vt-page" transition:name="gallery-page">
    <h1 class="sr-only">Events</h1>
    <ArchiveBar label="Events">
      <Pagination lastPage={page.lastPage} currentPage={page.currentPage} basePath="/events/" />
    </ArchiveBar>
    <EventGrid events={page.data} />
  </section>
</BaseLayout>
