---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventDetail from "../../components/EventDetail.astro";
import Paging from "../../components/Paging.astro";
import SectionBar from "../../components/home/SectionBar.astro";
import { eventJsonLd, getFeaturedEvent, groupSlug } from "../../utils/events";

export async function getStaticPaths() {
  const events = await getCollection("events");
  const numberOfEvents = events.length;
  return events
    .sort((b, a) => Date.parse(b.data.date) - Date.parse(a.data.date))
    .map((event, i) => ({
      params: {
        slug: event.id,
      },
      props: {
        event,
        prevEvent: events[i + 1],
        nextEvent: events[i - 1],
      },
    }));
}
const { event, prevEvent, nextEvent } = Astro.props;
const { Content } = await render(event);

const { title, date, venue, with: lineup } = event.data;
const sameTitle = (await getCollection("events")).filter(
  (e) => e.data.title === title && e.data.venue?.name === venue?.name,
);
const baseTitle = venue?.name ? `${title} – ${venue.name}` : title;
const pageTitle = sameTitle.length > 1 ? `${baseTitle} (${date})` : baseTitle;
const rawDescription = [
  `${title}, ${date}${venue?.name ? ` at ${venue.name}` : ""}.`,
  lineup ? `With ${lineup}.` : "",
]
  .filter(Boolean)
  .join(" ");
const pageDescription =
  rawDescription.length > 158
    ? `${rawDescription.slice(0, 155).trimEnd()}…`
    : rawDescription;
// The featured event keeps its Featured label (the bar's title) when opened.
const featured = await getFeaturedEvent();
const featuredLabel = featured.event?.id === event.id ? featured.label : undefined;
// The bar's arrows and close (one of two bars below, named or not).
const paging = {
  prev: prevEvent ? `/events/${prevEvent.id}/` : undefined,
  next: nextEvent ? `/events/${nextEvent.id}/` : undefined,
  close: { href: "/events/", title: "All events" },
};
const hasPhotos = (event.data.images ?? []).some(Boolean);
const flyer = event.data.flyer?.src
  ? await getImage({ src: event.data.flyer.src, width: 1200, format: "jpg" })
  : undefined;
// The neighbours' flyers, prefetched with the same options EventDetail renders
// them with (no width), so the hashed URLs match. Events without one are skipped.
const neighbourFlyers = await Promise.all(
  [prevEvent, nextEvent]
    .filter((e) => e?.data.flyer?.src)
    .map((e) => getImage({ src: e!.data.flyer!.src })),
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={flyer?.src}
  jsonLd={eventJsonLd(
    event.data,
    new URL(Astro.url.pathname, Astro.site).href,
    flyer ? new URL(flyer.src, Astro.site).href : undefined,
    pageDescription,
  )}
>
  {neighbourFlyers.map((f) => (
    <link slot="head" rel="prefetch" as="image" href={f.src} />
  ))}
  <!-- The screen's top bar row, as on the archives: its title at the left
       (the Featured label when this is the featured event, named so it holds
       still from Featured's own bar) and the arrows and close at the right.
       It sits inside the section, so on Previous / Next it turns with the
       page. From md up it lies over the section's top padding, where the
       featured label always sat, so the listing stays centred in the screen
       and the flyer holds still from Featured; below md, where the listing
       stacks, it comes first in the flow so it never covers the flyer, and
       the listing is centred under it. -->
  <section transition:name={event.data.id} class="relative z-10 vt-detail vt-swap max-md:flex-col max-md:items-stretch max-md:[&>:last-child]:my-auto">
    {featuredLabel ? (
      <div class="w-full md:absolute md:inset-x-0 md:top-2 vt-detail detail-bar" transition:name="featured-label">
        <SectionBar label={featuredLabel}><Paging {...paging} /></SectionBar>
      </div>
    ) : (
      // Named, so it stays put while Previous / Next turns the page under it
      // (Base.astro's fold leaves .detail-bar alone), as the photo page's
      // info strip does.
      <div class="w-full md:absolute md:inset-x-0 md:top-2 detail-bar" transition:name="detail-bar">
        <SectionBar label="Events"><Paging {...paging} /></SectionBar>
      </div>
    )}
    <EventDetail capped event={event} docsHref={hasPhotos ? `/images/event/${groupSlug(title)}/` : undefined}>
      <Content />
    </EventDetail>
  </section>
</BaseLayout>
