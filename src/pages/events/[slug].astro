---
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import NavArrow from "../../components/NavArrow.astro";
import { eventJsonLd, flyerAlt, prettyDate as formatDate } from "../../utils/events";

export async function getStaticPaths() {
  const events = await getCollection("events");
  const numberOfEvents = events.length;
  return events
    .sort((b, a) => Date.parse(b.data.date) - Date.parse(a.data.date))
    .map((event, i) => ({
      params: {
        slug: event.id,
      },
      props: {
        event,
        prevEvent: i + 1 === numberOfEvents ? { data: "" } : events[i + 1],
        nextEvent: i === 0 ? { data: "" } : events[i - 1],
      },
    }));
}
const { event, prevEvent, nextEvent } = Astro.props;
const { Content } = await render(event);

const { title, date, venue, with: lineup } = event.data;
const prettyDate = formatDate(date);
const sameTitle = (await getCollection("events")).filter(
  (e) => e.data.title === title && e.data.venue?.name === venue?.name,
);
const baseTitle = venue?.name ? `${title} – ${venue.name}` : title;
const pageTitle = sameTitle.length > 1 ? `${baseTitle} (${prettyDate})` : baseTitle;
const rawDescription = [
  `${title}, ${prettyDate}${venue?.name ? ` at ${venue.name}` : ""}.`,
  lineup ? `With ${lineup}.` : "",
]
  .filter(Boolean)
  .join(" ");
const pageDescription =
  rawDescription.length > 158
    ? `${rawDescription.slice(0, 155).trimEnd()}…`
    : rawDescription;
const flyer = event.data.flyer?.src
  ? await getImage({ src: event.data.flyer.src, width: 1200, format: "jpg" })
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={flyer?.src}
  jsonLd={eventJsonLd(
    event.data,
    new URL(Astro.url.pathname, Astro.site).href,
    flyer ? new URL(flyer.src, Astro.site).href : undefined,
    pageDescription,
  )}
>
  <div
    slot="subnav"
    class="flex items-center gap-1 px-3 ml-4 mr-auto border-x border-x-border"
  >
    <NavArrow
      direction="back"
      href={prevEvent.data ? `/events/${prevEvent.id}/` : undefined}
    />
    <NavArrow
      direction="forward"
      href={nextEvent.data ? `/events/${nextEvent.id}/` : undefined}
    />
    <a href="/events" aria-label="All events">
      <Icon name="ion:close-sharp" class="icon" />
    </a>
  </div>
  <section transition:name={event.data.id} class="z-10">
    <div class="flex flex-col gap-4 md:flex-row">
      <div class="md:w-3/5">
        <Image
          src={event.data.flyer.src}
          alt={flyerAlt(event.data)}
          class="object-contain h-auto my-1 mb-auto"
        />
      </div>
      <div class="w-full">
        <div class="flex items-center mb-2">
          <h2 class="mb-0 uppercase mx-auto sm:mx-0">
            {event.data.title}
          </h2>
        </div>
        <hr />
        <div class="flex flex-col sm:flex-row justify-between py-rule">
          <div class="flex w-full flex-col sm:flex-row">
            <div class="flex flex-col">
              <h5>date:</h5>
              <h4>{event.data.date}</h4>
            </div>
            {
              event.data.time !== "" && (
                <div class="flex flex-col mx-auto">
                  <h5>time:</h5>
                  <h4>{event.data.time}</h4>
                </div>
              )
            }
          </div>
          <hr />
          <div class="w-full">
            <h5>venue:</h5>
            <h4>
              {event.data.venue.url ? (
                <a
                  href={event.data.venue.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {event.data.venue.name}
                </a>
              ) : (
                <span>{event.data.venue.name}</span>
              )}
            </h4>
          </div>
        </div>
        <hr />
        {
          event.data.with !== "" && (
            <>
              <div class="py-rule">
                <h5>with:</h5>
                <h3 class="mb-0">{event.data.with}</h3>
              </div>
              <hr />
            </>
          )
        }
        {
          event.data.info !== "" && (
            <>
              <div class="py-rule">
                <h5>info:</h5>
                <h4>{event.data.info}</h4>
              </div>
              <hr />
            </>
          )
        }
        <div class="py-rule">
          <Content />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
