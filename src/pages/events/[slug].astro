---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import EventDetail from "../../components/EventDetail.astro";
import NavArrow from "../../components/NavArrow.astro";
import SectionBar from "../../components/home/SectionBar.astro";
import { eventJsonLd, getFeaturedEvent, groupSlug, prettyDate as formatDate } from "../../utils/events";

export async function getStaticPaths() {
  const events = await getCollection("events");
  const numberOfEvents = events.length;
  return events
    .sort((b, a) => Date.parse(b.data.date) - Date.parse(a.data.date))
    .map((event, i) => ({
      params: {
        slug: event.id,
      },
      props: {
        event,
        prevEvent: i + 1 === numberOfEvents ? { data: "" } : events[i + 1],
        nextEvent: i === 0 ? { data: "" } : events[i - 1],
      },
    }));
}
const { event, prevEvent, nextEvent } = Astro.props;
const { Content } = await render(event);

const { title, date, venue, with: lineup } = event.data;
const prettyDate = formatDate(date);
const sameTitle = (await getCollection("events")).filter(
  (e) => e.data.title === title && e.data.venue?.name === venue?.name,
);
const baseTitle = venue?.name ? `${title} – ${venue.name}` : title;
const pageTitle = sameTitle.length > 1 ? `${baseTitle} (${prettyDate})` : baseTitle;
const rawDescription = [
  `${title}, ${prettyDate}${venue?.name ? ` at ${venue.name}` : ""}.`,
  lineup ? `With ${lineup}.` : "",
]
  .filter(Boolean)
  .join(" ");
const pageDescription =
  rawDescription.length > 158
    ? `${rawDescription.slice(0, 155).trimEnd()}…`
    : rawDescription;
// The featured event keeps its home panel label (top left) when opened.
const featured = await getFeaturedEvent();
const featuredLabel = featured.event?.id === event.id ? featured.label : undefined;
const hasPhotos = (event.data.images ?? []).some(Boolean);
const flyer = event.data.flyer?.src
  ? await getImage({ src: event.data.flyer.src, width: 1200, format: "jpg" })
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={flyer?.src}
  jsonLd={eventJsonLd(
    event.data,
    new URL(Astro.url.pathname, Astro.site).href,
    flyer ? new URL(flyer.src, Astro.site).href : undefined,
    pageDescription,
  )}
>
  <div
    slot="subnav"
    class="flex items-center gap-1 px-3 ml-4 mr-auto border-x border-x-border"
  >
    <NavArrow
      direction="back"
      href={prevEvent.data ? `/events/${prevEvent.id}/` : undefined}
    />
    <NavArrow
      direction="forward"
      href={nextEvent.data ? `/events/${nextEvent.id}/` : undefined}
    />
    <a href="/events/" data-close aria-label="Close" title="All events">
      <Icon name="ion:close-sharp" class="icon" />
    </a>
  </div>
  <section transition:name={event.data.id} class="relative z-10 vt-detail">
    {featuredLabel && (
      <div class="absolute inset-x-0 top-3 vt-detail" transition:name="featured-label"><SectionBar label={featuredLabel} /></div>
    )}
    <EventDetail capped event={event} docsHref={hasPhotos ? `/images/event/${groupSlug(title)}/` : undefined}>
      <Content />
    </EventDetail>
  </section>
</BaseLayout>
